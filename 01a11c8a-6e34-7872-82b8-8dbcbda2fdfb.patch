+++ b/frontend/src/pages/Replay.tsx
@@ -0,0 +1,133 @@
+import { useEffect, useState } from 'react'
+import api from '../lib/api'
+import { History, Play, Pause } from 'lucide-react'
+import { RiskBadge, CongestionBadge } from '../components/Badges'
+
+interface Frame {
+  timestamp: string
+  total_population: number
+  parking_occupancy_pct: number
+  traffic_status: string
+  risk_score: number
+  risk_level: string
+  active_alerts: number
+  weather: string
+  zones: Record<string, { people: number; density: string }>
+}
+
+const RANGES = ['TODAY', 'YESTERDAY', '7D']
+
+export default function Replay() {
+  const [range, setRange] = useState('TODAY')
+  const [frames, setFrames] = useState<Frame[]>([])
+  const [idx, setIdx] = useState(0)
+  const [playing, setPlaying] = useState(false)
+
+  useEffect(() => {
+    api.get(`/analytics/replay?range=${range}`).then((r) => {
+      setFrames(r.data.frames)
+      setIdx(0)
+    }).catch(() => {})
+  }, [range])
+
+  useEffect(() => {
+    if (!playing || frames.length === 0) return
+    const t = setInterval(() => {
+      setIdx((i) => {
+        if (i >= frames.length - 1) { setPlaying(false); return i }
+        return i + 1
+      })
+    }, 700)
+    return () => clearInterval(t)
+  }, [playing, frames.length])
+
+  const frame = frames[Math.min(idx, frames.length - 1)]
+  const topZones = frame ? Object.entries(frame.zones).sort((a, b) => b[1].people - a[1].people).slice(0, 6) : []
+
+  return (
+    <div className="space-y-6">
+      <div className="flex items-center justify-between">
+        <h1 className="text-xl font-bold flex items-center gap-2"><History size={20} className="text-nexus-accent" /> Campus Event Replay</h1>
+        <div className="flex items-center gap-2">
+          {RANGES.map((r) => (
+            <button key={r} onClick={() => setRange(r)}
+              className={`rounded-lg border px-3 py-1.5 text-xs font-semibold ${range === r ? 'border-nexus-accent bg-nexus-accent/15 text-nexus-accent' : 'border-nexus-border text-nexus-muted'}`}>
+              {r === 'TODAY' ? 'Today' : r === 'YESTERDAY' ? 'Yesterday' : 'Last 7 days'}
+            </button>
+          ))}
+        </div>
+      </div>
+
+      {!frame && <div className="text-nexus-muted">Loading replay…</div>}
+
+      {frame && (
+        <>
+          {/* timeline scrubber */}
+          <div className="glass rounded-xl border border-nexus-border p-4">
+            <div className="flex items-center gap-4">
+              <button onClick={() => setPlaying(!playing)}
+                className="flex items-center gap-2 rounded-lg bg-nexus-accent/20 border border-nexus-accent/40 px-4 py-2 text-sm font-semibold text-nexus-accent">
+                {playing ? <Pause size={14} /> : <Play size={14} />} {playing ? 'Pause' : 'Play replay'}
+              </button>
+              <input type="range" min={0} max={Math.max(0, frames.length - 1)} value={idx}
+                onChange={(e) => { setPlaying(false); setIdx(Number(e.target.value)) }}
+                className="flex-1 accent-nexus-accent" />
+              <span className="font-mono text-sm text-nexus-muted w-40 text-right">
+                {new Date(frame.timestamp).toLocaleString()}
+              </span>
+            </div>
+            <div className="text-xs text-nexus-muted mt-2">
+              Frame {idx + 1} / {frames.length} — scrub the timeline to replay how campus conditions changed and understand what caused an event.
+            </div>
+          </div>
+
+          {/* KPI strip at this point in time */}
+          <div className="grid grid-cols-2 md:grid-cols-4 xl:grid-cols-6 gap-3">
+            <div className="glass rounded-xl p-4 border border-nexus-border">
+              <div className="text-xs uppercase text-nexus-muted">Population</div>
+              <div className="text-2xl font-bold font-mono mt-1">{frame.total_population.toLocaleString()}</div>
+            </div>
+            <div className="glass rounded-xl p-4 border border-nexus-border">
+              <div className="text-xs uppercase text-nexus-muted">Parking</div>
+              <div className="text-2xl font-bold font-mono mt-1">{frame.parking_occupancy_pct.toFixed(0)}%</div>
+            </div>
+            <div className="glass rounded-xl p-4 border border-nexus-border">
+              <div className="text-xs uppercase text-nexus-muted">Traffic</div>
+              <div className="mt-1"><CongestionBadge level={frame.traffic_status} /></div>
+            </div>
+            <div className="glass rounded-xl p-4 border border-nexus-border">
+              <div className="text-xs uppercase text-nexus-muted">Risk</div>
+              <div className="mt-1"><RiskBadge level={frame.risk_level} score={frame.risk_score} /></div>
+            </div>
+            <div className="glass rounded-xl p-4 border border-nexus-border">
+              <div className="text-xs uppercase text-nexus-muted">Active alerts</div>
+              <div className="text-2xl font-bold font-mono mt-1 text-nexus-orange">{frame.active_alerts}</div>
+            </div>
+            <div className="glass rounded-xl p-4 border border-nexus-border">
+              <div className="text-xs uppercase text-nexus-muted">Weather</div>
+              <div className="text-lg font-bold mt-1">{frame.weather}</div>
+            </div>
+          </div>
+
+          {/* zone states at this point in time */}
+          <div className="glass rounded-xl border border-nexus-border p-4">
+            <h3 className="text-sm font-semibold mb-3">Zone crowd at {new Date(frame.timestamp).toLocaleTimeString()}</h3>
+            <div className="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
+              {topZones.map(([name, z]) => (
+                <div key={name} className="rounded-lg border border-nexus-border p-3">
+                  <div className="text-xs font-semibold">{name}</div>
+                  <div className="font-mono text-xl font-bold mt-1">{z.people.toLocaleString()}</div>
+                  <div className={`text-[10px] font-semibold mt-0.5 ${densityText(z.density)}`}>{z.density}</div>
+                </div>
+              ))}
+            </div>
+          </div>
+        </>
+      )}
+    </div>
+  )
+}
+
+function densityText(d: string) {
+  return d === 'CRITICAL' ? 'text-nexus-red' : d === 'HIGH' ? 'text-nexus-orange' : d === 'MEDIUM' ? 'text-nexus-yellow' : 'text-nexus-green'
+}

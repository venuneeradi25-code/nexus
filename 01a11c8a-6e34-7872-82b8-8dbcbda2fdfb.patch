+              <>
+                <div className="text-xs text-nexus-muted">
+                  Campus population <span className="text-nexus-text font-semibold">{metrics.total_population.toLocaleString()}</span>
+                </div>
+                <div className="text-xs text-nexus-muted">
+                  Parking <span className="text-nexus-text font-semibold">{metrics.parking_occupancy_pct.toFixed(0)}%</span>
+                </div>
+              </>
+            )}
+            {risk && (

+
+function barColor(pct: number) {
+  if (pct >= 90) return 'bg-nexus-red'
+  if (pct >= 70) return 'bg-nexus-orange'
+  if (pct >= 40) return 'bg-nexus-yellow'
+  return 'bg-nexus-green'
+}

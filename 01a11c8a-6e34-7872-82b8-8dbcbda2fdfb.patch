+export const RISK_COLORS: Record<string, string> = {
+  NORMAL: 'text-nexus-green border-nexus-green/40 bg-nexus-green/10',
+  MODERATE: 'text-nexus-yellow border-nexus-yellow/40 bg-nexus-yellow/10',
+  ELEVATED: 'text-nexus-orange border-nexus-orange/40 bg-nexus-orange/10',
+  CRITICAL: 'text-nexus-red border-nexus-red/40 bg-nexus-red/10',
+}
+
+export const RISK_EMOJI: Record<string, string> = {
+  NORMAL: '🟢',
+  MODERATE: '🟡',
+  ELEVATED: '🟠',
+  CRITICAL: '🔴',
+}
+
+export const DENSITY_COLORS: Record<string, string> = {
+  LOW: 'text-nexus-green bg-nexus-green/15 border-nexus-green/40',
+  MEDIUM: 'text-nexus-yellow bg-nexus-yellow/15 border-nexus-yellow/40',
+  HIGH: 'text-nexus-orange bg-nexus-orange/15 border-nexus-orange/40',
+  CRITICAL: 'text-nexus-red bg-nexus-red/15 border-nexus-red/40',
+}
+
+export const CONGESTION_COLORS: Record<string, string> = {
+  LOW: 'text-nexus-green',
+  MODERATE: 'text-nexus-yellow',
+  HIGH: 'text-nexus-orange',
+  CRITICAL: 'text-nexus-red',
+  CLOSED: 'text-nexus-red',
+}
+
+export const SEVERITY_COLORS: Record<string, string> = {
+  INFO: 'text-nexus-accent',
+  LOW: 'text-nexus-green',
+  MEDIUM: 'text-nexus-yellow',
+  HIGH: 'text-nexus-orange',
+  CRITICAL: 'text-nexus-red',
+}
+
+export function timeAgo(iso: string): string {
+  const diff = (Date.now() - new Date(iso).getTime()) / 1000
+  if (diff < 5) return 'just now'
+  if (diff < 60) return `${Math.floor(diff)}s ago`
+  if (diff < 3600) return `${Math.floor(diff / 60)}m ago`
+  return `${Math.floor(diff / 3600)}h ago`
+}
+
+export function fmt(n: number): string {
+  return n.toLocaleString('en-US')
+}

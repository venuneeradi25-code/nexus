--- /dev/null
+++ b/frontend/src/App.tsx
@@ -0,0 +1,54 @@
+import { Navigate, Route, Routes } from 'react-router-dom'
+import { Layout } from './components/Layout'
+import { useAuth } from './store/auth'
+import Login from './pages/Login'
+import Dashboard from './pages/Dashboard'
+import Cameras from './pages/Cameras'
+import Crowd from './pages/Crowd'
+import Parking from './pages/Parking'
+import Events from './pages/Events'
+import Predictions from './pages/Predictions'
+import Simulator from './pages/Simulator'
+import Alerts from './pages/Alerts'
+import Analytics from './pages/Analytics'
+import Assistant from './pages/Assistant'
+import Replay from './pages/Replay'
+import Report from './pages/Report'
+import Settings from './pages/Settings'
+
+function Protected({ children }: { children: React.ReactNode }) {
+  const { user } = useAuth()
+  if (!user) return <Navigate to="/login" replace />
+  return <>{children}</>
+}
+
+export default function App() {
+  const { user } = useAuth()
+  return (
+    <Routes>
+      <Route path="/login" element={user ? <Navigate to="/" replace /> : <Login />} />
+      <Route
+        element={
+          <Protected>
+            <Layout />
+          </Protected>
+        }
+      >
+        <Route path="/" element={<Dashboard />} />
+        <Route path="/cameras" element={<Cameras />} />
+        <Route path="/crowd" element={<Crowd />} />
+        <Route path="/parking" element={<Parking />} />
+        <Route path="/events" element={<Events />} />
+        <Route path="/predictions" element={<Predictions />} />
+        <Route path="/simulator" element={<Simulator />} />
+        <Route path="/alerts" element={<Alerts />} />
+        <Route path="/analytics" element={<Analytics />} />
+        <Route path="/assistant" element={<Assistant />} />
+        <Route path="/replay" element={<Replay />} />
+        <Route path="/report" element={<Report />} />
+        <Route path="/settings" element={<Settings />} />
+      </Route>
+      <Route path="*" element={<Navigate to="/" replace />} />
+    </Routes>
+  )
+}
diff --git a/frontend/src/components/Badges.tsx b/frontend/src/components/Badges.tsx
new file mode 100644
index 0000000..1e96501
--- /dev/null
+++ b/frontend/src/components/Badges.tsx
@@ -0,0 +1,36 @@
+import { cn, RISK_COLORS, RISK_EMOJI, DENSITY_COLORS, CONGESTION_COLORS, SEVERITY_COLORS } from '../lib/ui'
+
+export function RiskBadge({ level, score }: { level: string; score?: number }) {
+  return (
+    <span className={cn('inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold', RISK_COLORS[level] || RISK_COLORS.NORMAL)}>
+      <span>{RISK_EMOJI[level] || '🟢'}</span>
+      {level}
+      {score !== undefined && <span className="opacity-80">· {score}/100</span>}
+    </span>
+  )
+}
+
+export function DensityBadge({ density }: { density: string }) {
+  return (
+    <span className={cn('inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold', DENSITY_COLORS[density] || DENSITY_COLORS.LOW)}>
+      {density}
+    </span>
+  )
+}
+
+export function CongestionBadge({ level }: { level: string }) {
+  return (
+    <span className={cn('inline-flex items-center gap-1.5 text-xs font-semibold', CONGESTION_COLORS[level] || CONGESTION_COLORS.LOW)}>
+      <span className="h-2 w-2 rounded-full bg-current" />
+      {level}
+    </span>
+  )
+}
+
+export function SeverityBadge({ severity }: { severity: string }) {
+  return (
+    <span className={cn('inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs font-semibold uppercase', SEVERITY_COLORS[severity] || SEVERITY_COLORS.LOW, 'border-current/40 bg-current/10')}>
+      {severity}
+    </span>
+  )
+}
diff --git a/frontend/src/components/CampusMap.tsx b/frontend/src/components/CampusMap.tsx
new file mode 100644
index 0000000..0a5511a
--- /dev/null
+++ b/frontend/src/components/CampusMap.tsx
@@ -0,0 +1,204 @@
+import { useEffect, useMemo, useState } from 'react'
+import api from '../lib/api'
+import type { Snapshot, ZoneLive, ParkingZone } from '../lib/types'
+import { cn, DENSITY_COLORS } from '../lib/ui'
+
+interface Building {
+  id: number
+  name: string
+  x: number
+  y: number
+  width: number
+  height: number
+}
+
+interface Camera {
+  id: number
+  camera_id: string
+  name: string
+  location: string
+  zone_id: number | null
+  status: string
+}
+
+const DENSITY_FILL: Record<string, string> = {
+  LOW: 'rgba(52, 211, 153, 0.28)',
+  MEDIUM: 'rgba(251, 191, 36, 0.38)',
+  HIGH: 'rgba(251, 146, 60, 0.5)',
+  CRITICAL: 'rgba(248, 113, 113, 0.62)',
+}
+
+const DENSITY_STROKE: Record<string, string> = {
+  LOW: '#34d399',
+  MEDIUM: '#fbbf24',
+  HIGH: '#fb923c',
+  CRITICAL: '#f87171',
+}
+
+function parkingFill(pct: number): string {
+  if (pct >= 95) return 'rgba(248, 113, 113, 0.55)'
+  if (pct >= 80) return 'rgba(251, 146, 60, 0.45)'
+  if (pct >= 55) return 'rgba(251, 191, 36, 0.35)'
+  return 'rgba(52, 211, 153, 0.25)'
+}
+
+export function CampusMap({
+  snapshot,
+  selectedZone,
+  onSelectZone,
+  showHeatmap = true,
+}: {
+  snapshot: Snapshot | null
+  selectedZone?: number | null
+  onSelectZone?: (zoneId: number) => void
+  showHeatmap?: boolean
+}) {
+  const [buildings, setBuildings] = useState<Building[]>([])
+  const [cameras, setCameras] = useState<Camera[]>([])
+
+  useEffect(() => {
+    api.get('/buildings').then((r) => setBuildings(r.data)).catch(() => {})
+    api.get('/cameras').then((r) => setCameras(r.data)).catch(() => {})
+  }, [])
+
+  const zoneById = useMemo(() => {
+    const map: Record<number, ZoneLive> = {}
+    snapshot?.zones.forEach((z) => (map[z.zone_id] = z))
+    return map
+  }, [snapshot])
+
+  const camPos = (cam: Camera) => {
+    const z = cam.zone_id ? zoneById[cam.zone_id] : undefined
+    if (z) return { x: z.x + z.width - 12, y: z.y + 12 }
+    // fallback: match by location name
+    const z2 = snapshot?.zones.find((zz) => zz.name === cam.location)
+    return z2 ? { x: z2.x + z2.width - 12, y: z2.y + 12 } : { x: 0, y: 0 }
+  }
+
+  return (
+    <div className="relative w-full overflow-hidden rounded-xl border border-nexus-border bg-[#0a1120]">
+      <svg viewBox="0 0 1000 640" className="w-full h-auto">
+        <defs>
+          <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
+            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="rgba(56,189,248,0.07)" strokeWidth="1" />
+          </pattern>
+          <linearGradient id="roadGrad" x1="0" y1="0" x2="1" y2="0">
+            <stop offset="0" stopColor="#1e2a45" />
+            <stop offset="1" stopColor="#24365c" />
+          </linearGradient>
+        </defs>
+        <rect width="1000" height="640" fill="url(#grid)" />
+
+        {/* campus boundary */}
+        <rect x="20" y="15" width="960" height="610" rx="18" fill="none" stroke="#24365c" strokeWidth="2" strokeDasharray="8 6" />
+        <text x="36" y="42" fill="#8fa1c0" fontSize="13" letterSpacing="3">CAMPUS DIGITAL TWIN — LIVE</text>
+
+        {/* buildings (context layer) */}
+        {buildings.map((b) => (
+          <g key={b.id}>
+            <rect x={b.x} y={b.y} width={b.width} height={b.height} rx="6"
+              fill="rgba(30,42,69,0.45)" stroke="#24365c" strokeWidth="1" />
+            <text x={b.x + b.width / 2} y={b.y + b.height / 2} fill="#5b6b8c"
+              fontSize="11" textAnchor="middle" dominantBaseline="middle">{b.name}</text>
+          </g>
+        ))}
+
+        {/* main road */}
+        <rect x="180" y="400" width="480" height="50" rx="8" fill="url(#roadGrad)" stroke="#2c3d63" />
+        <line x1="190" y1="425" x2="650" y2="425" stroke="#fbbf24" strokeWidth="2" strokeDasharray="14 10">
+          <animate attributeName="stroke-dashoffset" from="0" to="-48" dur="1.6s" repeatCount="indefinite" />
+        </line>
+        <text x="415" y="444" fill="#8fa1c0" fontSize="10" textAnchor="middle">CENTRAL ROAD</text>
+
+        {/* zones with live state */}
+        {snapshot?.zones.map((z) => (
+          <g key={z.zone_id} onClick={() => onSelectZone?.(z.zone_id)} className="cursor-pointer">
+            <rect
+              x={z.x} y={z.y} width={z.width} height={z.height} rx="8"
+              fill={showHeatmap ? DENSITY_FILL[z.density] : 'rgba(56,189,248,0.08)'}
+              stroke={DENSITY_STROKE[z.density]} strokeWidth={selectedZone === z.zone_id ? 3 : 1.5}
+              className="transition-all"
+            />
+            {z.restricted && (
+              <rect x={z.x} y={z.y} width={z.width} height={z.height} rx="8" fill="none"
+                stroke="#f87171" strokeWidth="1" strokeDasharray="4 3" />
+            )}
+            <text x={z.x + z.width / 2} y={z.y + 18} fill="#e6ecf7" fontSize="11"
+              textAnchor="middle" fontWeight="600">{z.name}</text>
+            <text x={z.x + z.width / 2} y={z.y + 36} fill="#cbd5e1" fontSize="15"
+              textAnchor="middle" fontWeight="700" fontFamily="JetBrains Mono">
+              {z.people.toLocaleString()}
+            </text>
+            <text x={z.x + z.width / 2} y={z.y + 52} fontSize="9" textAnchor="middle"
+              className={cn(DENSITY_COLORS[z.density].split(' ')[0])}>
+              {z.density} · {z.occupancy_pct.toFixed(0)}%
+            </text>
+            {z.growth_rate > 30 && (
+              <text x={z.x + z.width / 2} y={z.y + z.height - 6} fill="#fb923c" fontSize="10"
+                textAnchor="middle">▲ +{Math.round(z.growth_rate)}/10m</text>
+            )}
+          </g>
+        ))}
+
+        {/* parking zones */}
+        {snapshot?.parking.map((p: ParkingZone) => (
+          <g key={`park-${p.id}`}>
+            <rect x={p.x} y={p.y} width={p.width} height={p.height} rx="8"
+              fill={parkingFill(p.occupancy_pct)} stroke="#38bdf8" strokeWidth="1" strokeDasharray="6 4" />
+            <text x={p.x + p.width / 2} y={p.y + 20} fill="#e6ecf7" fontSize="11"
+              textAnchor="middle" fontWeight="600">{p.name}</text>
+            <text x={p.x + p.width / 2} y={p.y + 40} fill="#cbd5e1" fontSize="13"
+              textAnchor="middle" fontFamily="JetBrains Mono">
+              {p.occupancy_pct.toFixed(0)}%
+            </text>
+            <text x={p.x + p.width / 2} y={p.y + 56} fill="#8fa1c0" fontSize="9" textAnchor="middle">
+              {p.available} free
+            </text>
+          </g>
+        ))}
+
+        {/* event marker */}
+        {snapshot?.events.filter((e) => e.status === 'LIVE').map((e) => {
+          const z = snapshot.zones.find((zz) => zz.name === e.venue)
+          if (!z) return null
+          return (
+            <g key={`ev-${e.id}`}>
+              <circle cx={z.x + 14} cy={z.y + 14} r="7" fill="#f87171">
+                <animate attributeName="r" values="6;10;6" dur="1.8s" repeatCount="indefinite" />
+                <animate attributeName="opacity" values="1;0.4;1" dur="1.8s" repeatCount="indefinite" />
+              </circle>
+              <text x={z.x + 26} y={z.y + 18} fill="#f87171" fontSize="9" fontWeight="700">
+                LIVE EVENT
+              </text>
+            </g>
+          )
+        })}
+
+        {/* cameras */}
+        {cameras.map((cam) => {
+          const pos = camPos(cam)
+          const online = cam.status === 'ONLINE'
+          return (
+            <g key={cam.id}>
+              <circle cx={pos.x} cy={pos.y} r="6" fill={online ? '#38bdf8' : '#f87171'} stroke="#0a1120" strokeWidth="1.5" />
+              <circle cx={pos.x} cy={pos.y} r="10" fill="none" stroke={online ? '#38bdf8' : '#f87171'} strokeWidth="1" opacity="0.5">
+                <animate attributeName="r" values="7;14;7" dur="2.4s" repeatCount="indefinite" />
+              </circle>
+              <title>{cam.camera_id} — {cam.name} ({cam.status})</title>
+            </g>
+          )
+        })}
+      </svg>
+
+      {/* legend */}
+      <div className="absolute bottom-3 left-3 glass rounded-lg px-3 py-2 text-[11px] text-nexus-muted flex items-center gap-4">
+        <span className="flex items-center gap-1"><span className="h-2.5 w-2.5 rounded-full bg-nexus-green"></span> Low</span>
+        <span className="flex items-center gap-1"><span className="h-2.5 w-2.5 rounded-full bg-nexus-yellow"></span> Medium</span>
+        <span className="flex items-center gap-1"><span className="h-2.5 w-2.5 rounded-full bg-nexus-orange"></span> High</span>
+        <span className="flex items-center gap-1"><span className="h-2.5 w-2.5 rounded-full bg-nexus-red"></span> Critical</span>
+        <span className="flex items-center gap-1"><span className="h-2.5 w-2.5 rounded-full bg-nexus-accent"></span> Camera</span>
+        <span className="flex items-center gap-1"><span className="h-2.5 w-2.5 rounded-full bg-nexus-red animate-pulse"></span> Live event</span>
+      </div>
+    </div>
+  )
+}

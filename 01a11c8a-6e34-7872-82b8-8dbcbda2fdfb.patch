+                </div>
+                <div className="rounded-lg border border-nexus-border p-3">
+                  <div className="text-[10px] uppercase text-nexus-muted flex items-center gap-1"><TrendingUp size={10} /> Predicted peak</div>
+                  <div className={`font-mono text-lg font-bold ${breach ? 'text-nexus-red' : 'text-nexus-yellow'}`}>{fmt(e.predicted_peak)}</div>
+                </div>

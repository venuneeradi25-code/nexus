+import { useOutletContext } from 'react-router-dom'
+import type { Snapshot } from '../lib/types'
+import { TrendingUp, ArrowRight, Lightbulb } from 'lucide-react'
+import { RiskBadge } from '../components/Badges'
+
+interface Ctx { snapshot: Snapshot | null }
+
+export default function Predictions() {
+  const { snapshot } = useOutletContext<Ctx>()
+  if (!snapshot) return <div className="text-nexus-muted">Loading…</div>
+
+  const preds = snapshot.predictions
+  const riskPred = preds.find((p) => p.target === 'RISK')
+
+  return (
+    <div className="space-y-6">
+      <h1 className="text-xl font-bold flex items-center gap-2"><TrendingUp size={20} className="text-nexus-accent" /> Predictive Campus Intelligence</h1>
+      <p className="text-sm text-nexus-muted -mt-3">
+        CURRENT → PREDICTED → RECOMMENDED ACTION. The prediction engine continuously extrapolates
+        crowd growth, parking fill-time, traffic buildup and event overcrowding from live twin data.
+      </p>
+
+      {/* risk outlook banner */}
+      {riskPred && (
+        <div className="glass rounded-xl border border-nexus-border p-5 flex items-center justify-between">
+          <div>
+            <div className="text-xs uppercase tracking-wider text-nexus-muted">Campus risk outlook · next {riskPred.horizon_minutes} minutes</div>
+            <div className="mt-1 flex items-center gap-3">
+              <span className="font-mono text-3xl font-bold">{Math.round(riskPred.current_value)}</span>
+              <ArrowRight className="text-nexus-muted" />
+              <span className="font-mono text-3xl font-bold text-nexus-yellow">{Math.round(riskPred.predicted_value)}</span>
+              <RiskBadge level={snapshot.risk.level} />
+            </div>
+          </div>
+          <div className="text-right text-xs text-nexus-muted max-w-md">
+            {riskPred.recommendation}
+            <div className="mt-1">Confidence {(riskPred.confidence * 100).toFixed(0)}%</div>
+          </div>
+        </div>
+      )}
+
+      {/* prediction cards: CURRENT -> PREDICTED -> ACTION */}
+      <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
+        {preds.filter((p) => p.target !== 'RISK').map((p, i) => (
+          <div key={i} className="glass rounded-xl border border-nexus-border p-5">
+            <div className="flex items-center justify-between mb-3">
+              <span className="text-xs font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-nexus-accent/15 text-nexus-accent border border-nexus-accent/30">
+                {p.target}
+              </span>
+              <span className="text-xs text-nexus-muted">confidence {(p.confidence * 100).toFixed(0)}%</span>
+            </div>
+            <div className="text-sm font-semibold mb-3">{p.location}</div>
+            <div className="flex items-center gap-3 mb-4">
+              <div className="flex-1 rounded-lg border border-nexus-border p-3 text-center">
+                <div className="text-[10px] uppercase text-nexus-muted">Current</div>
+                <div className="font-mono text-2xl font-bold">
+                  {p.target === 'PARKING' ? `${p.current_value.toFixed(0)}%` : Math.round(p.current_value).toLocaleString()}
+                </div>
+              </div>
+              <ArrowRight className="text-nexus-muted shrink-0" />
+              <div className="flex-1 rounded-lg border border-nexus-yellow/40 bg-nexus-yellow/5 p-3 text-center">
+                <div className="text-[10px] uppercase text-nexus-muted">Predicted · {p.horizon_minutes} min</div>
+                <div className="font-mono text-2xl font-bold text-nexus-yellow">
+                  {p.target === 'PARKING' ? `${p.predicted_value.toFixed(0)}%` : Math.round(p.predicted_value).toLocaleString()}
+                </div>
+              </div>
+            </div>
+            <div className="rounded-lg border border-nexus-green/30 bg-nexus-green/5 p-3 text-xs flex items-start gap-2">
+              <Lightbulb size={13} className="text-nexus-green shrink-0 mt-0.5" />
+              <div>
+                <div className="font-semibold text-nexus-green mb-0.5">RECOMMENDED ACTION</div>
+                <div className="text-nexus-muted">{p.recommendation}</div>
+              </div>
+            </div>
+          </div>
+        ))}
+      </div>
+
+      {preds.filter((p) => p.target !== 'RISK').length === 0 && (
+        <div className="glass rounded-xl border border-nexus-border p-8 text-center text-nexus-muted">
+          No significant predictions right now — campus is operating within normal parameters.
+        </div>
+      )}
+    </div>
+  )
+}

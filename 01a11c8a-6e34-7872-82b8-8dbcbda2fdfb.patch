+++ b/backend/app/ai/baselines.py
@@ -0,0 +1,169 @@
+"""Statistical baselines learned from historical data + anomaly detection.
+
+Normal campus patterns are learned from the seeded 30-day history:
+  - crowd per zone per hour-of-day  -> mean / std / p05 / p95
+  - parking occupancy per hour      -> normal range
+  - daily resource consumption      -> normal range
+Anything outside the learned range (z-score or percentile based) is an anomaly.
+"""
+from __future__ import annotations
+
+import math
+from collections import defaultdict
+from datetime import datetime
+from typing import Any
+
+from sqlalchemy import func
+from sqlalchemy.orm import Session
+
+from ..models import CampusMetric, CrowdRecord, ResourceUsage
+
+
+class BaselineLearner:
+    """Learns 'normal' patterns from historical records."""
+
+    def __init__(self):
+        self.crowd: dict[tuple[int, int], dict[str, float]] = {}      # (zone_id, hour) -> stats
+        self.parking_hourly: dict[int, dict[str, float]] = {}
+        self.resources: dict[str, dict[str, float]] = {}
+
+    # ------------------------------------------------------------------ learn
+    def learn(self, db: Session):
+        self._learn_crowd(db)
+        self._learn_parking(db)
+        self._learn_resources(db)
+
+    def _stats(self, values: list[float]) -> dict[str, float]:
+        if not values:
+            return {"mean": 0.0, "std": 1.0, "min": 0.0, "max": 0.0, "p05": 0.0, "p95": 0.0, "n": 0}
+        n = len(values)
+        mean = sum(values) / n
+        var = sum((v - mean) ** 2 for v in values) / max(n - 1, 1)
+        std = math.sqrt(var)
+        ordered = sorted(values)
+        def pct(p: float) -> float:
+            k = (len(ordered) - 1) * p
+            f = math.floor(k)
+            c = math.ceil(k)
+            if f == c:
+                return ordered[int(k)]
+            return ordered[f] + (ordered[c] - ordered[f]) * (k - f)
+        return {
+            "mean": mean, "std": std, "min": min(values), "max": max(values),
+            "p05": pct(0.05), "p95": pct(0.95), "n": n,
+        }
+
+    def _learn_crowd(self, db: Session):
+        rows = (
+            db.query(CrowdRecord.zone_id, func.strftime("%H", CrowdRecord.timestamp), CrowdRecord.people_count)
+            .all()
+        )
+        buckets: dict[tuple[int, int], list[float]] = defaultdict(list)
+        for zone_id, hour, count in rows:
+            try:
+                buckets[(zone_id, int(hour))].append(float(count))
+            except (TypeError, ValueError):
+                continue
+        self.crowd = {k: self._stats(v) for k, v in buckets.items()}
+
+    def _learn_parking(self, db: Session):
+        rows = db.query(
+            func.strftime("%H", CampusMetric.timestamp), CampusMetric.parking_occupancy_pct
+        ).all()
+        buckets: dict[int, list[float]] = defaultdict(list)
+        for hour, occ in rows:
+            try:
+                buckets[int(hour)].append(float(occ or 0))
+            except (TypeError, ValueError):
+                continue
+        self.parking_hourly = {k: self._stats(v) for k, v in buckets.items()}
+
+    def _learn_resources(self, db: Session):
+        rows = db.query(
+            ResourceUsage.resource_type, func.strftime("%H", ResourceUsage.timestamp),
+            ResourceUsage.value,
+        ).all()
+        buckets: dict[tuple[str, int], list[float]] = defaultdict(list)
+        for rtype, hour, value in rows:
+            try:
+                buckets[(rtype, int(hour))].append(float(value or 0))
+            except (TypeError, ValueError):
+                continue
+        self.resources = {k: self._stats(v) for k, v in buckets.items()}
+
+    # ---------------------------------------------------------------- evaluate
+    def crowd_stats(self, zone_id: int, hour: int) -> dict[str, float]:
+        return self.crowd.get((zone_id, hour)) or self.crowd.get((zone_id, -1)) or {
+            "mean": 0.0, "std": 1.0, "p05": 0.0, "p95": 0.0, "n": 0,
+        }
+
+    def is_crowd_anomaly(self, zone_id: int, hour: int, value: float) -> tuple[bool, dict[str, Any]]:
+        s = self.crowd_stats(zone_id, hour)
+        if s["n"] < 3:
+            return False, s
+        upper = max(s["p95"], s["mean"] + 2.0 * s["std"])
+        lower = min(s["p05"], s["mean"] - 2.0 * s["std"])
+        z = (value - s["mean"]) / s["std"] if s["std"] > 0 else 0.0
+        if value > upper * 1.25 or z > 2.5:
+            return True, {**s, "upper": upper, "lower": lower, "z": z}
+        return False, {**s, "upper": upper, "lower": lower, "z": z}
+
+    def parking_range(self, hour: int) -> tuple[float, float]:
+        s = self.parking_hourly.get(hour)
+        if not s or s["n"] < 3:
+            return (40.0, 80.0)
+        return (s["p05"], s["p95"])
+
+    def resource_stats(self, resource_type: str, hour: int | None = None) -> dict[str, float]:
+        if hour is not None and (resource_type, hour) in self.resources:
+            return self.resources[(resource_type, hour)]
+        # fall back to any hour for this resource type
+        vals = [s for (rt, _), s in self.resources.items() if rt == resource_type]
+        if vals:
+            return vals[0]
+        return {"mean": 0.0, "std": 1.0, "p95": 0.0, "n": 0}
+
+    def is_resource_anomaly(self, resource_type: str, value: float,
+                            hour: int | None = None) -> tuple[bool, dict[str, float]]:
+        s = self.resource_stats(resource_type, hour)
+        if s["n"] < 3:
+            return False, s
+        upper = max(s["p95"], s["mean"] + 2.0 * s["std"])
+        return value > upper * 1.1, s
+
+
+def density_from_count(people: int, capacity: int) -> str:
+    if capacity <= 0:
+        return "LOW"
+    ratio = people / capacity
+    if ratio >= 0.9:
+        return "CRITICAL"
+    if ratio >= 0.7:
+        return "HIGH"
+    if ratio >= 0.4:
+        return "MEDIUM"
+    return "LOW"
+
+
+def congestion_from_rate(incoming: int) -> str:
+    if incoming >= 220:
+        return "CRITICAL"
+    if incoming >= 160:
+        return "HIGH"
+    if incoming >= 100:
+        return "MODERATE"
+    return "LOW"
+
+
+def risk_level_from_score(score: int) -> str:
+    if score >= 75:
+        return "CRITICAL"
+    if score >= 50:
+        return "ELEVATED"
+    if score >= 25:
+        return "MODERATE"
+    return "NORMAL"
+
+
+def now_hour(dt: datetime | None = None) -> int:
+    return (dt or datetime.now()).hour

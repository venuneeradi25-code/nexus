@@ -0,0 +1,179 @@
+import { useEffect, useState } from 'react'
+import api from '../lib/api'
+import { BarChart3 } from 'lucide-react'
+import { LineChart, Line, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid, Legend, AreaChart, Area } from 'recharts'
+
+interface Trends {
+  range: string
+  crowd: { name: string; points: { timestamp: string; value: number }[] }[]
+  parking_occupancy: { timestamp: string; value: number }[]
+  traffic: { timestamp: string; value: number }[]
+  risk: { timestamp: string; value: number }[]
+  resource: Record<string, { timestamp: string; value: number }[]>
+  anomaly_count: number
+  prediction_accuracy: number
+}
+
+const RANGES = ['TODAY', 'YESTERDAY', '7D', '30D']
+const PALETTE = ['#38bdf8', '#818cf8', '#34d399', '#fbbf24', '#fb923c', '#f87171']
+
+export default function Analytics() {
+  const [range, setRange] = useState('TODAY')
+  const [data, setData] = useState<Trends | null>(null)
+  const [accuracy, setAccuracy] = useState<number | null>(null)
+
+  useEffect(() => {
+    api.get(`/analytics/trends?range=${range}`).then((r) => setData(r.data)).catch(() => {})
+  }, [range])
+  useEffect(() => {
+    api.get('/analytics/accuracy').then((r) => setAccuracy(r.data.prediction_accuracy_pct)).catch(() => {})
+  }, [])
+
+  const fmtT = (iso: string) => {
+    const d = new Date(iso)
+    return range === 'TODAY'
+      ? d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
+      : `${d.getMonth() + 1}/${d.getDate()} ${d.toLocaleTimeString([], { hour: '2-digit' })}`
+  }
+
+  return (
+    <div className="space-y-6">
+      <div className="flex items-center justify-between">
+        <h1 className="text-xl font-bold flex items-center gap-2"><BarChart3 size={20} className="text-nexus-accent" /> Campus Analytics</h1>
+        <div className="flex items-center gap-2">
+          {RANGES.map((r) => (
+            <button key={r} onClick={() => setRange(r)}
+              className={`rounded-lg border px-3 py-1.5 text-xs font-semibold ${range === r ? 'border-nexus-accent bg-nexus-accent/15 text-nexus-accent' : 'border-nexus-border text-nexus-muted'}`}>
+              {r === 'TODAY' ? 'Today' : r === 'YESTERDAY' ? 'Yesterday' : r === '7D' ? '7 Days' : '30 Days'}
+            </button>
+          ))}
+        </div>
+      </div>
+
+      <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase text-nexus-muted">Anomalies in range</div>
+          <div className="text-3xl font-bold font-mono mt-1 text-nexus-orange">{data?.anomaly_count ?? '—'}</div>
+        </div>
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase text-nexus-muted">Prediction accuracy</div>
+          <div className="text-3xl font-bold font-mono mt-1 text-nexus-green">{accuracy != null ? `${accuracy}%` : '—'}</div>
+        </div>
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase text-nexus-muted">Crowd series</div>
+          <div className="text-3xl font-bold font-mono mt-1">{data?.crowd.length ?? '—'}</div>
+        </div>
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase text-nexus-muted">Resources tracked</div>
+          <div className="text-3xl font-bold font-mono mt-1">{data ? Object.keys(data.resource).length : '—'}</div>
+        </div>
+      </div>
+
+      {/* crowd trends */}
+      <div className="glass rounded-xl border border-nexus-border p-4">
+        <h3 className="text-sm font-semibold mb-3">Crowd trends by zone</h3>
+        <div className="h-72">
+          <ResponsiveContainer width="100%" height="100%">
+            <LineChart data={mergeSeries(data?.crowd)}>
+              <CartesianGrid strokeDasharray="3 3" />
+              <XAxis dataKey="t" tick={{ fontSize: 10 }} interval="preserveStartEnd" />
+              <YAxis tick={{ fontSize: 10 }} />
+              <Tooltip contentStyle={{ background: '#0d1424', border: '1px solid #1e2a45', fontSize: 12 }} />
+              <Legend />
+              {(data?.crowd || []).map((s, i) => (
+                <Line key={s.name} type="monotone" dataKey={s.name} stroke={PALETTE[i % PALETTE.length]} strokeWidth={1.5} dot={false} />
+              ))}
+            </LineChart>
+          </ResponsiveContainer>
+        </div>
+      </div>
+
+      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
+        {/* parking */}
+        <div className="glass rounded-xl border border-nexus-border p-4">
+          <h3 className="text-sm font-semibold mb-3">Parking occupancy trend</h3>
+          <div className="h-60">
+            <ResponsiveContainer width="100%" height="100%">
+              <AreaChart data={(data?.parking_occupancy || []).map((p) => ({ t: fmtT(p.timestamp), value: p.value }))}>
+                <CartesianGrid strokeDasharray="3 3" />
+                <XAxis dataKey="t" tick={{ fontSize: 10 }} interval="preserveStartEnd" />
+                <YAxis tick={{ fontSize: 10 }} unit="%" />
+                <Tooltip contentStyle={{ background: '#0d1424', border: '1px solid #1e2a45', fontSize: 12 }} />
+                <Area type="monotone" dataKey="value" stroke="#fbbf24" fill="rgba(251,191,36,0.2)" strokeWidth={2} name="Occupancy %" />
+              </AreaChart>
+            </ResponsiveContainer>
+          </div>
+        </div>
+
+        {/* risk trend */}
+        <div className="glass rounded-xl border border-nexus-border p-4">
+          <h3 className="text-sm font-semibold mb-3">Campus risk score trend</h3>
+          <div className="h-60">
+            <ResponsiveContainer width="100%" height="100%">
+              <AreaChart data={(data?.risk || []).map((p) => ({ t: fmtT(p.timestamp), value: p.value }))}>
+                <CartesianGrid strokeDasharray="3 3" />
+                <XAxis dataKey="t" tick={{ fontSize: 10 }} interval="preserveStartEnd" />
+                <YAxis tick={{ fontSize: 10 }} domain={[0, 100]} />
+                <Tooltip contentStyle={{ background: '#0d1424', border: '1px solid #1e2a45', fontSize: 12 }} />
+                <Area type="monotone" dataKey="value" stroke="#f87171" fill="rgba(248,113,113,0.2)" strokeWidth={2} name="Risk /100" />
+              </AreaChart>
+            </ResponsiveContainer>
+          </div>
+        </div>
+
+        {/* traffic */}
+        <div className="glass rounded-xl border border-nexus-border p-4">
+          <h3 className="text-sm font-semibold mb-3">Traffic inflow trend (vehicles/min)</h3>
+          <div className="h-60">
+            <ResponsiveContainer width="100%" height="100%">
+              <LineChart data={(data?.traffic || []).map((p) => ({ t: fmtT(p.timestamp), value: p.value }))}>
+                <CartesianGrid strokeDasharray="3 3" />
+                <XAxis dataKey="t" tick={{ fontSize: 10 }} interval="preserveStartEnd" />
+                <YAxis tick={{ fontSize: 10 }} />
+                <Tooltip contentStyle={{ background: '#0d1424', border: '1px solid #1e2a45', fontSize: 12 }} />
+                <Line type="monotone" dataKey="value" stroke="#38bdf8" strokeWidth={2} dot={false} name="Incoming/min" />
+              </LineChart>
+            </ResponsiveContainer>
+          </div>
+        </div>
+
+        {/* resources */}
+        <div className="glass rounded-xl border border-nexus-border p-4">
+          <h3 className="text-sm font-semibold mb-3">Resource consumption trend</h3>
+          <div className="h-60">
+            <ResponsiveContainer width="100%" height="100%">
+              <LineChart data={mergeSeries(Object.entries(data?.resource || {}).map(([name, pts]) => ({ name, points: pts })))}>
+                <CartesianGrid strokeDasharray="3 3" />
+                <XAxis dataKey="t" tick={{ fontSize: 10 }} interval="preserveStartEnd" />
+                <YAxis tick={{ fontSize: 10 }} />
+                <Tooltip contentStyle={{ background: '#0d1424', border: '1px solid #1e2a45', fontSize: 12 }} />
+                <Legend />
+                {Object.keys(data?.resource || {}).map((name, i) => (
+                  <Line key={name} type="monotone" dataKey={name} stroke={PALETTE[i % PALETTE.length]} strokeWidth={1.5} dot={false} />
+                ))}
+              </LineChart>
+            </ResponsiveContainer>
+          </div>
+        </div>
+      </div>
+    </div>
+  )
+}
+
+/** Merge multi-series points into rows keyed by timestamp label. */
+function mergeSeries(series?: { name: string; points: { timestamp: string; value: number }[] }[]) {
+  if (!series || series.length === 0) return []
+  const byT: Record<string, any> = {}
+  const tLabel = (iso: string) => {
+    const d = new Date(iso)
+    return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
+  }
+  for (const s of series) {
+    for (const p of s.points) {
+      const key = tLabel(p.timestamp)
+      byT[key] = byT[key] || { t: key }
+      byT[key][s.name] = p.value
+    }
+  }
+  return Object.values(byT)
+}

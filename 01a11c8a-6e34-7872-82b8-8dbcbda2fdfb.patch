@@ -0,0 +1,152 @@
+"""Campus structure: buildings, zones, cameras, AI detections, video analysis."""
+import asyncio
+from datetime import datetime, timedelta
+
+import httpx
+from fastapi import APIRouter, Depends, File, HTTPException, UploadFile
+from sqlalchemy import func
+from sqlalchemy.orm import Session
+
+from .. import models as m
+from ..ai import vision
+from ..ai.engine import engine
+from ..config import get_settings
+from ..database import get_db
+from ..dependencies import AnyAdmin, get_current_user
+from ..models import User
+from ..schemas import BuildingOut, CameraEventCreate, CameraEventOut, CameraOut, ZoneOut
+
+router = APIRouter(prefix="/api", tags=["campus"])
+settings = get_settings()
+
+
+# ------------------------------------------------------------- buildings ---
+@router.get("/buildings", response_model=list[BuildingOut])
+def list_buildings(db: Session = Depends(get_db), user: User = Depends(get_current_user)):
+    return [BuildingOut.model_validate(b) for b in db.query(m.Building).all()]
+
+
+# ---------------------------------------------------------------- zones ----
+@router.get("/zones", response_model=list[ZoneOut])
+def list_zones(db: Session = Depends(get_db), user: User = Depends(get_current_user)):
+    return [ZoneOut.model_validate(z) for z in db.query(m.Zone).all()]
+
+
+@router.get("/zones/{zone_id}/live")
+def zone_live(zone_id: int, db: Session = Depends(get_db),
+              user: User = Depends(get_current_user)):
+    z = engine.zones.get(zone_id)
+    if not z:
+        raise HTTPException(404, "Zone not found")
+    recent = (db.query(m.CrowdRecord)
+              .filter(m.CrowdRecord.zone_id == zone_id)
+              .order_by(m.CrowdRecord.id.desc()).limit(120).all())
+    return {
+        "zone": z,
+        "history": [{"timestamp": r.timestamp, "people": r.people_count,
+                     "density": r.density.value, "growth_rate": r.growth_rate}
+                    for r in reversed(recent)],
+    }
+
+
+# -------------------------------------------------------------- cameras ----
+@router.get("/cameras", response_model=list[CameraOut])
+def list_cameras(db: Session = Depends(get_db), user: User = Depends(get_current_user)):
+    return [CameraOut.model_validate(c) for c in db.query(m.Camera).all()]
+
+
+@router.get("/cameras/{camera_id}/events", response_model=list[CameraEventOut])
+def camera_events(camera_id: str, limit: int = 100, db: Session = Depends(get_db),
+                  user: User = Depends(get_current_user)):
+    cam = db.query(m.Camera).filter(m.Camera.camera_id == camera_id).first()
+    if not cam:
+        raise HTTPException(404, "Camera not found")
+    rows = (db.query(m.CameraEvent).filter(m.CameraEvent.camera_id == cam.id)
+            .order_by(m.CameraEvent.id.desc()).limit(limit).all())
+    return [CameraEventOut.model_validate(r) for r in reversed(rows)]
+
+
+@router.post("/cameras/{camera_id}/events", response_model=CameraEventOut, status_code=201)
+def ingest_event(camera_id: str, ev: CameraEventCreate, db: Session = Depends(get_db),
+                 user: User = Depends(AnyAdmin)):
+    """AI services / edge devices push detections here (person/vehicle counts)."""
+    cam = db.query(m.Camera).filter(m.Camera.camera_id == camera_id).first()
+    if not cam:
+        raise HTTPException(404, "Camera not found")
+    row = m.CameraEvent(camera_id=cam.id, event_type=ev.event_type, count=ev.count,
+                        confidence=ev.confidence, details=ev.details)
+    db.add(row)
+    cam.last_update = datetime.now()
+    db.commit()
+    db.refresh(row)
+    return CameraEventOut.model_validate(row)
+
+
+@router.post("/cameras/{camera_id}/analyze")
+async def analyze_camera_video(camera_id: str, file: UploadFile = File(...),
+                               db: Session = Depends(get_db),
+                               user: User = Depends(AnyAdmin)):
+    """Upload a video for this camera; the AI service analyzes it (people/vehicle
+    counts, crowd density, movement). Falls back to the built-in OpenCV pipeline
+    if the AI microservice is unreachable. Results are stored as camera events."""
+    cam = db.query(m.Camera).filter(m.Camera.camera_id == camera_id).first()
+    if not cam:
+        raise HTTPException(404, "Camera not found")
+    data = await file.read()
+    result = None
+    # prefer the separate AI microservice
+    try:
+        async with httpx.AsyncClient(timeout=120) as client:
+            resp = await client.post(
+                f"{settings.AI_SERVICE_URL}/analyze/video",
+                files={"file": (file.filename or "upload.mp4", data, file.content_type)})
+            if resp.status_code == 200:
+                result = resp.json()
+    except Exception:
+        result = None
+    if result is None:
+        loop = asyncio.get_event_loop()
+        result = await loop.run_in_executor(
+            None, vision.analyze_upload, data, ".mp4")
+
+    # persist detections as camera events + nudge the twin
+    for point in result.get("timeline", [])[:: max(1, len(result.get("timeline", [])) // 10 or 1)]:
+        db.add(m.CameraEvent(
+            camera_id=cam.id,
+            event_type="PERSON" if point["people"] >= point["vehicles"] else "VEHICLE",
+            count=point["people"] + point["vehicles"],
+            confidence=0.9,
+            details={"source": "upload_analysis", "t": point["t"],
+                     "people": point["people"], "vehicles": point["vehicles"],
+                     "density": point["density"]},
+            timestamp=datetime.now() - timedelta(seconds=result.get("duration_seconds", 0)
+                                                  + point["t"])))
+    zone = next((z for z in engine.zones.values() if z["name"] in cam.location), None)
+    if zone:
+        zone["people"] = max(zone["people"], int(result.get("peak_people", zone["people"])))
+    db.commit()
+    return {"camera_id": camera_id, "analysis": result}
+
+
+@router.get("/detections/latest")
+def latest_detections(limit: int = 50, db: Session = Depends(get_db),
+                      user: User = Depends(get_current_user)):
+    rows = (db.query(m.CameraEvent, m.Camera.camera_id)
+            .join(m.Camera, m.Camera.id == m.CameraEvent.camera_id)
+            .order_by(m.CameraEvent.id.desc()).limit(limit).all())
+    return [{"id": r.CameraEvent.id, "camera": r.camera_id, "event_type": r.CameraEvent.event_type,
+             "count": r.CameraEvent.count, "confidence": r.CameraEvent.confidence,
+             "details": r.CameraEvent.details, "timestamp": r.CameraEvent.timestamp}
+            for r in rows]
+
+
+@router.get("/detections/stats")
+def detection_stats(db: Session = Depends(get_db), user: User = Depends(get_current_user)):
+    rows = (db.query(m.CameraEvent.event_type, func.count(m.CameraEvent.id),
+                     func.sum(m.CameraEvent.count))
+            .group_by(m.CameraEvent.event_type).all())
+    hour_ago = datetime.now() - timedelta(hours=1)
+    recent = db.query(func.count(m.CameraEvent.id)).filter(
+        m.CameraEvent.timestamp >= hour_ago).scalar() or 0
+    return {"by_type": [{"event_type": r[0], "events": r[1], "detections": r[2] or 0} for r in rows],
+            "events_last_hour": recent}

+
+from ..ai.engine import DEMO_SCENARIOS, engine
+from ..database import get_db
+from ..dependencies import AnyAdmin, get_current_user
+from ..models import User
+from ..schemas import DemoTrigger
+
+router = APIRouter(prefix="/api/demo", tags=["demo"])
+
+
+@router.get("/scenarios")
+def scenarios(user: User = Depends(get_current_user)):
+    return {"scenarios": sorted(DEMO_SCENARIOS),
+            "active": [{"scenario": m["scenario"], "until": m["until"].isoformat(),
+                        "intensity": m["intensity"]} for m in engine.modifiers]}

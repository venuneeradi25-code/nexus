+"""NEXUS API smoke test — run against a live backend on :8000."""
+import json
+import sys
+import urllib.request
+
+BASE = "http://localhost:8000"
+PASS, FAIL = 0, 0
+
+
+def call(method, path, body=None, token=None):
+    req = urllib.request.Request(BASE + path, method=method)
+    req.add_header("Content-Type", "application/json")
+    if token:
+        req.add_header("Authorization", f"Bearer {token}")
+    data = json.dumps(body).encode() if body is not None else None
+    try:
+        with urllib.request.urlopen(req, data=data, timeout=30) as r:
+            return r.status, json.loads(r.read() or b"{}")
+    except urllib.error.HTTPError as e:
+        return e.code, e.read().decode()[:300]
+
+
+def check(name, cond, extra=""):
+    global PASS, FAIL
+    if cond:
+        PASS += 1
+        print(f"  PASS {name}")
+    else:
+        FAIL += 1
+        print(f"  FAIL {name} {extra}")
+
+
+print("== auth ==")
+st, tok = call("POST", "/api/auth/login", {"username": "admin@nexus.ai", "password": "Nexus@2026"})
+check("login", st == 200 and "access_token" in tok, str(tok)[:200])
+T = tok["access_token"]
+st, bad = call("POST", "/api/auth/login", {"username": "admin@nexus.ai", "password": "wrong"})
+check("bad login rejected", st == 401)
+st, me = call("GET", "/api/auth/me", token=T)
+check("me", st == 200 and me["role"] == "CAMPUS_ADMIN")
+st, noauth = call("GET", "/api/dashboard")
+check("dashboard requires auth", st in (401, 403))
+
+print("== dashboard / live ==")
+st, d = call("GET", "/api/dashboard", token=T)
+check("dashboard", st == 200 and len(d["zones"]) == 11)
+check("risk breakdown", st == 200 and 0 <= d["risk"]["score"] <= 100 and d["risk"]["level"])
+check("anomalies present", "anomalies" in d)
+check("parking zones", len(d["parking"]) == 5)
+check("events", len(d["events"]) == 2)
+
+print("== crowd / parking / traffic / environment / resources ==")
+st, r = call("GET", "/api/crowd/zones", token=T); check("crowd zones", st == 200 and len(r) == 11)
+st, r = call("GET", "/api/crowd/predict", token=T); check("crowd predict", st == 200 and len(r["predictions"]) > 0)
+st, r = call("GET", "/api/crowd/records?hours=1&limit=50", token=T); check("crowd records", st == 200 and len(r) > 0)
+st, r = call("GET", "/api/parking", token=T); check("parking", st == 200 and len(r) == 5 and all("occupancy_pct" in p for p in r))
+st, r = call("GET", "/api/parking/1/slots", token=T); check("parking slots", st == 200 and len(r) > 100)
+st, r = call("GET", "/api/vehicles/flow", token=T); check("vehicle flow", st == 200 and len(r["gates"]) == 3)
+st, r = call("GET", "/api/traffic/live", token=T); check("traffic live", st == 200)
+st, r = call("GET", "/api/environment/latest", token=T); check("environment", st == 200 and "condition" in r)
+st, r = call("GET", "/api/resources/latest", token=T); check("resources", st == 200 and len(r) == 4)
+st, r = call("GET", "/api/risk", token=T); check("risk", st == 200 and "contributors" in r)
+st, r = call("GET", "/api/metrics?hours=1", token=T); check("metrics history", st == 200 and len(r) > 0)
+
+print("== cameras / detections ==")
+st, r = call("GET", "/api/cameras", token=T); check("cameras", st == 200 and len(r) == 5)
+st, r = call("GET", "/api/cameras/CAM-001/events?limit=10", token=T); check("camera events", st == 200)
+st, r = call("GET", "/api/detections/latest?limit=10", token=T); check("detections", st == 200)
+st, r = call("GET", "/api/detections/stats", token=T); check("detection stats", st == 200)
+
+print("== alerts ==")
+st, r = call("GET", "/api/alerts", token=T); check("alerts list", st == 200)
+if r:
+    aid = r[0]["id"]
+    st2, r2 = call("POST", f"/api/alerts/{aid}/acknowledge", token=T)
+    check("acknowledge alert", st2 == 200 and r2["status"] == "ACKNOWLEDGED")
+    st2, _ = call("POST", f"/api/alerts/{aid}/resolve", token=T)
+    check("resolve alert", st2 == 200)
+st, r = call("GET", "/api/alerts/stats/summary", token=T); check("alert stats", st == 200)
+
+print("== predictions ==")
+st, r = call("GET", "/api/predictions/live", token=T); check("predictions live", st == 200 and len(r["predictions"]) > 0)
+st, r = call("GET", "/api/predictions", token=T); check("predictions db", st == 200)
+
+print("== what-if simulator ==")
+for scen, params in [
+    ("GATE_CLOSURE", {"gate": "Main Gate"}),
+    ("EVENT_CROWD", {"event": "TECHNOVA 2026", "multiplier": 2.0}),
+    ("PARKING_UNAVAILABLE", {"zone": "Parking Zone A"}),
+    ("EVENT_EXTENSION", {"hours": 2}),
+    ("VEHICLE_SURGE", {"percent": 30}),
+    ("WEATHER_CHANGE", {"condition": "HEAVY_RAIN"}),
+]:
+    st, r = call("POST", "/api/simulations/run", {"scenario": scen, "parameters": params}, token=T)
+    check(f"sim {scen}", st == 201 and len(r["recommendations"]) > 0, str(r)[:200])
+st, r = call("POST", "/api/simulations/run", {"scenario": "NOPE", "parameters": {}}, token=T)
+check("bad scenario rejected", st == 400)
+st, r = call("GET", "/api/simulations", token=T); check("sim history", st == 200 and len(r) >= 6)
+st, r = call("GET", "/api/simulations/scenarios", token=T); check("scenario list", st == 200 and len(r["scenarios"]) == 6)
+
+print("== demo mode ==")
+st, r = call("POST", "/api/demo/trigger", {"scenario": "CROWD_INCREASE", "duration_minutes": 5}, token=T)
+check("demo trigger", st == 200 and r["ok"])
+st, r = call("GET", "/api/demo/status", token=T); check("demo status", st == 200 and "CROWD_INCREASE" in r["active_modifiers"])
+st, r = call("POST", "/api/demo/trigger", {"scenario": "RESET"}, token=T); check("demo reset", st == 200)
+
+print("== assistant ==")
+for q in ["How is the campus right now?", "Where is the highest crowd concentration?",
+          "Which parking zone will fill first?", "Why is the campus risk score high?",
+          "What could happen if the main gate is closed?", "Is any unusual activity happening?",
+          "What is today's biggest operational risk?", "How is the weather?"]:
+    st, r = call("POST", "/api/assistant/ask", {"question": q}, token=T)
+    check(f"ask: {q[:40]}", st == 200 and len(r["answer"]) > 20, str(r)[:150])
+st, r = call("GET", "/api/assistant/suggestions", token=T); check("suggestions", st == 200)
+
+print("== analytics / replay / report ==")
+st, r = call("GET", "/api/analytics/trends?range=TODAY", token=T); check("trends today", st == 200 and len(r["crowd"]) > 0)
+st, r = call("GET", "/api/analytics/trends?range=7D", token=T); check("trends 7d", st == 200)
+st, r = call("GET", "/api/analytics/anomalies?range=TODAY", token=T); check("anomaly history", st == 200)
+st, r = call("GET", "/api/analytics/replay?range=TODAY", token=T); check("replay", st == 200 and len(r["frames"]) > 0)
+st, r = call("GET", "/api/analytics/accuracy", token=T); check("accuracy", st == 200 and r["prediction_accuracy_pct"] > 0)
+st, r = call("GET", "/api/admin/report/daily", token=T); check("daily report", st == 200 and len(r["summary"]) > 20, str(r)[:200])
+
+print("== admin / privacy ==")
+st, r = call("GET", "/api/admin/system", token=T); check("system info", st == 200 and r["name"] == "NEXUS")
+st, r = call("GET", "/api/admin/privacy", token=T); check("privacy get", st == 200 and r["facial_recognition_enabled"] is False)
+st, r = call("PUT", "/api/admin/privacy", {"data_retention_days": 30}, token=T)
+check("privacy put (super admin only)", st == 403)  # admin is CAMPUS_ADMIN
+st, tok2 = call("POST", "/api/auth/login", {"username": "superadmin@nexus.ai", "password": "Nexus@2026"})
+st, r = call("PUT", "/api/admin/privacy", {"data_retention_days": 30}, token=tok2["access_token"])
+check("privacy put (super admin)", st == 200 and r["data_retention_days"] == 30)
+st, r = call("GET", "/api/admin/users", token=tok2["access_token"]); check("users list", st == 200 and len(r) == 4)
+st, r = call("GET", "/api/admin/users", token=T); check("users forbidden for campus admin", st == 403)
+
+print("== zones/buildings ==")
+st, r = call("GET", "/api/zones", token=T); check("zones", st == 200 and len(r) == 11)
+st, r = call("GET", "/api/buildings", token=T); check("buildings", st == 200 and len(r) == 9)
+st, r = call("GET", "/api/zones/1/live", token=T); check("zone live", st == 200 and len(r["history"]) > 0)
+
+print(f"\n{'='*40}\nRESULT: {PASS} passed, {FAIL} failed")
+sys.exit(1 if FAIL else 0)

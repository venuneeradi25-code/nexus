+import { useState } from 'react'
+import { useNavigate } from 'react-router-dom'
+import { useAuth } from '../store/auth'
+import { ShieldCheck, Radar } from 'lucide-react'
+
+export default function Login() {
+  const { login } = useAuth()
+  const navigate = useNavigate()
+  const [username, setUsername] = useState('admin@nexus.ai')
+  const [password, setPassword] = useState('Nexus@2026')
+  const [error, setError] = useState('')
+  const [loading, setLoading] = useState(false)
+
+  const submit = async (e: React.FormEvent) => {
+    e.preventDefault()
+    setLoading(true)
+    setError('')
+    try {
+      await login(username, password)
+      navigate('/')
+    } catch {
+      setError('Invalid username or password')
+    } finally {
+      setLoading(false)
+    }
+  }
+
+  return (
+    <div className="min-h-screen nexus-grid-bg flex items-center justify-center p-6">
+      <div className="glass rounded-2xl p-8 w-full max-w-md neon-accent">
+        <div className="flex items-center gap-3 mb-2">
+          <div className="h-12 w-12 rounded-xl bg-gradient-to-br from-nexus-accent to-nexus-accent2 flex items-center justify-center font-black text-white text-xl">
+            N
+          </div>
+          <div>
+            <div className="font-extrabold tracking-wider text-2xl">NEXUS</div>
+            <div className="text-xs text-nexus-muted">AI Digital Twin for Campus Intelligence</div>
+          </div>
+        </div>
+        <p className="text-sm text-nexus-muted mb-6 italic">
+          “Understand the present. Simulate the future. Prevent the unexpected.”
+        </p>
+
+        <form onSubmit={submit} className="space-y-4">
+          <div>
+            <label className="text-xs uppercase tracking-wider text-nexus-muted">Username / Email</label>
+            <input
+              value={username} onChange={(e) => setUsername(e.target.value)}
+              className="mt-1 w-full rounded-lg border border-nexus-border bg-nexus-panel px-3 py-2 text-sm focus:border-nexus-accent focus:outline-none"
+              placeholder="admin@nexus.ai"
+            />
+          </div>
+          <div>
+            <label className="text-xs uppercase tracking-wider text-nexus-muted">Password</label>
+            <input
+              type="password" value={password} onChange={(e) => setPassword(e.target.value)}
+              className="mt-1 w-full rounded-lg border border-nexus-border bg-nexus-panel px-3 py-2 text-sm focus:border-nexus-accent focus:outline-none"
+              placeholder="••••••••"
+            />
+          </div>
+          {error && <div className="text-sm text-nexus-red">{error}</div>}
+          <button
+            type="submit" disabled={loading}
+            className="w-full rounded-lg bg-gradient-to-r from-nexus-accent to-nexus-accent2 py-2.5 text-sm font-semibold text-white hover:opacity-90 disabled:opacity-50"
+          >
+            {loading ? 'Authenticating…' : 'Sign in to NEXUS'}
+          </button>
+        </form>
+
+        <div className="mt-6 grid grid-cols-2 gap-2 text-[11px]">
+          {[
+            ['superadmin@nexus.ai', 'SUPER ADMIN'],
+            ['admin@nexus.ai', 'CAMPUS ADMIN'],
+            ['security@nexus.ai', 'SECURITY ADMIN'],
+            ['event@nexus.ai', 'EVENT ADMIN'],
+          ].map(([u, r]) => (
+            <button
+              key={u} onClick={() => setUsername(u)}
+              className="rounded-lg border border-nexus-border px-2 py-2 text-left hover:border-nexus-accent/50"
+            >
+              <div className="text-nexus-text">{u}</div>
+              <div className="text-nexus-muted">{r}</div>
+            </button>
+          ))}
+        </div>
+        <div className="mt-3 text-center text-[11px] text-nexus-muted">
+          Demo password for all roles: <span className="font-mono text-nexus-text">Nexus@2026</span>

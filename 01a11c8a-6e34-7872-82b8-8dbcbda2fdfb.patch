+"""WHAT-IF Simulation API — the signature NEXUS feature."""
+import json
+from datetime import datetime
+
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+
+from .. import models as m
+from ..ai.engine import engine
+from ..ai.whatif import SCENARIOS, run_simulation
+from ..database import get_db
+from ..dependencies import AnyAdmin, get_current_user
+from ..models import User
+from ..schemas import SimulationRequest, SimulationResult
+
+router = APIRouter(prefix="/api/simulations", tags=["simulations"])
+
+
+def _jsonable(obj):
+    return json.loads(json.dumps(obj, default=str))
+
+
+@router.get("/scenarios")
+def scenarios(user: User = Depends(get_current_user)):
+    return {"scenarios": [{"id": k, "title": v} for k, v in SCENARIOS.items()]}
+
+
+@router.post("/run", response_model=SimulationResult, status_code=201)
+def run(sim: SimulationRequest, db: Session = Depends(get_db),
+        user: User = Depends(AnyAdmin)):
+    snapshot = _jsonable(engine.snapshot(db))
+    # enrich snapshot with in-memory series for better simulations
+    now_min = datetime.now().timestamp() / 60.0
+    snapshot["event_series"] = {}
+    snapshot["parking_series"] = {
+        p["name"]: [(now_min - x, v) for x, v in engine.parking_series.get(p["id"], [])]
+        for p in snapshot["parking"]}
+    snapshot["resource_anomalies"] = sum(1 for a in engine.anomalies
+                                         if a["type"] == "RESOURCE_ANOMALY")
+    snapshot["restricted_activity"] = getattr(engine, "_restricted_hits", 0)
+    snapshot["active_alerts"] = snapshot["alerts"]
+    try:
+        result = _jsonable(run_simulation(snapshot, sim.scenario, sim.parameters))
+    except ValueError as e:
+        raise HTTPException(400, str(e))
+
+    row = m.Simulation(
+        scenario=result["scenario"], title=result["title"],
+        parameters=sim.parameters, results=result,
+        recommendations=result["recommendations"],
+        risk_score_before=result["risk_score_before"],
+        risk_score_after=result["risk_score_after"],
+        created_by=user.username)
+    db.add(row)
+    db.commit()
+    db.refresh(row)
+    return SimulationResult(
+        id=row.id, scenario=row.scenario, title=row.title, parameters=row.parameters,
+        current=result["current"], simulated=result["simulated"], impact=result["impact"],
+        risk_score_before=row.risk_score_before, risk_score_after=row.risk_score_after,
+        recommendations=row.recommendations, created_at=row.created_at)
+
+
+@router.get("", response_model=list[SimulationResult])
+def history(limit: int = 50, db: Session = Depends(get_db),
+            user: User = Depends(get_current_user)):
+    rows = db.query(m.Simulation).order_by(m.Simulation.id.desc()).limit(limit).all()
+    return [SimulationResult(
+        id=r.id, scenario=r.scenario, title=r.title, parameters=r.parameters or {},
+        current=(r.results or {}).get("current", {}),
+        simulated=(r.results or {}).get("simulated", {}),
+        impact=(r.results or {}).get("impact", {}),
+        risk_score_before=r.risk_score_before, risk_score_after=r.risk_score_after,
+        recommendations=r.recommendations or [], created_at=r.created_at) for r in rows]

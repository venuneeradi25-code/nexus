+++ b/backend/app/ai/curves.py
@@ -0,0 +1,133 @@
+"""Campus behaviour curves — the 'normal patterns' of the digital twin.
+
+Used by BOTH:
+  - the historical seed generator (teaches the anomaly detector what 'normal' is)
+  - the live demo engine (generates realistic real-time data without CCTV hardware)
+
+Everything is deterministic given (zone_type, datetime) plus small noise, so the
+historical baseline and the live twin agree on what a normal campus day looks like.
+"""
+from __future__ import annotations
+
+import math
+import random
+from datetime import datetime
+
+
+def hour_float(dt: datetime) -> float:
+    return dt.hour + dt.minute / 60.0 + dt.second / 3600.0
+
+
+def _peak(h: float, center: float, width: float, height: float) -> float:
+    return height * math.exp(-((h - center) ** 2) / (2 * width ** 2))
+
+
+def crowd_fraction(zone_type: str, h: float, is_weekend: bool = False) -> float:
+    """Fraction of a zone's capacity occupied at hour-of-day `h`."""
+    t = zone_type.upper()
+    if t == "GATE":
+        f = (_peak(h, 8.75, 0.9, 0.80) + _peak(h, 13.0, 0.8, 0.35)
+             + _peak(h, 17.75, 1.1, 0.85) + 0.04)
+    elif t == "CAFETERIA":
+        f = (_peak(h, 8.0, 0.6, 0.75) + _peak(h, 12.75, 0.9, 0.95)
+             + _peak(h, 18.25, 0.8, 0.70) + 0.03)
+    elif t == "LIBRARY":
+        f = 0.30 if 9 <= h <= 21 else 0.06
+    elif t == "SPORTS":
+        f = _peak(h, 17.5, 1.6, 0.45) + 0.05
+    elif t in ("AUDITORIUM", "VENUE"):
+        f = 0.03  # event engine adds attendance on top
+    elif t == "ROAD":
+        f = (_peak(h, 8.75, 1.0, 0.45) + _peak(h, 13.0, 0.9, 0.25)
+             + _peak(h, 17.75, 1.2, 0.50) + 0.05)
+    elif t == "RESTRICTED":
+        f = 0.01
+    elif t == "TRANSPORT":
+        f = _peak(h, 8.75, 0.9, 0.70) + _peak(h, 17.75, 1.0, 0.75) + 0.04
+    elif t == "OPEN_SPACE":
+        f = _peak(h, 13.0, 1.2, 0.20) + _peak(h, 17.0, 1.4, 0.25) + 0.04
+    elif t == "PARKING":
+        f = 0.05
+    else:
+        f = 0.08
+    if is_weekend and t in ("GATE", "CAFETERIA", "LIBRARY", "TRANSPORT", "ROAD"):
+        f *= 0.55
+    return max(0.0, min(1.0, f))
+
+
+def event_attendance_fraction(start_h: float, end_h: float, h: float) -> float:
+    """S-curve attendance for an event running start_h -> end_h (fraction of expected)."""
+    if h < start_h - 0.75 or h > end_h + 0.75:
+        return 0.0
+    if h < start_h:
+        return 0.15 * (h - (start_h - 0.75)) / 0.75          # doors open early
+    if h > end_h:
+        return max(0.0, 0.9 * (1 - (h - end_h) / 0.75))      # dispersal
+    span = max(end_h - start_h, 0.5)
+    x = (h - start_h) / span
+    curve = 0.55 + 0.45 * math.sin(math.pi * min(max(x, 0), 1))  # 0.55 -> 1.0 -> 0.55
+    return 0.2 + 0.8 * curve
+
+
+def parking_occupancy_fraction(h: float, is_weekend: bool = False,
+                               event_today: bool = False) -> float:
+    """Target fraction of parking slots occupied at hour `h`."""
+    if h < 7:
+        f = 0.22
+    elif h < 9:
+        f = 0.22 + (h - 7) / 2 * 0.40
+    elif h < 16:
+        f = 0.62 + _peak(h, 12.5, 2.0, 0.10)
+    elif h < 18:
+        f = 0.88 - (h - 16) / 2 * 0.06
+    elif h < 22:
+        f = 0.80
+    else:
+        f = 0.45
+    if event_today and 16 <= h <= 21:
+        f = min(0.97, f + 0.14)
+    if is_weekend:
+        f *= 0.7
+    return max(0.05, min(0.99, f))
+
+
+def gate_incoming_per_min(h: float, is_weekend: bool = False) -> float:
+    """Base incoming vehicles/minute at a main gate."""
+    f = _peak(h, 8.75, 0.8, 150) + _peak(h, 13.0, 0.8, 55) + _peak(h, 17.75, 1.1, 125) + 12
+    if is_weekend:
+        f *= 0.5
+    return f
+
+
+def gate_outgoing_per_min(h: float, is_weekend: bool = False) -> float:
+    f = _peak(h, 9.25, 0.8, 90) + _peak(h, 13.5, 0.8, 70) + _peak(h, 18.25, 1.1, 140) + 10
+    if is_weekend:
+        f *= 0.5
+    return f
+
+
+def electricity_kw(h: float, campus_load: float = 1.0) -> float:
+    """Campus electricity draw (kW) at hour `h`. campus_load ~ fraction of population."""
+    base = 260 + _peak(h, 12.0, 4.0, 180) + _peak(h, 19.0, 3.0, 220)
+    night = _peak(h, 2.0, 3.0, -120)
+    return max(120.0, (base + night) * (0.75 + 0.45 * campus_load))
+
+
+def water_liters_per_hour(h: float, campus_load: float = 1.0) -> float:
+    return (700 + _peak(h, 12.0, 3.0, 500) + _peak(h, 18.5, 3.0, 600)) * (0.7 + 0.4 * campus_load)
+
+
+def waste_kg_per_hour(h: float, campus_load: float = 1.0) -> float:
+    return (45 + _peak(h, 13.0, 1.5, 60) + _peak(h, 18.0, 2.0, 80)) * (0.7 + 0.5 * campus_load)
+
+
+def transport_trips_per_hour(h: float) -> float:
+    return _peak(h, 8.75, 0.7, 26) + _peak(h, 17.75, 1.0, 32) + 4
+
+
+def temperature_c(h: float, season_offset: float = 0.0) -> float:
+    return 24 + 8 * math.sin((h - 9) / 24 * 2 * math.pi) + season_offset
+
+
+def noise(rng: random.Random, sigma: float) -> float:
+    return rng.gauss(0.0, sigma)
diff --git a/backend/app/ai/engine.py b/backend/app/ai/engine.py
new file mode 100644
index 0000000..478d79f
--- /dev/null
+++ b/backend/app/ai/engine.py
@@ -0,0 +1,932 @@
+"""NEXUS Digital Twin Engine — the living campus simulation + AI pipeline.
+
+Real World  ->  Cameras + Sensors + APIs + Events  ->  AI Data Processing
+            ->  Digital Twin  ->  Pattern Learning  ->  Anomaly Detection
+            ->  Future Prediction  ->  What-If Simulation  ->  AI Recommendations
+
+In DEMO MODE (no CCTV hardware) the engine *is* the sensor network: it generates
+realistic camera detections, crowd counts, vehicle flow, parking occupancy,
+environment and resource data in real time, exactly as the CV pipeline would.
+
+Every tick the engine:
+  1. advances the digital twin state
+  2. persists records (crowd / traffic / parking / environment / resources / metrics)
+  3. runs anomaly detection against learned historical baselines
+  4. runs the prediction engine (crowd growth, parking fill-time, event peaks)
+  5. computes the campus risk score
+  6. raises / resolves smart alerts
+  7. broadcasts the full live snapshot over WebSockets
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+import math
+import random
+import uuid
+from collections import deque
+from datetime import datetime, timedelta
+from typing import Any
+
+from sqlalchemy import func
+from sqlalchemy.orm import Session
+
+from .. import models as m
+from ..config import get_settings
+from ..database import SessionLocal
+from ..ws import manager
+from . import curves
+from .baselines import BaselineLearner, density_from_count, congestion_from_rate, risk_level_from_score
+from .predictor import predict_value, minutes_to_threshold, growth_rate, linear_fit
+from .risk import compute_risk
+
+logger = logging.getLogger("nexus.engine")
+settings = get_settings()
+
+TICK = settings.TICK_SECONDS
+SERIES_MINUTES = 90          # in-memory window used for prediction
+SERIES_MAXLEN = int(SERIES_MINUTES * 60 / TICK) + 10
+
+DEMO_SCENARIOS = {
+    "CROWD_INCREASE", "VEHICLE_INCREASE", "PARKING_SHORTAGE", "EVENT_CROWD",
+    "GATE_CLOSURE", "WEATHER_CHANGE", "RESOURCE_ANOMALY", "CAMERA_OFFLINE", "RESET",
+}
+
+# Alert types (spec section 18)
+AT = {
+    "crowd": "HIGH_CROWD_DENSITY",
+    "movement": "UNUSUAL_CROWD_MOVEMENT",
+    "parking": "PARKING_CAPACITY_PREDICTED",
+    "traffic": "TRAFFIC_CONGESTION_PREDICTED",
+    "restricted": "RESTRICTED_ZONE_ACTIVITY",
+    "resource": "UNUSUAL_RESOURCE_CONSUMPTION",
+    "event": "EVENT_OVERCROWDING_RISK",
+    "camera": "CAMERA_OFFLINE",
+    "env": "ENVIRONMENTAL_RISK",
+    "anomaly": "UNUSUAL_CAMPUS_ACTIVITY",
+}
+
+
+class DigitalTwinEngine:
+    def __init__(self):
+        self.rng = random.Random(42)
+        self.baselines = BaselineLearner()
+        self.started_at: datetime | None = None
+        self.tick_count = 0
+        self._task: asyncio.Task | None = None
+
+        # live state
+        self.zones: dict[int, dict[str, Any]] = {}          # zone_id -> live state
+        self.parking: dict[int, dict[str, Any]] = {}        # parking zone id -> state
+        self.traffic: dict[str, dict[str, Any]] = {}        # gate name -> flow
+        self.environment: dict[str, Any] = {}
+        self.resources: dict[str, float] = {}
+        self.risk: dict[str, Any] = {"score": 8, "level": "NORMAL", "contributors": {}, "reasons": []}
+        self.predictions: list[dict[str, Any]] = []
+        self.anomalies: list[dict[str, Any]] = []
+        self.modifiers: list[dict[str, Any]] = []
+        self.event_state: dict[int, dict[str, Any]] = {}
+
+        # time series: zone_id -> deque of (epoch_min, people)
+        self.crowd_series: dict[int, deque] = {}
+        self.parking_series: dict[int, deque] = {}
+        self.resource_series: dict[str, deque] = {}
+
+    # ------------------------------------------------------------------ setup
+    def load_static(self, db: Session):
+        """Load zones / parking zones / cameras / events from the DB into memory."""
+        for z in db.query(m.Zone).all():
+            self.zones[z.id] = {
+                "zone_id": z.id, "name": z.name, "type": z.type.value,
+                "capacity": z.capacity, "restricted": z.restricted,
+                "x": z.x, "y": z.y, "width": z.width, "height": z.height,
+                "people": 0, "density": "LOW", "growth_rate": 0.0,
+                "vehicles_in": 0, "vehicles_out": 0,
+            }
+            self.crowd_series[z.id] = deque(maxlen=SERIES_MAXLEN)
+        for p in db.query(m.ParkingZone).all():
+            occupied = db.query(func.count(m.ParkingSlot.id)).filter(
+                m.ParkingSlot.zone_id == p.id, m.ParkingSlot.occupied.is_(True)).scalar() or 0
+            self.parking[p.id] = {
+                "id": p.id, "name": p.name, "type": p.type.value,
+                "total_slots": p.total_slots, "occupied": occupied,
+                "x": p.x, "y": p.y, "width": p.width, "height": p.height,
+            }
+            self.parking_series[p.id] = deque(maxlen=SERIES_MAXLEN)
+        gates = [z for z in self.zones.values() if z["type"] == "GATE"]
+        for g in gates:
+            self.traffic[g["name"]] = {"location": g["name"], "incoming": 0, "outgoing": 0,
+                                       "congestion": "LOW"}
+        for e in db.query(m.Event).all():
+            self.event_state[e.id] = {
+                "expected": e.expected_attendance, "current": e.current_crowd,
+                "capacity": e.capacity, "peak": e.predicted_peak,
+                "start": e.start_time, "end": e.end_time,
+            }
+        self._init_environment()
+
+    def _init_environment(self):
+        h = curves.hour_float(datetime.now())
+        self.environment = {
+            "temperature": round(curves.temperature_c(h, season_offset=self.rng.uniform(-2, 2)), 1),
+            "humidity": round(55 + 20 * math.sin((h - 8) / 24 * 2 * math.pi) + self.rng.gauss(0, 3), 1),
+            "condition": "SUNNY" if 6 <= h <= 18 else "CLOUDY",
+            "rain_probability": 10.0 if 6 <= h <= 18 else 25.0,
+            "air_quality": round(45 + self.rng.gauss(0, 8), 1),
+        }
+        self.resource_series = {k: deque(maxlen=SERIES_MAXLEN)
+                                for k in ("ELECTRICITY", "WATER", "WASTE", "TRANSPORT")}
+
+    def refresh_baselines(self, db: Session):
+        self.baselines.learn(db)
+
+    # ------------------------------------------------------------- demo mode
+    def trigger(self, scenario: str, duration_minutes: int = 30, intensity: float = 1.0,
+                params: dict | None = None) -> dict:
+        scenario = scenario.upper()
+        if scenario == "RESET":
+            self.modifiers.clear()
+            db = SessionLocal()
+            try:
+                db.query(m.Camera).update({m.Camera.status: m.CameraStatus.ONLINE,
+                                           m.Camera.ai_status: "RUNNING"})
+                db.commit()
+            finally:
+                db.close()
+            self._init_environment()
+            return {"ok": True, "scenario": "RESET", "message": "All demo scenarios cleared."}
+        if scenario not in DEMO_SCENARIOS:
+            raise ValueError(f"Unknown demo scenario '{scenario}'. Valid: {sorted(DEMO_SCENARIOS)}")
+        until = datetime.now() + timedelta(minutes=duration_minutes)
+        mod = {"id": uuid.uuid4().hex[:8], "scenario": scenario, "until": until,
+               "intensity": intensity, "params": params or {}}
+        self.modifiers = [x for x in self.modifiers if x["scenario"] != scenario]
+        self.modifiers.append(mod)
+        self._apply_immediate(mod)
+        logger.info("DEMO trigger: %s for %d min (intensity %.1f)", scenario, duration_minutes, intensity)
+        return {"ok": True, "scenario": scenario, "active_until": until.isoformat(),
+                "active_modifiers": [x["scenario"] for x in self.modifiers]}
+
+    def _apply_immediate(self, mod: dict):
+        """Side effects that should happen the moment a scenario is triggered."""
+        if mod["scenario"] == "CAMERA_OFFLINE":
+            db = SessionLocal()
+            try:
+                cam = db.query(m.Camera).filter(m.Camera.camera_id == "CAM-005").first()
+                if cam:
+                    cam.status = m.CameraStatus.OFFLINE
+                    cam.ai_status = "ERROR"
+                    db.commit()
+            finally:
+                db.close()
+
+    def _active(self, scenario: str) -> dict | None:
+        now = datetime.now()
+        self.modifiers = [x for x in self.modifiers if x["until"] > now]
+        for x in self.modifiers:
+            if x["scenario"] == scenario:
+                return x
+        return None
+
+    # ------------------------------------------------------------------- loop
+    async def run(self):
+        self.started_at = datetime.now()
+        logger.info("NEXUS digital twin engine started (tick=%.1fs)", TICK)
+        while True:
+            try:
+                self.tick()
+            except Exception:
+                logger.exception("engine tick failed")
+            await asyncio.sleep(TICK)
+
+    def start(self):
+        if self._task is None or self._task.done():
+            self._task = asyncio.create_task(self.run())
+
+    # ------------------------------------------------------------------- tick
+    def tick(self):
+        db = SessionLocal()
+        try:
+            self.tick_count += 1
+            now = datetime.now()
+            h = curves.hour_float(now)
+            weekend = now.weekday() >= 5
+
+            self._update_environment(h)
+            self._update_events(db, now, h, weekend)
+            campus_load = self._update_zones(db, now, h, weekend)
+            self._update_parking(db, now, h, weekend)
+            self._update_traffic(now, h, weekend)
+            self._update_resources(h, campus_load)
+            self._detect_anomalies(now, h)
+            self._update_predictions(now)
+            self._update_risk(now)
+            self._update_alerts(db, now)
+            self._persist(db, now)
+            snapshot = self.snapshot(db, now)
+            db.commit()
+
+            asyncio.get_event_loop().create_task(
+                manager.broadcast({"type": "live", "data": snapshot}))
+            if self.tick_count % 20 == 0:
+                self._cleanup(db, now)
+                db.commit()
+        finally:
+            db.close()
+
+    # ------------------------------------------------------------- state updates
+    def _event_boost(self, zone_type: str, h: float, now: datetime) -> float:
+        """Extra crowd fraction contributed by live events into their venue zone."""
+        boost = 0.0
+        for ev in self.event_state.values():
+            start, end = ev.get("start"), ev.get("end")
+            if not start or not end:
+                continue
+            sh, eh = curves.hour_float(start), curves.hour_float(end)
+            frac = curves.event_attendance_fraction(sh, eh, h)
+            if frac <= 0:
+                continue
+            surge = ev.get("surge", 1.0)
+            # venue mapping: indoor events -> AUDITORIUM, outdoor -> VENUE / OPEN_SPACE
+            if zone_type == "AUDITORIUM" and "ground" not in str(ev.get("venue", "")).lower():
+                boost += frac * (ev["expected"] * surge / 1500.0)
+            elif zone_type in ("VENUE", "OPEN_SPACE"):
+                boost += frac * (ev["expected"] * surge / 1500.0)
+        return boost
+
+    def _update_zones(self, db: Session, now: datetime, h: float, weekend: bool) -> float:
+        epoch_min = now.timestamp() / 60.0
+        event_mod = self._active("EVENT_CROWD")
+        crowd_mod = self._active("CROWD_INCREASE")
+        restricted_hits = 0
+
+        for zid, z in self.zones.items():
+            base_frac = curves.crowd_fraction(z["type"], h, weekend)
+            frac = base_frac + self._event_boost(z["type"], h, now)
+
+            # demo modifiers
+            if crowd_mod and z["type"] in ("VENUE", "OPEN_SPACE", "AUDITORIUM"):
+                frac += 0.45 * crowd_mod["intensity"]
+            if event_mod and z["type"] in ("VENUE", "OPEN_SPACE", "AUDITORIUM"):
+                frac += 0.35 * event_mod["intensity"]
+
+            target = frac * z["capacity"]
+            if z["type"] == "RESTRICTED":
+                target = max(1.0, target)
+                if crowd_mod:
+                    target += 6 * crowd_mod["intensity"]
+                    restricted_hits = 1
+            # smooth approach toward target (digital twin inertia)
+            prev = z["people"]
+            people = prev + (target - prev) * 0.22 + self.rng.gauss(0, max(1.0, target * 0.02))
+            people = max(0, int(round(people)))
+            z["people"] = people
+            z["density"] = density_from_count(people, z["capacity"])
+
+            series = self.crowd_series[zid]
+            series.append((epoch_min, float(people)))
+            recent = [(epoch_min - x, v) for x, v in list(series)[-40:]]  # last ~2 min
+            z["growth_rate"] = growth_rate(recent, window_minutes=10.0)
+
+            # vehicle flow for gates / roads / parking approaches
+            if z["type"] == "GATE":
+                z["vehicles_in"] = max(0, int(self.traffic.get(z["name"], {}).get("incoming", 0)))
+                z["vehicles_out"] = max(0, int(self.traffic.get(z["name"], {}).get("outgoing", 0)))
+            else:
+                z["vehicles_in"] = max(0, int(people * 0.02))
+                z["vehicles_out"] = max(0, int(people * 0.015))
+
+        self._restricted_hits = restricted_hits
+        total = sum(z["people"] for z in self.zones.values())
+        return min(1.0, total / 9000.0)
+
+    def _update_events(self, db: Session, now: datetime, h: float, weekend: bool):
+        event_mod = self._active("EVENT_CROWD")
+        for row in db.query(m.Event).all():
+            st = self.event_state.get(row.id)
+            if not st or not st["start"] or not st["end"]:
+                continue
+            sh, eh = curves.hour_float(st["start"]), curves.hour_float(st["end"])
+            # surge factor from the demo EVENT_CROWD modifier (never compounds:
+            # the baseline expected attendance in st["expected"] stays untouched)
+            surge = (1.0 + 0.6 * event_mod["intensity"]) if event_mod else 1.0
+            st["surge"] = surge
+            frac = curves.event_attendance_fraction(sh, eh, h)
+            target = int(st["expected"] * surge * frac)
+            cur = st["current"] + (target - st["current"]) * 0.25 + self.rng.gauss(0, 6)
+            st["current"] = max(0, int(cur))
+            # predict peak from recent growth
+            st["peak"] = max(st["current"] + int(max(frac, 0.05) * st["expected"] * surge * 0.25),
+                             int(st["expected"] * surge * 0.9))
+            row.current_crowd = st["current"]
+            row.predicted_peak = st["peak"]
+            if now < st["start"]:
+                row.status = m.EventStatus.SCHEDULED
+            elif now > st["end"]:
+                row.status = m.EventStatus.ENDED
+            else:
+                row.status = m.EventStatus.LIVE
+            occ = st["current"] / max(st["capacity"], 1)
+            row.risk_level = (m.RiskLevel.CRITICAL if st["peak"] > st["capacity"] * 1.05
+                              else m.RiskLevel.ELEVATED if occ > 0.8
+                              else m.RiskLevel.MODERATE if occ > 0.5 else m.RiskLevel.NORMAL)
+
+    def _update_parking(self, db: Session, now: datetime, h: float, weekend: bool):
+        epoch_min = now.timestamp() / 60.0
+        event_today = any(e["start"] and e["start"].date() == now.date()
+                          for e in self.event_state.values())
+        shortage = self._active("PARKING_SHORTAGE")
+        surge = self._active("VEHICLE_INCREASE")
+        rows = {p.id: p for p in db.query(m.ParkingZone).all()}
+
+        for pid, p in self.parking.items():
+            target_frac = curves.parking_occupancy_fraction(h, weekend, event_today)
+            if shortage:
+                target_frac = min(0.98, target_frac + 0.25 * shortage["intensity"])
+            if surge:
+                target_frac = min(0.99, target_frac * (1 + 0.15 * surge["intensity"]))
+            target = target_frac * p["total_slots"]
+            prev = p["occupied"]
+            occ = prev + (target - prev) * 0.18 + self.rng.gauss(0, 1.2)
+            p["occupied"] = int(max(0, min(p["total_slots"], round(occ))))
+            self.parking_series[pid].append((epoch_min, float(p["occupied"])))
+            # persist slot flips (every tick is fine — only the delta changes)
+            delta = p["occupied"] - prev
+            if delta != 0 and pid in rows:
+                self._flip_slots(db, rows[pid], delta)
+
+    def _flip_slots(self, db: Session, zone: m.ParkingZone, delta: int):
+        if delta > 0:
+            slots = db.query(m.ParkingSlot).filter(
+                m.ParkingSlot.zone_id == zone.id, m.ParkingSlot.occupied.is_(False)
+            ).limit(delta).all()
+            for s in slots:
+                s.occupied = True
+                s.vehicle_type = "BIKE" if zone.type == m.ParkingType.TWO_WHEELER else \
+                    self.rng.choice(["CAR", "CAR", "CAR", "BIKE"])
+        elif delta < 0:
+            slots = db.query(m.ParkingSlot).filter(
+                m.ParkingSlot.zone_id == zone.id, m.ParkingSlot.occupied.is_(True)
+            ).limit(-delta).all()
+            for s in slots:
+                s.occupied = False
+
+    def _update_traffic(self, now: datetime, h: float, weekend: bool):
+        gate_mod = self._active("GATE_CLOSURE")
+        surge = self._active("VEHICLE_INCREASE")
+        sh, eh = 16.5, 17.75
+        event_arrival = 0.0
+        for ev in self.event_state.values():
+            if ev.get("start") and curves.event_attendance_fraction(
+                    curves.hour_float(ev["start"]), curves.hour_float(ev["end"]), h) > 0:
+                event_arrival = curves._peak(h, sh, 0.6, 55)
+        names = list(self.traffic.keys())
+        for i, name in enumerate(names):
+            t = self.traffic[name]
+            base_in = curves.gate_incoming_per_min(h, weekend)
+            base_out = curves.gate_outgoing_per_min(h, weekend)
+            scale = [1.0, 0.65, 0.75][i % 3]
+            incoming = (base_in + event_arrival) * scale
+            outgoing = base_out * scale
+            if gate_mod:
+                closed_gate = gate_mod["params"].get("gate", names[0])
+                if closed_gate.lower() in name.lower():
+                    incoming, outgoing = 0.0, 0.0
+                else:
+                    incoming *= 1.45
+                    outgoing *= 1.2
+            if surge:
+                incoming *= (1 + 0.5 * surge["intensity"])
+                outgoing *= (1 + 0.3 * surge["intensity"])
+            t["incoming"] = max(0, int(incoming + self.rng.gauss(0, 6)))
+            t["outgoing"] = max(0, int(outgoing + self.rng.gauss(0, 5)))
+            t["congestion"] = congestion_from_rate(t["incoming"])
+
+    def _update_environment(self, h: float):
+        e = self.environment
+        e["temperature"] = round(curves.temperature_c(h) + self.rng.gauss(0, 0.15), 1)
+        e["humidity"] = round(max(15, min(95, e["humidity"] + self.rng.gauss(0, 0.4))), 1)
+        e["air_quality"] = round(max(10, e["air_quality"] + self.rng.gauss(0, 1.0)), 1)
+        weather_mod = self._active("WEATHER_CHANGE")
+        if weather_mod:
+            cond = weather_mod["params"].get("condition", "HEAVY_RAIN")
+            e["condition"] = cond
+            e["rain_probability"] = min(99.0, e["rain_probability"] + 8)
+            e["temperature"] = round(e["temperature"] - 4 * weather_mod["intensity"], 1)
+        else:
+            # natural slow drift
+            if e["rain_probability"] > 15 and self.rng.random() < 0.02:
+                e["condition"] = "RAIN"
+            elif e["condition"] == "RAIN" and self.rng.random() < 0.05:
+                e["condition"] = "CLOUDY"
+            e["rain_probability"] = max(5.0, e["rain_probability"] - 0.4)
+            if e["condition"] == "RAIN" and e["rain_probability"] < 30:
+                e["condition"] = "SUNNY" if h > 7 else "CLOUDY"
+
+    def _update_resources(self, h: float, campus_load: float):
+        res_mod = self._active("RESOURCE_ANOMALY")
+        mult = (1.35 * res_mod["intensity"]) if res_mod else 1.0
+        epoch_min = datetime.now().timestamp() / 60.0
+        values = {
+            "ELECTRICITY": curves.electricity_kw(h, campus_load) * mult,
+            "WATER": curves.water_liters_per_hour(h, campus_load),
+            "WASTE": curves.waste_kg_per_hour(h, campus_load),
+            "TRANSPORT": curves.transport_trips_per_hour(h),
+        }
+        for k, v in values.items():
+            self.resources[k] = round(v + self.rng.gauss(0, v * 0.02), 1)
+            self.resource_series[k].append((epoch_min, float(self.resources[k])))
+
+    # ------------------------------------------------------------ AI: anomalies
+    def _detect_anomalies(self, now: datetime, h: float):
+        found: list[dict[str, Any]] = []
+        for zid, z in self.zones.items():
+            is_anom, stats = self.baselines.is_crowd_anomaly(zid, now.hour, z["people"])
+            if is_anom:
+                found.append({
+                    "id": f"crowd-{zid}-{now.timestamp():.0f}",
+                    "type": "UNUSUAL_CROWD",
+                    "location": z["name"],
+                    "severity": "HIGH" if stats["z"] > 3.5 else "MEDIUM",
+                    "current_value": z["people"],
+                    "normal_range": [round(stats["lower"]), round(stats["upper"])],
+                    "explanation": (
+                        f"Normal crowd at {z['name']} around {now.hour:02d}:00 is "
+                        f"{stats['mean']:.0f} ± {stats['std']:.0f} (range "
+                        f"{stats['lower']:.0f}-{stats['upper']:.0f}). "
+                        f"Current: {z['people']} (z-score {stats['z']:.1f})."
+                    ),
+                    "detected_at": now,
+                })
+        # parking vs hourly normal range
+        plow, phigh = self.baselines.parking_range(now.hour)
+        avg_occ = self._avg_parking_pct()
+        if avg_occ > phigh * 1.15:
+            found.append({
+                "id": f"parking-{now.timestamp():.0f}",
+                "type": "PARKING_PRESSURE",
+                "location": "Campus Parking",
+                "severity": "HIGH" if avg_occ > 95 else "MEDIUM",
+                "current_value": round(avg_occ, 1),
+                "normal_range": [round(plow), round(phigh)],
+                "explanation": (
+                    f"Normal parking occupancy at {now.hour:02d}:00 is {plow:.0f}–{phigh:.0f}%. "
+                    f"Current average: {avg_occ:.0f}%. Parking occupancy is significantly "
+                    f"above the normal historical range."
+                ),
+                "detected_at": now,
+            })
+        # resources
+        for rtype in ("ELECTRICITY", "WATER", "WASTE"):
+            is_anom, stats = self.baselines.is_resource_anomaly(
+                rtype, self.resources.get(rtype, 0), now.hour)
+            if is_anom:
+                found.append({
+                    "id": f"res-{rtype}-{now.timestamp():.0f}",
+                    "type": "RESOURCE_ANOMALY",
+                    "location": "Campus " + rtype.title(),
+                    "severity": "MEDIUM",
+                    "current_value": self.resources.get(rtype, 0),
+                    "normal_range": [round(stats["mean"] - 2 * stats["std"]),
+                                     round(max(stats["p95"], stats["mean"] + 2 * stats["std"]))],
+                    "explanation": (
+                        f"Normal {rtype.lower()} usage around {now.hour:02d}:00 is "
+                        f"{stats['mean']:.0f} ± {stats['std']:.0f}. Current: "
+                        f"{self.resources.get(rtype, 0):.0f} — consumption anomaly detected. "
+                        f"Possible explanation: large event + extended operating hours."
+                    ),
+                    "detected_at": now,
+                })
+        self.anomalies = found
+
+    # ---------------------------------------------------------- AI: predictions
+    def _update_predictions(self, now: datetime):
+        epoch_min = now.timestamp() / 60.0
+        preds: list[dict[str, Any]] = []
+
+        # crowd per zone (+20 / +30 min); flow zones are covered by traffic predictions
+        for zid, z in self.zones.items():
+            if z["type"] in ("GATE", "ROAD", "TRANSPORT"):
+                continue
+            series = [(epoch_min - x, v) for x, v in self.crowd_series.get(zid, [])]
+            window = [p for p in series if 0 <= p[0] <= 30]

+import { useOutletContext } from 'react-router-dom'
+import type { Snapshot } from '../lib/types'
+import { Car, Bike, Users, Clock, AlertTriangle } from 'lucide-react'
+import { fmt } from '../lib/ui'
+
+interface Ctx { snapshot: Snapshot | null }
+
+const TYPE_ICONS: Record<string, string> = {
+  TWO_WHEELER: '🛵',
+  STUDENT: '🎓',
+  FACULTY: '👔',
+  VISITOR: '🅿️',
+  FOUR_WHEELER: '🚗',
+}
+
+export default function Parking() {
+  const { snapshot } = useOutletContext<Ctx>()
+  if (!snapshot) return <div className="text-nexus-muted">Loading…</div>
+
+  const parking = [...snapshot.parking].sort((a, b) => b.occupancy_pct - a.occupancy_pct)
+  const totalSlots = parking.reduce((s, p) => s + p.total_slots, 0)
+  const totalOcc = parking.reduce((s, p) => s + p.occupied, 0)
+  const avg = (100 * totalOcc) / Math.max(totalSlots, 1)
+  const fillingFirst = parking.filter((p) => p.predicted_full_minutes != null)
+    .sort((a, b) => (a.predicted_full_minutes ?? 9999) - (b.predicted_full_minutes ?? 9999))[0]
+
+  return (
+    <div className="space-y-6">
+      <h1 className="text-xl font-bold flex items-center gap-2"><Car size={20} className="text-nexus-accent" /> Smart Parking Intelligence</h1>
+
+      <div className="grid grid-cols-2 md:grid-cols-4 gap-3">
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase tracking-wider text-nexus-muted">Campus occupancy</div>
+          <div className="text-3xl font-bold font-mono mt-1">{avg.toFixed(0)}%</div>
+        </div>
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase tracking-wider text-nexus-muted">Occupied</div>
+          <div className="text-3xl font-bold font-mono mt-1">{fmt(totalOcc)}</div>
+        </div>
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase tracking-wider text-nexus-muted">Available</div>
+          <div className="text-3xl font-bold font-mono mt-1 text-nexus-green">{fmt(totalSlots - totalOcc)}</div>
+        </div>
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase tracking-wider text-nexus-muted">Filling first</div>
+          <div className="text-lg font-bold mt-1 flex items-center gap-2">
+            <Clock size={16} className="text-nexus-orange" />
+            {fillingFirst ? `${fillingFirst.name} ~${fillingFirst.predicted_full_minutes}m` : '—'}
+          </div>
+        </div>
+      </div>
+
+      <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
+        {parking.map((p) => (
+          <div key={p.id} className="glass rounded-xl border border-nexus-border p-5">
+            <div className="flex items-center justify-between mb-2">
+              <h3 className="font-semibold flex items-center gap-2">
+                <span>{TYPE_ICONS[p.type] || '🚗'}</span> {p.name}
+              </h3>
+              <span className="text-xs text-nexus-muted">{p.type.replace(/_/g, ' ')}</span>
+            </div>
+            <div className="flex items-end justify-between mb-2">
+              <div className="font-mono text-4xl font-bold">{p.occupancy_pct.toFixed(0)}<span className="text-lg text-nexus-muted">%</span></div>
+              <div className="text-right text-xs text-nexus-muted">
+                <div><Users size={10} className="inline mr-1" />{fmt(p.occupied)} vehicles</div>
+                <div>{fmt(p.available)} slots free</div>
+              </div>
+            </div>
+            <div className="h-3 rounded-full bg-nexus-border overflow-hidden">
+              <div className={`h-full rounded-full transition-all ${barColor(p.occupancy_pct)}`} style={{ width: `${Math.min(100, p.occupancy_pct)}%` }}></div>
+            </div>
+            <div className="mt-2 text-xs">
+              {p.occupancy_pct >= 95
+                ? <span className="text-nexus-red flex items-center gap-1"><AlertTriangle size={12} /> At capacity — redirect incoming vehicles</span>
+                : p.predicted_full_minutes != null && p.predicted_full_minutes <= 30
+                  ? <span className="text-nexus-orange flex items-center gap-1"><Clock size={12} /> AI: likely to reach capacity within {p.predicted_full_minutes} minutes</span>
+                  : <span className="text-nexus-muted">Operating within normal range</span>}
+            </div>
+            {/* slot grid */}
+            <div className="mt-3 grid grid-cols-10 gap-1">
+              {Array.from({ length: 20 }).map((_, i) => {
+                const occupied = i < Math.round((p.occupancy_pct / 100) * 20)
+                return <div key={i} className={`h-2 rounded-sm ${occupied ? barColor(p.occupancy_pct) : 'bg-nexus-border'}`} />
+              })}
+            </div>
+          </div>
+        ))}
+      </div>
+
+      {/* AI parking prediction table */}
+      <div className="glass rounded-xl border border-nexus-border p-4">
+        <h3 className="text-sm font-semibold mb-3">AI Parking Predictions</h3>
+        <table className="w-full text-sm">
+          <thead>
+            <tr className="text-left text-xs uppercase tracking-wider text-nexus-muted border-b border-nexus-border">
+              <th className="py-2 pr-4">Zone</th>
+              <th className="py-2 pr-4 text-right">Occupancy</th>
+              <th className="py-2 pr-4 text-right">Free slots</th>
+              <th className="py-2 pr-4 text-right">Predicted full in</th>
+              <th className="py-2">AI recommendation</th>
+            </tr>
+          </thead>
+          <tbody>
+            {parking.map((p) => (
+              <tr key={p.id} className="border-b border-nexus-border/50">
+                <td className="py-2.5 pr-4 font-medium">{p.name}</td>
+                <td className="py-2.5 pr-4 text-right font-mono">{p.occupancy_pct.toFixed(0)}%</td>
+                <td className="py-2.5 pr-4 text-right font-mono">{p.available}</td>
+                <td className="py-2.5 pr-4 text-right font-mono">
+                  {p.predicted_full_minutes != null ? `~${p.predicted_full_minutes} min` : '> 45 min'}
+                </td>
+                <td className="py-2.5 text-xs text-nexus-muted">
+                  {p.predicted_full_minutes != null && p.predicted_full_minutes <= 30
+                    ? `Redirect incoming vehicles toward zones with available space; open overflow parking.`
+                    : p.occupancy_pct >= 95
+                      ? 'Zone at capacity — activate dynamic signage and shuttle service.'
+                      : 'No action required.'}
+                </td>
+              </tr>
+            ))}
+          </tbody>
+        </table>
+      </div>
+    </div>
+  )
+}
+
+function barColor(pct: number) {
+  if (pct >= 95) return 'bg-nexus-red'
+  if (pct >= 80) return 'bg-nexus-orange'
+  if (pct >= 55) return 'bg-nexus-yellow'
+  return 'bg-nexus-green'
+}

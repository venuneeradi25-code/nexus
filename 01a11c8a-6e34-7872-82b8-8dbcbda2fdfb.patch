+"""Smart alert system."""
+from datetime import datetime
+
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+
+from .. import models as m
+from ..database import get_db
+from ..dependencies import AnyAdmin, get_current_user
+from ..models import User
+from ..schemas import AlertOut
+
+router = APIRouter(prefix="/api/alerts", tags=["alerts"])
+
+
+@router.get("", response_model=list[AlertOut])
+def list_alerts(status: str = "ACTIVE", limit: int = 100, db: Session = Depends(get_db),
+                user: User = Depends(get_current_user)):
+    q = db.query(m.Alert).order_by(m.Alert.id.desc())
+    if status != "ALL":
+        try:
+            q = q.filter(m.Alert.status == m.AlertStatus(status.upper()))
+        except ValueError:
+            pass
+    rows = q.limit(limit).all()
+    return [AlertOut.model_validate(a) for a in rows]
+
+
+@router.post("/{alert_id}/acknowledge", response_model=AlertOut)
+def acknowledge(alert_id: int, db: Session = Depends(get_db),
+                user: User = Depends(AnyAdmin)):
+    alert = db.query(m.Alert).filter(m.Alert.id == alert_id).first()
+    if not alert:
+        raise HTTPException(404, "Alert not found")
+    alert.status = m.AlertStatus.ACKNOWLEDGED
+    alert.acknowledged_by = user.username
+    db.commit()
+    db.refresh(alert)
+    return AlertOut.model_validate(alert)
+
+
+@router.post("/{alert_id}/resolve", response_model=AlertOut)
+def resolve(alert_id: int, db: Session = Depends(get_db), user: User = Depends(AnyAdmin)):
+    alert = db.query(m.Alert).filter(m.Alert.id == alert_id).first()
+    if not alert:
+        raise HTTPException(404, "Alert not found")
+    alert.status = m.AlertStatus.RESOLVED
+    alert.resolved_at = datetime.now()
+    db.commit()
+    db.refresh(alert)
+    return AlertOut.model_validate(alert)
+
+
+@router.get("/stats/summary")
+def alert_stats(db: Session = Depends(get_db), user: User = Depends(get_current_user)):
+    from sqlalchemy import func
+    rows = (db.query(m.Alert.alert_type, m.Alert.status, func.count(m.Alert.id))
+            .group_by(m.Alert.alert_type, m.Alert.status).all())
+    return {"by_type_status": [{"alert_type": r[0], "status": r[1].value, "count": r[2]}
+                               for r in rows],
+            "active": db.query(func.count(m.Alert.id)).filter(
+                m.Alert.status == m.AlertStatus.ACTIVE).scalar() or 0}

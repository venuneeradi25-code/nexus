+import { useState } from 'react'
+import api from '../lib/api'
+import { FlaskConical, Play, ArrowRight, Lightbulb, TrendingUp, Car, Users, CloudRain, AlertTriangle } from 'lucide-react'
+import { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer, CartesianGrid, Legend } from 'recharts'
+import { cn } from '../lib/ui'
+
+interface ScenarioDef {
+  id: string
+  title: string
+  description: string
+  icon: any
+  params: { key: string; label: string; type: 'text' | 'number' | 'select'; default: any; options?: string[]; min?: number; max?: number; step?: number }[]
+}
+
+const SCENARIOS: ScenarioDef[] = [
+  {
+    id: 'GATE_CLOSURE', title: 'Gate Closure', icon: AlertTriangle,
+    description: 'What happens if a campus gate is closed? Traffic is redistributed to the remaining gates.',
+    params: [{ key: 'gate', label: 'Gate to close', type: 'select', default: 'Main Gate', options: ['Main Gate', 'North Gate', 'East Gate'] }],
+  },
+  {
+    id: 'EVENT_CROWD', title: 'Event Crowd Surge', icon: Users,
+    description: 'What happens if an event attracts more people than expected?',
+    params: [
+      { key: 'event', label: 'Event', type: 'select', default: 'TECHNOVA 2026', options: ['TECHNOVA 2026', 'Research Symposium'] },
+      { key: 'multiplier', label: 'Attendance multiplier (×)', type: 'number', default: 2, min: 0.5, max: 3, step: 0.1 },
+      { key: 'extra_people', label: 'Extra people', type: 'number', default: 0, min: 0, max: 3000, step: 50 },
+    ],
+  },
+  {
+    id: 'PARKING_UNAVAILABLE', title: 'Parking Zone Down', icon: Car,
+    description: 'What happens if a parking zone becomes unavailable? Demand is redistributed.',
+    params: [{ key: 'zone', label: 'Zone', type: 'select', default: 'Parking Zone A', options: ['Parking Zone A', 'Parking Zone B', 'Parking Zone C', 'Parking Zone D', 'Parking Zone E'] }],
+  },
+  {
+    id: 'EVENT_EXTENSION', title: 'Event Extension', icon: TrendingUp,
+    description: 'What happens if the event is extended by extra hours?',
+    params: [{ key: 'hours', label: 'Extension (hours)', type: 'number', default: 2, min: 1, max: 6, step: 0.5 }],
+  },
+  {
+    id: 'VEHICLE_SURGE', title: 'Vehicle Surge', icon: Car,
+    description: 'What happens if significantly more vehicles arrive than usual?',
+    params: [{ key: 'percent', label: 'Extra arrivals (%)', type: 'number', default: 30, min: 5, max: 100, step: 5 }],
+  },
+  {
+    id: 'WEATHER_CHANGE', title: 'Weather Change', icon: CloudRain,
+    description: 'What happens if the weather changes during an outdoor event?',
+    params: [{ key: 'condition', label: 'Condition', type: 'select', default: 'HEAVY_RAIN', options: ['SUNNY', 'CLOUDY', 'RAIN', 'HEAVY_RAIN', 'STORM'] }],
+  },
+]
+
+interface SimResult {
+  id: number
+  scenario: string
+  title: string
+  parameters: Record<string, any>
+  current: any
+  simulated: any
+  impact: Record<string, any>
+  risk_score_before: number
+  risk_score_after: number
+  recommendations: string[]
+  created_at: string
+}
+
+export default function Simulator() {
+  const [selected, setSelected] = useState<ScenarioDef>(SCENARIOS[0])
+  const [params, setParams] = useState<Record<string, any>>({ gate: 'Main Gate' })
+  const [result, setResult] = useState<SimResult | null>(null)
+  const [running, setRunning] = useState(false)
+  const [history, setHistory] = useState<SimResult[]>([])
+
+  const run = async () => {
+    setRunning(true)
+    setResult(null)
+    try {
+      const res = await api.post('/simulations/run', { scenario: selected.id, parameters: params })
+      setResult(res.data)
+      setHistory((h) => [res.data, ...h].slice(0, 10))
+    } catch (e: any) {
+      alert('Simulation failed: ' + (e.response?.data?.detail || e.message))
+    } finally {
+      setRunning(false)
+    }
+  }
+
+  // chart data: traffic comparison for GATE_CLOSURE, parking for PARKING_UNAVAILABLE, event for EVENT_CROWD
+  const chartData = (() => {
+    if (!result) return []
+    if (result.scenario === 'GATE_CLOSURE') {
+      const cur = result.current.traffic || []
+      const sim = result.simulated.traffic || []
+      return cur.map((c: any, i: number) => ({
+        name: c.location.replace(' Gate', ''),
+        current: c.incoming,
+        simulated: sim[i]?.incoming ?? 0,
+      }))
+    }
+    if (result.scenario === 'PARKING_UNAVAILABLE') {
+      const cur = result.current.parking || []
+      const sim = result.simulated.parking || []
+      return cur.map((c: any, i: number) => ({
+        name: c.name.replace('Parking Zone ', 'Z'),
+        current: Math.round(c.occupancy_pct),
+        simulated: Math.round(sim[i]?.occupancy_pct ?? 0),
+      }))
+    }
+    if (result.scenario === 'EVENT_CROWD') {
+      const c = result.current
+      const s = result.simulated
+      return [
+        { name: 'Expected', current: c.expected_attendance, simulated: s.expected_attendance },
+        { name: 'Predicted peak', current: c.predicted_peak, simulated: s.predicted_peak },
+        { name: 'Capacity', current: s.capacity, simulated: s.capacity },
+      ]
+    }
+    if (result.scenario === 'VEHICLE_SURGE') {
+      const cur = result.current.traffic || []
+      const sim = result.simulated.traffic || []
+      return cur.map((c: any, i: number) => ({ name: c.location.replace(' Gate', ''), current: c.incoming, simulated: sim[i]?.incoming ?? 0 }))
+    }
+    return []
+  })()
+
+  return (
+    <div className="space-y-6">
+      <h1 className="text-xl font-bold flex items-center gap-2"><FlaskConical size={20} className="text-nexus-accent" /> WHAT-IF Simulator</h1>
+      <p className="text-sm text-nexus-muted -mt-3">
+        Ask “What happens if…?” and let the digital twin simulate the scenario before you take real-world action.
+      </p>
+
+      <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
+        {/* controls */}
+        <div className="space-y-4">
+          <div className="glass rounded-xl border border-nexus-border p-4">
+            <h3 className="text-sm font-semibold mb-3">1 · Choose a scenario</h3>
+            <div className="space-y-2">
+              {SCENARIOS.map((s) => (
+                <button
+                  key={s.id} onClick={() => { setSelected(s); setParams(Object.fromEntries(s.params.map((p) => [p.key, p.default]))); setResult(null) }}
+                  className={cn('w-full text-left rounded-lg border p-3 transition-colors',
+                    selected.id === s.id ? 'border-nexus-accent bg-nexus-accent/10' : 'border-nexus-border hover:border-nexus-accent/40')}
+                >
+                  <div className="flex items-center gap-2 font-semibold text-sm">
+                    <s.icon size={15} className="text-nexus-accent" /> {s.title}
+                  </div>
+                  <div className="text-[11px] text-nexus-muted mt-1">{s.description}</div>
+                </button>
+              ))}
+            </div>
+          </div>
+
+          <div className="glass rounded-xl border border-nexus-border p-4">
+            <h3 className="text-sm font-semibold mb-3">2 · Set parameters</h3>
+            <div className="space-y-3">
+              {selected.params.map((p) => (
+                <div key={p.key}>
+                  <label className="text-xs uppercase tracking-wider text-nexus-muted">{p.label}</label>
+                  {p.type === 'select' ? (
+                    <select value={params[p.key] ?? p.default}
+                      onChange={(e) => setParams({ ...params, [p.key]: e.target.value })}
+                      className="mt-1 w-full rounded-lg border border-nexus-border bg-nexus-panel px-3 py-2 text-sm">
+                      {p.options!.map((o) => <option key={o} value={o}>{o}</option>)}
+                    </select>
+                  ) : (
+                    <input type="number" value={params[p.key] ?? p.default}
+                      min={p.min} max={p.max} step={p.step}
+                      onChange={(e) => setParams({ ...params, [p.key]: Number(e.target.value) })}
+                      className="mt-1 w-full rounded-lg border border-nexus-border bg-nexus-panel px-3 py-2 text-sm font-mono" />
+                  )}
+                </div>
+              ))}
+            </div>
+            <button
+              onClick={run} disabled={running}
+              className="mt-4 w-full flex items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-nexus-accent to-nexus-accent2 py-2.5 text-sm font-semibold text-white hover:opacity-90 disabled:opacity-50"
+            >
+              <Play size={14} /> {running ? 'Simulating…' : '3 · Run Simulation'}
+            </button>
+          </div>
+        </div>
+
+        {/* results */}
+        <div className="lg:col-span-2 space-y-4">
+          {!result && (
+            <div className="glass rounded-xl border border-nexus-border p-10 text-center text-nexus-muted h-full flex flex-col items-center justify-center">
+              <FlaskConical size={36} className="mb-3 opacity-50" />
+              <div className="font-semibold text-nexus-text">No simulation run yet</div>
+              <div className="text-sm">Pick a scenario and press “Run Simulation” to compare REAL CAMPUS vs SIMULATED FUTURE.</div>
+            </div>
+          )}
+
+          {result && (
+            <>
+              <div className="glass rounded-xl border border-nexus-border p-5">
+                <div className="flex items-center justify-between mb-4">
+                  <div>
+                    <div className="text-[10px] uppercase tracking-wider text-nexus-muted">Simulation result</div>
+                    <div className="font-semibold">{result.title}</div>
+                  </div>
+                  <div className="flex items-center gap-2 text-sm">
+                    <span className="text-nexus-muted">Risk score</span>
+                    <span className="font-mono font-bold">{Math.round(result.risk_score_before)}</span>
+                    <ArrowRight size={14} className="text-nexus-muted" />
+                    <span className={`font-mono font-bold ${result.risk_score_after > result.risk_score_before ? 'text-nexus-red' : 'text-nexus-green'}`}>
+                      {Math.round(result.risk_score_after)}
+                    </span>
+                    <span className="text-xs text-nexus-muted">/100</span>
+                  </div>
+                </div>
+
+                {chartData.length > 0 && (
+                  <div className="h-56 mb-4">
+                    <ResponsiveContainer width="100%" height="100%">
+                      <BarChart data={chartData}>
+                        <CartesianGrid strokeDasharray="3 3" />
+                        <XAxis dataKey="name" tick={{ fontSize: 11 }} />
+                        <YAxis tick={{ fontSize: 10 }} />
+                        <Tooltip contentStyle={{ background: '#0d1424', border: '1px solid #1e2a45', fontSize: 12 }} />
+                        <Legend />
+                        <Bar dataKey="current" fill="#38bdf8" name="CURRENT REALITY" radius={[4, 4, 0, 0]} />
+                        <Bar dataKey="simulated" fill="#f87171" name="SIMULATED FUTURE" radius={[4, 4, 0, 0]} />
+                      </BarChart>
+                    </ResponsiveContainer>
+                  </div>
+                )}
+
+                {/* impact grid */}
+                <div className="grid grid-cols-2 md:grid-cols-3 gap-2 mb-4">
+                  {Object.entries(result.impact).map(([k, v]) => (
+                    <div key={k} className="rounded-lg border border-nexus-border p-3">
+                      <div className="text-[10px] uppercase text-nexus-muted">{k.replace(/_/g, ' ')}</div>
+                      <div className="text-xs mt-1">{typeof v === 'object' ? JSON.stringify(v) : String(v)}</div>
+                    </div>
+                  ))}
+                </div>
+
+                {/* recommendations */}
+                <div className="rounded-lg border border-nexus-green/30 bg-nexus-green/5 p-4">
+                  <div className="text-xs font-semibold uppercase tracking-wider text-nexus-green mb-2 flex items-center gap-1">
+                    <Lightbulb size={12} /> AI Recommended Strategy
+                  </div>
+                  <ul className="space-y-1.5 text-sm">
+                    {result.recommendations.map((r, i) => (
+                      <li key={i} className="flex items-start gap-2">
+                        <span className="text-nexus-green mt-0.5">▸</span>
+                        <span>{r}</span>
+                      </li>
+                    ))}
+                  </ul>
+                </div>
+              </div>
+
+              {/* raw simulated state */}
+              <div className="glass rounded-xl border border-nexus-border p-4">
+                <h3 className="text-sm font-semibold mb-2">Simulated future state</h3>
+                <pre className="text-[11px] font-mono text-nexus-muted overflow-x-auto max-h-64 overflow-y-auto bg-black/30 rounded-lg p-3">
+                  {JSON.stringify(result.simulated, null, 2)}
+                </pre>
+              </div>
+            </>
+          )}
+
+          {history.length > 0 && (
+            <div className="glass rounded-xl border border-nexus-border p-4">
+              <h3 className="text-sm font-semibold mb-3">Simulation history</h3>
+              <div className="space-y-1.5">
+                {history.map((h) => (
+                  <button key={h.id} onClick={() => setResult(h)}
+                    className="w-full flex items-center justify-between rounded-lg border border-nexus-border px-3 py-2 text-xs hover:border-nexus-accent/40">
+                    <span className="font-semibold">{h.title}</span>
+                    <span className="font-mono text-nexus-muted">
+                      risk {Math.round(h.risk_score_before)} → {Math.round(h.risk_score_after)} · {new Date(h.created_at).toLocaleTimeString()}
+                    </span>
+                  </button>
+                ))}
+              </div>
+            </div>
+          )}
+        </div>
+      </div>
+    </div>
+  )
+}
diff --git a/frontend/src/store/auth.tsx b/frontend/src/store/auth.tsx
new file mode 100644

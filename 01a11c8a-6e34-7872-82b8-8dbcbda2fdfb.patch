+"""Admin: user management, privacy settings, daily AI report, system info."""
+from datetime import datetime, timedelta
+
+from fastapi import APIRouter, Depends, HTTPException
+from sqlalchemy.orm import Session
+
+from .. import models as m
+from ..ai.engine import engine
+from ..ai.report import generate_daily_report
+from ..database import get_db
+from ..dependencies import SuperAdmin, get_current_user
+from ..models import Role, User
+from ..schemas import DailyReport, PrivacySettings, PrivacySettingsUpdate, UserCreate, UserOut
+from ..security import hash_password
+
+router = APIRouter(prefix="/api/admin", tags=["admin"])
+
+# In-memory privacy settings (persisted to a key-value table in production)
+PRIVACY_DEFAULTS = {
+    "anonymous_analytics_only": True,
+    "facial_recognition_enabled": False,
+    "data_retention_days": 90,
+    "store_video_footage": False,
+    "share_data_with_third_parties": False,
+}
+_privacy = dict(PRIVACY_DEFAULTS)
+
+
+@router.get("/users", response_model=list[UserOut])
+def users(db: Session = Depends(get_db), user: User = Depends(SuperAdmin)):
+    return [UserOut.model_validate(u) for u in db.query(m.User).all()]
+
+
+@router.post("/users", response_model=UserOut, status_code=201)
+def create_user(req: UserCreate, db: Session = Depends(get_db),
+                user: User = Depends(SuperAdmin)):
+    if db.query(m.User).filter((m.User.username == req.username)
+                               | (m.User.email == req.email)).first():
+        raise HTTPException(400, "Username or email already exists")
+    u = m.User(username=req.username, email=req.email,
+               hashed_password=hash_password(req.password), role=req.role)
+    db.add(u)
+    db.commit()
+    db.refresh(u)
+    return UserOut.model_validate(u)
+
+
+@router.get("/privacy", response_model=PrivacySettings)
+def get_privacy(user: User = Depends(get_current_user)):
+    return PrivacySettings(**_privacy)
+
+
+@router.put("/privacy", response_model=PrivacySettings)
+def put_privacy(p: PrivacySettingsUpdate, user: User = Depends(SuperAdmin)):
+    _privacy.update({k: v for k, v in p.model_dump().items() if v is not None})
+    return PrivacySettings(**_privacy)
+
+
+@router.get("/report/daily", response_model=DailyReport)
+def daily_report(date: str | None = None, db: Session = Depends(get_db),
+                 user: User = Depends(get_current_user)):
+    """'Explain My Campus' — AI-generated campus intelligence report."""
+    d = datetime.fromisoformat(date) if date else datetime.now()
+    snapshot = engine.snapshot(db)
+    return DailyReport(**generate_daily_report(db, snapshot, d))
+
+
+@router.get("/system")
+def system_info(db: Session = Depends(get_db), user: User = Depends(get_current_user)):
+    from ..config import get_settings
+    s = get_settings()
+    return {
+        "name": s.APP_NAME, "version": s.VERSION, "tagline": s.APP_TAGLINE,
+        "demo_mode": s.DEMO_MODE, "ai_service_url": s.AI_SERVICE_URL,
+        "database": s.DATABASE_URL.split("://")[0],
+        "engine_ticks": engine.tick_count,
+        "engine_started": engine.started_at.isoformat() if engine.started_at else None,
+        "zones": len(engine.zones), "parking_zones": len(engine.parking),
+        "ws_connections": __import__("app.ws", fromlist=["manager"]).manager.count,
+    }

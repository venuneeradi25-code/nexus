+++ b/frontend/src/pages/Cameras.tsx
@@ -0,0 +1,251 @@
+import { useEffect, useRef, useState } from 'react'
+import { useOutletContext } from 'react-router-dom'
+import api from '../lib/api'
+import type { Snapshot } from '../lib/types'
+import { Video, Upload, Activity, Eye, Car, Users } from 'lucide-react'
+import { cn } from '../lib/ui'
+
+interface Ctx { snapshot: Snapshot | null }
+
+interface Camera {
+  id: number
+  camera_id: string
+  name: string
+  location: string
+  zone_id: number | null
+  status: string
+  ai_status: string
+  fps: number
+  source_type: string
+  last_update: string | null
+}
+
+interface Analysis {
+  source: string
+  duration_seconds: number
+  frames_analyzed: number
+  person_detections_total: number
+  avg_people_per_frame: number
+  peak_people: number
+  avg_vehicles_per_frame: number
+  peak_vehicles: number
+  peak_density: string
+  movement_direction: string
+  detector: string
+  privacy: string
+  timeline: { t: number; people: number; vehicles: number; motion: number; density: string }[]
+}
+
+/** Simulated "live feed": animated canvas with moving dots (demo mode, no RTSP needed). */
+function SimulatedFeed({ camera, people }: { camera: Camera; people: number }) {
+  const canvasRef = useRef<HTMLCanvasElement>(null)
+  const peopleRef = useRef(people)
+  peopleRef.current = people
+
+  useEffect(() => {
+    const canvas = canvasRef.current
+    if (!canvas) return
+    const ctx = canvas.getContext('2d')
+    if (!ctx) return
+    let raf = 0
+    let t = Math.random() * 100
+    const dots = Array.from({ length: 26 }, () => ({
+      x: Math.random(), y: Math.random(), vx: (Math.random() - 0.5) * 0.004, vy: (Math.random() - 0.5) * 0.003,
+    }))
+    const draw = () => {
+      t += 0.016
+      ctx.fillStyle = '#060a13'
+      ctx.fillRect(0, 0, canvas.width, canvas.height)
+      // scanline
+      ctx.fillStyle = 'rgba(56,189,248,0.06)'
+      ctx.fillRect(0, (t % 1) * canvas.height, canvas.width, 2)
+      const crowd = Math.min(1, peopleRef.current / 400)
+      dots.forEach((d, i) => {
+        d.x += d.vx * (1 + crowd * 2)
+        d.y += d.vy
+        if (d.x < 0) d.x = 1; if (d.x > 1) d.x = 0
+        if (d.y < 0) d.y = 1; if (d.y > 1) d.y = 0
+        ctx.beginPath()
+        ctx.arc(d.x * canvas.width, d.y * canvas.height, 1.5 + crowd, 0, Math.PI * 2)
+        ctx.fillStyle = i % 3 === 0 ? 'rgba(129,140,248,0.9)' : 'rgba(56,189,248,0.85)'
+        ctx.fill()
+      })
+      // timestamp overlay
+      ctx.fillStyle = 'rgba(230,236,247,0.85)'
+      ctx.font = '10px JetBrains Mono'
+      ctx.fillText(`${camera.camera_id} · SIMULATED · ${new Date().toLocaleTimeString()}`, 8, 16)
+      ctx.fillStyle = camera.status === 'ONLINE' ? '#34d399' : '#f87171'
+      ctx.fillText(camera.status, 8, canvas.height - 8)
+      raf = requestAnimationFrame(draw)
+    }
+    raf = requestAnimationFrame(draw)
+    return () => cancelAnimationFrame(raf)
+  }, [camera.camera_id, camera.status])
+
+  return <canvas ref={canvasRef} width={320} height={180} className="w-full h-full rounded-lg" />
+}

@@ -0,0 +1,101 @@
+import { useEffect, useRef, useState } from 'react'
+import api from '../lib/api'
+import { MessageSquareText, Send, Sparkles } from 'lucide-react'
+import { cn } from '../lib/ui'
+
+interface Message {
+  role: 'user' | 'assistant'
+  text: string
+  data?: any
+}
+
+export default function Assistant() {
+  const [messages, setMessages] = useState<Message[]>([
+    {
+      role: 'assistant',
+      text: "Hello — I'm the NEXUS AI Decision Assistant. Ask me anything about the campus: crowd, parking, traffic, events, weather, resources, anomalies, risk — or run a what-if simulation (e.g. “What could happen if the main gate is closed?”).",
+    },
+  ])
+  const [input, setInput] = useState('')
+  const [busy, setBusy] = useState(false)
+  const [suggestions, setSuggestions] = useState<string[]>([])
+  const bottomRef = useRef<HTMLDivElement>(null)
+
+  useEffect(() => {
+    api.get('/assistant/suggestions').then((r) => setSuggestions(r.data.suggestions)).catch(() => {})
+  }, [])
+  useEffect(() => { bottomRef.current?.scrollIntoView({ behavior: 'smooth' }) }, [messages])
+
+  const ask = async (question: string) => {
+    if (!question.trim() || busy) return
+    setMessages((m) => [...m, { role: 'user', text: question }])
+    setInput('')
+    setBusy(true)
+    try {
+      const res = await api.post('/assistant/ask', { question })
+      setMessages((m) => [...m, { role: 'assistant', text: res.data.answer, data: res.data.data }])
+      if (res.data.suggestions) setSuggestions(res.data.suggestions)
+    } catch (e: any) {
+      setMessages((m) => [...m, { role: 'assistant', text: 'Sorry — I could not process that question. ' + (e.response?.data?.detail || '') }])
+    } finally {
+      setBusy(false)
+    }
+  }
+
+  return (
+    <div className="flex flex-col h-[calc(100vh-7.5rem)]">
+      <h1 className="text-xl font-bold flex items-center gap-2 mb-4"><MessageSquareText size={20} className="text-nexus-accent" /> AI Decision Assistant</h1>
+
+      <div className="flex-1 overflow-y-auto space-y-4 pr-2">
+        {messages.map((m, i) => (
+          <div key={i} className={cn('flex', m.role === 'user' ? 'justify-end' : 'justify-start')}>
+            <div className={cn('max-w-[80%] rounded-2xl px-4 py-3 text-sm whitespace-pre-wrap',
+              m.role === 'user'
+                ? 'bg-gradient-to-r from-nexus-accent to-nexus-accent2 text-white rounded-br-sm'
+                : 'glass border border-nexus-border rounded-bl-sm')}>
+              {m.role === 'assistant' && (
+                <div className="flex items-center gap-1.5 text-[10px] uppercase tracking-wider text-nexus-accent mb-1.5">
+                  <Sparkles size={11} /> NEXUS AI
+                </div>
+              )}
+              {m.text}
+            </div>
+          </div>
+        ))}
+        {busy && (
+          <div className="flex justify-start">
+            <div className="glass border border-nexus-border rounded-2xl rounded-bl-sm px-4 py-3 text-sm text-nexus-muted">
+              Analyzing campus data…
+            </div>
+          </div>
+        )}
+        <div ref={bottomRef} />
+      </div>
+
+      {messages.length <= 1 && suggestions.length > 0 && (
+        <div className="flex flex-wrap gap-2 my-3">
+          {suggestions.map((s) => (
+            <button key={s} onClick={() => ask(s)}
+              className="rounded-full border border-nexus-border px-3 py-1.5 text-xs text-nexus-muted hover:border-nexus-accent/50 hover:text-nexus-text transition-colors">
+              {s}
+            </button>
+          ))}
+        </div>
+      )}
+
+      <div className="flex items-center gap-2 mt-3">
+        <input
+          value={input}
+          onChange={(e) => setInput(e.target.value)}
+          onKeyDown={(e) => e.key === 'Enter' && ask(input)}
+          placeholder="Ask NEXUS: “Which parking zone will fill first?” or “What happens if the main gate is closed?”"
+          className="flex-1 rounded-xl border border-nexus-border bg-nexus-panel px-4 py-3 text-sm focus:border-nexus-accent focus:outline-none"
+        />
+        <button onClick={() => ask(input)} disabled={busy}
+          className="rounded-xl bg-gradient-to-r from-nexus-accent to-nexus-accent2 p-3 text-white hover:opacity-90 disabled:opacity-50">
+          <Send size={16} />
+        </button>
+      </div>
+    </div>
+  )
+}

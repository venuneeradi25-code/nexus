@@ -0,0 +1,114 @@
+"""NEXUS — AI Digital Twin for Campus Intelligence. Main FastAPI application."""
+import json
+import logging
+from contextlib import asynccontextmanager
+
+from fastapi import FastAPI, WebSocket, WebSocketDisconnect, Query
+from fastapi.middleware.cors import CORSMiddleware
+
+from .ai.engine import engine
+from .config import get_settings
+from .database import SessionLocal, init_db
+from .models import User
+from .security import decode_token
+from .ws import manager
+
+logging.basicConfig(level=logging.INFO,
+                    format="%(asctime)s %(levelname)s [%(name)s] %(message)s")
+logger = logging.getLogger("nexus")
+
+settings = get_settings()
+
+
+@asynccontextmanager
+async def lifespan(app: FastAPI):
+    # --- startup ---
+    init_db()
+    db = SessionLocal()
+    try:
+        if not db.query(User).first():
+            logger.info("Seeding database (demo users, campus map, 30-day history)...")
+            from seed import run as seed_run
+            seed_run(db)
+            logger.info("Seed complete.")
+        engine.load_static(db)
+        engine.refresh_baselines(db)
+    finally:
+        db.close()
+    engine.start()
+    logger.info("NEXUS backend ready — digital twin engine running")
+    yield
+    # --- shutdown ---
+    if engine._task:
+        engine._task.cancel()
+
+
+app = FastAPI(
+    title="NEXUS — AI Digital Twin for Campus Intelligence",
+    description="Understand the present. Simulate the future. Prevent the unexpected.",
+    version=settings.VERSION,
+    lifespan=lifespan,
+)
+
+app.add_middleware(
+    CORSMiddleware,
+    allow_origins=[o.strip() for o in settings.CORS_ORIGINS.split(",")],
+    allow_credentials=True,
+    allow_methods=["*"],
+    allow_headers=["*"],
+)
+
+from .routers import (admin, alerts, analytics, assistant, auth, campus, demo,  # noqa: E402
+                      live, predictions, simulations)
+
+for r in (auth.router, campus.router, live.router, alerts.router, predictions.router,
+          simulations.router, analytics.router, assistant.router, demo.router,
+          admin.router):
+    app.include_router(r)
+
+
+@app.get("/")
+def root():
+    return {
+        "name": settings.APP_NAME,
+        "title": "NEXUS — AI Digital Twin for Campus Intelligence",
+        "tagline": settings.APP_TAGLINE,
+        "version": settings.VERSION,
+        "demo_mode": settings.DEMO_MODE,
+        "docs": "/docs",
+        "websocket": "/ws/live",
+    }
+
+
+@app.get("/health")
+def health():
+    return {"status": "ok", "engine_running": engine.started_at is not None,
+            "ticks": engine.tick_count}
+
+
+@app.websocket("/ws/live")
+async def live_ws(websocket: WebSocket, token: str | None = Query(default=None)):
+    """Real-time campus updates. Pass a valid JWT as ?token=..."""
+    if token:
+        payload = decode_token(token)
+        if not payload:
+            await websocket.close(code=4401)
+            return
+    await manager.connect(websocket)
+    try:
+        # send an immediate snapshot so clients render instantly
+        db = SessionLocal()
+        try:
+            payload = json.dumps({"type": "live", "data": engine.snapshot(db)},
+                                 default=str)
+            await websocket.send_text(payload)
+        finally:
+            db.close()
+        while True:
+            msg = await websocket.receive_text()
+            if msg == "ping":
+                await websocket.send_text("pong")
+    except WebSocketDisconnect:
+        await manager.disconnect(websocket)
+    except Exception:

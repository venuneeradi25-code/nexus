+                </div>
+                <div className="h-2.5 rounded-full bg-nexus-border overflow-hidden">
+                  <div className={`h-full rounded-full ${e.occupancy_pct >= 90 ? 'bg-nexus-red' : e.occupancy_pct >= 70 ? 'bg-nexus-orange' : e.occupancy_pct >= 40 ? 'bg-nexus-yellow' : 'bg-nexus-green'}`}

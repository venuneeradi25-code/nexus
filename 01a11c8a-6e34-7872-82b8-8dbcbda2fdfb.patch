+"""NEXUS AI Decision Assistant.
+
+Answers administrator questions using live digital-twin data:
+  "How is the campus right now?" / "Where is the highest crowd?"
+  "Which parking zone will fill first?" / "Why is the risk score high?"
+  "What could happen if Gate 1 is closed?" / "What is today's biggest risk?"
+
+Rule-based intent routing keeps answers grounded in real system data (no
+hallucination). If NEXUS_LLM_URL is configured, the grounded context is sent to
+an LLM for natural-language phrasing (LLM-based explanation layer).
+"""
+from __future__ import annotations
+
+import os
+import re
+from datetime import datetime
+from typing import Any
+
+import httpx
+
+from .whatif import run_simulation
+
+SUGGESTIONS = [
+    "How is the campus right now?",
+    "Where is the highest crowd concentration?",
+    "Which parking zone will fill first?",
+    "Why is the campus risk score high?",
+    "What is today's biggest operational risk?",
+    "Is any unusual activity happening?",
+    "What could happen if the main gate is closed?",
+    "What events may create congestion?",
+    "How is the weather and environment?",
+    "Are there any resource consumption anomalies?",
+]
+
+
+def _fmt(n: Any) -> str:
+    return f"{int(n):,}"
+
+
+def answer_question(question: str, snapshot: dict) -> dict[str, Any]:
+    q = question.lower().strip()
+    zones = snapshot.get("zones", [])
+    parking = snapshot.get("parking", [])
+    events = snapshot.get("events", [])
+    alerts = snapshot.get("alerts", [])
+    risk = snapshot.get("risk", {})
+    metrics = snapshot.get("metrics", {})
+    env = snapshot.get("environment", {})
+    resources = snapshot.get("resources", [])
+    anomalies = snapshot.get("anomalies", [])
+    traffic = snapshot.get("traffic", [])
+
+    def campus_summary() -> tuple[str, dict]:
+        lines = [
+            f"Campus status: {risk.get('level', 'NORMAL')} (risk score {risk.get('score', 0)}/100).",
+            f"Estimated campus population: {_fmt(metrics.get('total_population', 0))} across {len(zones)} zones.",
+            f"Parking occupancy: {metrics.get('parking_occupancy_pct', 0):.0f}% overall.",
+            f"Traffic: {metrics.get('traffic_status', 'LOW')}; weather: {env.get('condition', 'SUNNY')} "
+            f"({env.get('temperature', 0)}°C).",
+            f"Active alerts: {len(alerts)} | Live events: {metrics.get('active_events', 0)}.",
+        ]
+        return "\n".join(lines), {"metrics": metrics, "risk": risk}
+
+    # ---- intents -----------------------------------------------------------
+    if re.search(r"\b(how is|status|right now|overall|summary)\b", q) and "risk" not in q:
+        text, data = campus_summary()
+        return {"question": question, "answer": text, "data": data, "suggestions": SUGGESTIONS[1:5]}
+
+    if re.search(r"(highest|where).*(crowd|concentration|busy)|busiest", q):
+        if not zones:
+            return {"question": question, "answer": "No zone data available.", "data": {}}
+        top = max(zones, key=lambda z: z["people"])
+        hot = sorted(zones, key=lambda z: -z["people"])[:3]
+        text = (f"The highest crowd concentration is at {top['name']} with {top['people']} people "
+                f"({top['density']} density, {top['occupancy_pct']}% of capacity).\n"
+                f"Top 3: " + ", ".join(f"{z['name']} ({z['people']})" for z in hot) + ".")
+        return {"question": question, "answer": text,
+                "data": {"zones": hot}, "suggestions": SUGGESTIONS}
+
+    if re.search(r"parking.*(fill|first|full|capacity)|which parking", q):
+        if not parking:
+            return {"question": question, "answer": "No parking data available.", "data": {}}
+        with_pred = [p for p in parking if p.get("predicted_full_minutes") is not None]
+        soon = sorted(with_pred or parking,
+                      key=lambda p: p.get("predicted_full_minutes")
+                      if p.get("predicted_full_minutes") is not None else 9999)
+        first = soon[0]
+        if first.get("predicted_full_minutes") is not None:
+            text = (f"{first['name']} will fill first — predicted to reach capacity in "
+                    f"~{first['predicted_full_minutes']} minutes "
+                    f"(now {first['occupancy_pct']}% occupied, {first['available']} slots free).")
+        else:
+            text = (f"Highest-occupancy zone: {first['name']} at {first['occupancy_pct']}% "
+                    f"({first['occupied']}/{first['total_slots']} slots). "
+                    f"No zone is predicted to fill within 45 minutes.")
+        return {"question": question, "answer": text,
+                "data": {"parking": sorted(parking, key=lambda p: -p["occupancy_pct"])[:5]},
+                "suggestions": SUGGESTIONS}
+
+    if re.search(r"(unusual|anomal|abnormal|strange|odd)", q):
+        if not anomalies and not alerts:
+            text = ("No unusual activity detected. All zones are within their learned "
+                    "historical baselines for this time of day.")
+        else:
+            lines = []
+            for a in anomalies[:5]:
+                lines.append(f"⚠ {a['type']} at {a['location']}: {a['explanation']}")
+            for a in alerts[:5]:
+                lines.append(f"🚨 [{a['severity']}] {a['alert_type']} at {a['location']}: {a['reason']}")
+            text = "Unusual activity detected:\n" + "\n".join(lines) if lines else \
+                "No unusual activity detected right now."
+        return {"question": question, "answer": text,
+                "data": {"anomalies": anomalies, "alerts": alerts[:10]}, "suggestions": SUGGESTIONS}
+
+    if re.search(r"risk|threat|danger|score", q) and re.search(r"why|reason|explain|high|score", q):
+        contrib = risk.get("contributors", {})
+        reasons = risk.get("reasons", [])
+        top = sorted(contrib.items(), key=lambda kv: -kv[1])[:4]
+        text = (f"Campus risk score is {risk.get('score', 0)}/100 — {risk.get('level', 'NORMAL')}.\n"
+                f"Main contributors: " +
+                ", ".join(f"{k} +{v}" for k, v in top if v > 0) + ".")
+        if reasons:
+            text += "\nWhy:\n• " + "\n• ".join(reasons[:6])
+        recs = [a.get("recommended_action") for a in alerts[:3] if a.get("recommended_action")]
+        if recs:
+            text += "\nRecommended actions:\n• " + "\n• ".join(dict.fromkeys(recs))
+        return {"question": question, "answer": text, "data": {"risk": risk},
+                "suggestions": SUGGESTIONS}
+
+    if re.search(r"(biggest|top|main).*(risk|operational risk|concern)", q):
+        contrib = risk.get("contributors", {})
+        if contrib:
+            k, v = max(contrib.items(), key=lambda kv: kv[1])
+            text = (f"Today's biggest operational risk driver is '{k}' (+{v} points of the "
+                    f"risk score). ")
+        else:
+            text = "No significant risk contributors at the moment. "
+        if alerts:
+            a = alerts[0]
+            text += (f"Most urgent active alert: [{a['severity']}] {a['alert_type']} at "
+                     f"{a['location']} — {a['reason']}")
+        return {"question": question, "answer": text,
+                "data": {"risk": risk, "top_alert": alerts[0] if alerts else None},
+                "suggestions": SUGGESTIONS}
+
+    if re.search(r"what (happens|if|would happen).*(gate|closed)|gate.*(close|shut)", q):
+        gate = "Main Gate"
+        m = re.search(r"(gate\s*\d|main gate|north gate|east gate|gate\s*\w+)", q)
+        if m:
+            gate = m.group(1).title()
+        sim = run_simulation(snapshot, "GATE_CLOSURE", {"gate": gate})
+        sim_traffic = sim["simulated"]["traffic"]
+        lines = [f"WHAT-IF: '{gate}' closed — simulated results:"]
+        for t in sim_traffic:
+            lines.append(f"• {t['location']}: {t['incoming']}/min in, {t['outgoing']}/min out "
+                         f"→ {t['congestion']}")
+        lines.append(f"Parking demand delta: +{sim['impact'].get('parking_demand_delta_pct', 0)}%")
+        lines.append(f"Risk score: {sim['risk_score_before']} → {sim['risk_score_after']}")
+        lines.append("AI recommendation: " + " ".join(sim["recommendations"][:2]))
+        return {"question": question, "answer": "\n".join(lines),
+                "data": {"simulation": sim}, "suggestions": SUGGESTIONS}
+
+    if re.search(r"event|congestion.*(event|create)|crowd.*event", q):
+        if not events:
+            text = "No campus events scheduled."
+        else:
+            lines = []
+            for e in events:
+                lines.append(
+                    f"• {e['name']} @ {e['venue']} [{e['status']}]: {e['current_crowd']}/"
+                    f"{e['capacity']} now, predicted peak {e['predicted_peak']} "
+                    f"(expected {e['expected_attendance']}) — risk {e['risk_level']}.")
+            text = "Campus events:\n" + "\n".join(lines)
+            congested = [t for t in traffic if t["congestion"] in ("HIGH", "CRITICAL")]
+            if congested:
+                text += ("\nCongestion hotspots: " +
+                         ", ".join(f"{t['location']} ({t['congestion']})" for t in congested))
+        return {"question": question, "answer": text, "data": {"events": events},
+                "suggestions": SUGGESTIONS}
+
+    if re.search(r"weather|environment|rain|temperature|air quality", q):
+        text = (f"Environment: {env.get('condition', 'SUNNY')}, {env.get('temperature', 0)}°C, "
+                f"humidity {env.get('humidity', 0)}%, rain probability "
+                f"{env.get('rain_probability', 0):.0f}%, AQI {env.get('air_quality', 0)}.")
+        live_outdoor = [e for e in events if "ground" in (e.get("venue") or "").lower()
+                        and e["status"] == "LIVE"]
+        if live_outdoor and (env.get("rain_probability", 0) >= 60
+                             or env.get("condition") in ("RAIN", "HEAVY_RAIN", "STORM")):
+            text += (f" ⚠ Event disruption risk: {', '.join(e['name'] for e in live_outdoor)} "
+                     f"is outdoors. Consider moving it to an indoor venue.")
+        return {"question": question, "answer": text, "data": {"environment": env},
+                "suggestions": SUGGESTIONS}
+
+    if re.search(r"resource|electric|water|waste|consumption|utility", q):
+        lines = []
+        for r in resources:
+            lines.append(f"• {r['resource_type']}: {r['value']} {r.get('unit', '')}")
+        for a in anomalies:
+            if a["type"] == "RESOURCE_ANOMALY":
+                lines.append("⚠ " + a["explanation"])
+        text = "Resource usage (current):\n" + "\n".join(lines) if lines else \
+            "No resource data available."
+        return {"question": question, "answer": text,
+                "data": {"resources": resources, "anomalies": anomalies}, "suggestions": SUGGESTIONS}
+
+    if re.search(r"camera", q):
+        text = (f"Cameras: {snapshot.get('cameras_online', 0)}/{snapshot.get('cameras_total', 0)} "
+                f"online. AI engine: {snapshot.get('ai_engine', 'unknown')}.")
+        return {"question": question, "answer": text, "data": {}, "suggestions": SUGGESTIONS}
+
+    # ---- fallback ----------------------------------------------------------
+    text, data = campus_summary()
+    text += ("\n\nI can answer questions about crowd, parking, traffic, events, weather, "
+             "resources, anomalies, risk — or run a what-if simulation (e.g. 'What happens "
+             "if the main gate is closed?').")
+    return {"question": question, "answer": text, "data": data, "suggestions": SUGGESTIONS}
+
+
+def llm_explain(prompt_context: str) -> str | None:
+    """Optional LLM explanation layer. Enabled with NEXUS_LLM_URL (+ NEXUS_LLM_KEY)."""
+    url = os.environ.get("NEXUS_LLM_URL")
+    if not url:
+        return None
+    try:
+        resp = httpx.post(url, json={"prompt": prompt_context}, timeout=20)
+        resp.raise_for_status()
+        return resp.json().get("text")
+    except Exception:
+        return None

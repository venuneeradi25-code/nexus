+"""Predictive campus intelligence.
+
+Lightweight, explainable time-series prediction.
+
+Series convention: a series is a list of (minutes_ago, value) points, where the
+NEWEST sample has the smallest minutes_ago (≈ 0). Values as a function of
+minutes_ago therefore have a NEGATIVE slope when the metric is growing.
+
+  - linear regression over a recent sliding window (momentum + trend)
+  - capacity-aware saturation (crowd/parking growth slows near capacity)
+  - time-to-threshold estimation (e.g. minutes until parking is full)
+"""
+from __future__ import annotations
+
+import math
+
+
+def linear_fit(series: list[tuple[float, float]]) -> tuple[float, float]:
+    """Fit y = slope*x + intercept over (x, y) points. Returns (slope, intercept)."""
+    n = len(series)
+    if n == 0:
+        return 0.0, 0.0
+    if n == 1:
+        return 0.0, series[0][1]
+    xs = [p[0] for p in series]
+    ys = [p[1] for p in series]
+    mx = sum(xs) / n
+    my = sum(ys) / n
+    denom = sum((x - mx) ** 2 for x in xs)
+    if denom == 0:
+        return 0.0, my
+    slope = sum((x - mx) * (y - my) for x, y in series) / denom
+    return slope, my - slope * mx
+
+
+def predict_value(series: list[tuple[float, float]], horizon_minutes: float,
+                  cap: float | None = None) -> tuple[float, float]:
+    """Predict the value `horizon_minutes` in the FUTURE.
+
+    series: (minutes_ago, value) points; the future corresponds to x = -horizon.
+    """
+    if not series:
+        return 0.0, 0.0
+    slope, intercept = linear_fit(series)
+    raw = intercept - slope * horizon_minutes   # x = -horizon in minutes_ago space
+    latest_y = min(series, key=lambda p: p[0])[1]  # newest sample
+    # momentum damping so predictions do not explode
+    predicted = 0.5 * raw + 0.5 * latest_y
+    if cap is not None:
+        predicted = min(predicted, cap * 1.15)
+    predicted = max(predicted, 0.0)
+    # confidence decays with horizon and with fit quality
+    resid = math.sqrt(sum((y - (slope * x + intercept)) ** 2 for x, y in series)
+                      / max(len(series), 1))
+    spread = max(abs(latest_y), 1.0)
+    fit_quality = max(0.0, 1.0 - min(resid / spread, 1.0))
+    confidence = round(0.9 * fit_quality * math.exp(-horizon_minutes / 240.0), 2)
+    return round(predicted, 1), confidence
+
+
+def minutes_to_threshold(series: list[tuple[float, float]], threshold: float,
+                         cap: float | None = None) -> int | None:
+    """Minutes until the series crosses `threshold` (growing), else None."""
+    if not series:
+        return None
+    slope, intercept = linear_fit(series)
+    latest_y = min(series, key=lambda p: p[0])[1]
+    if latest_y >= threshold:
+        return 0
+    if slope >= 0:
+        return None  # shrinking or flat in minutes_ago space -> not approaching
+    # slope*x + intercept = threshold  ->  x is negative (in the future)
+    x_cross = (threshold - intercept) / slope
+    minutes = -x_cross
+    if minutes <= 0 or minutes > 24 * 60:
+        return None
+    return int(round(minutes))
+
+
+def growth_rate(series: list[tuple[float, float]], window_minutes: float = 10.0) -> float:
+    """Forward growth per `window_minutes` (positive when the metric is rising)."""
+    if len(series) < 2:
+        return 0.0
+    slope, _ = linear_fit(series)
+    return round(max(-slope, 0.0) * window_minutes, 1)

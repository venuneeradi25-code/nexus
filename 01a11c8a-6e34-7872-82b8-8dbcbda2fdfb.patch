index 0000000..2ec37be
--- /dev/null
+++ b/backend/app/ai/vision.py
@@ -0,0 +1,189 @@
+"""Computer vision analytics — anonymous people / vehicle / crowd analysis.
+
+Pipeline (privacy-first, NO facial recognition, NO identity tracking):
+  1. sample frames from an uploaded video (or RTSP snapshot)
+  2. motion analysis with MOG2 background subtraction
+  3. person detection with a Haar full-body cascade (anonymous bounding boxes)
+  4. vehicle estimation from large motion blobs
+  5. crowd density estimation (people per frame area)
+
+If `ultralytics` (YOLO) is installed, a YOLO detector is used automatically and
+this module falls back to the OpenCV pipeline otherwise. Detection is structured
+so the AI microservice (ai_service/) can run it as a separate process.
+"""
+from __future__ import annotations
+
+import logging
+import os
+import tempfile
+from typing import Any
+
+import cv2
+import numpy as np
+
+logger = logging.getLogger("nexus.vision")
+
+try:  # optional YOLO backend — used automatically when available
+    from ultralytics import YOLO  # type: ignore
+    _YOLO = YOLO("yolov8n.pt") if os.environ.get("NEXUS_YOLO", "1") == "1" else None
+    logger.info("YOLO detector loaded")
+except Exception:
+    _YOLO = None
+    logger.info("ultralytics not available — using OpenCV Haar + motion pipeline")
+
+_PERSON_CASCADE = cv2.CascadeClassifier(
+    os.path.join(cv2.data.haarcascades, "haarcascade_fullbody.xml"))
+
+
+def density_label(people: int, frame_area: int) -> str:
+    if frame_area <= 0:
+        return "LOW"
+    per_1000px = people / (frame_area / 1000.0)
+    if per_1000px > 28:
+        return "CRITICAL"
+    if per_1000px > 18:
+        return "HIGH"
+    if per_1000px > 8:
+        return "MEDIUM"
+    return "LOW"
+
+
+def _detect_people(frame) -> list:
+    if _YOLO is not None:
+        results = _YOLO(frame, verbose=False)
+        boxes = []
+        for r in results:
+            for b in r.boxes:
+                if int(b.cls[0]) == 0:  # person class
+                    boxes.append([int(v) for v in b.xyxy[0]])
+        return boxes
+    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
+    gray = cv2.GaussianBlur(gray, (5, 5), 0)
+    people = _PERSON_CASCADE.detectMultiScale(gray, scaleFactor=1.08,
+                                              minNeighbors=3, minSize=(24, 48))
+    return [[int(x), int(y), int(x + w), int(y + h)] for x, y, w, h in people]
+
+
+def _motion_blobs(mog, frame) -> tuple[int, float]:
+    """Count sizeable moving blobs (proxy for vehicles / moving groups)."""
+    mask = mog.apply(frame, learningRate=0.002)
+    mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, np.ones((5, 5), np.uint8))
+    mask = cv2.dilate(mask, np.ones((7, 7), np.uint8), iterations=2)
+    contours, _ = cv2.findContours(mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
+    vehicles = 0
+    motion_area = 0.0
+    frame_area = frame.shape[0] * frame.shape[1]
+    for c in contours:
+        area = cv2.contourArea(c)
+        motion_area += area
+        # a car-sized blob relative to frame size
+        if 0.008 * frame_area < area < 0.35 * frame_area:
+            x, y, w, h = cv2.boundingRect(c)
+            aspect = w / max(h, 1)
+            if 0.6 < aspect < 4.0:
+                vehicles += 1
+    return vehicles, motion_area / max(frame_area, 1)
+
+
+def analyze_video(path: str, sample_fps: float = 2.0, max_frames: int = 80) -> dict[str, Any]:
+    """Analyze an uploaded/demo video. Returns per-frame + aggregate analytics."""
+    cap = cv2.VideoCapture(path)
+    if not cap.isOpened():
+        raise ValueError(f"Cannot open video: {path}")
+    src_fps = cap.get(cv2.CAP_PROP_FPS) or 25.0
+    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT) or 0)
+    duration = total_frames / src_fps if src_fps else 0.0
+    step = max(1, int(src_fps / sample_fps))
+
+    mog = cv2.createBackgroundSubtractorMOG2(history=120, detectShadows=True)
+    frames_out = []
+    people_counts, vehicle_counts, motion_ratios = [], [], []
+    idx = 0
+    analyzed = 0
+    while analyzed < max_frames:
+        ok, frame = cap.read()
+        if not ok:
+            break
+        if idx % step == 0:
+            frame = cv2.resize(frame, (640, 360))
+            people = _detect_people(frame)
+            vehicles, motion_ratio = _motion_blobs(mog, frame)
+            area = frame.shape[0] * frame.shape[1]
+            density = density_label(len(people) + vehicles, area)
+            ts = idx / src_fps
+            frames_out.append({
+                "t": round(ts, 2), "people": len(people),
+                "vehicles": vehicles, "motion": round(motion_ratio, 3),
+                "density": density,
+            })
+            people_counts.append(len(people))
+            vehicle_counts.append(vehicles)
+            motion_ratios.append(motion_ratio)
+            analyzed += 1
+        idx += 1
+    cap.release()
+
+    n = max(len(people_counts), 1)
+    avg_people = sum(people_counts) / n
+    peak_people = max(people_counts) if people_counts else 0
+    avg_vehicles = sum(vehicle_counts) / n
+    peak_density = density_label(peak_people + max(vehicle_counts or [0]),
+                                 640 * 360)
+    # entry/exit style estimate: net motion direction from mean optical magnitude
+    direction = "STABLE"
+    if len(motion_ratios) >= 4:
+        first = sum(motion_ratios[: len(motion_ratios) // 2])
+        second = sum(motion_ratios[len(motion_ratios) // 2:])
+        direction = "GROWING" if second > first * 1.1 else "SHRINKING" if second < first * 0.9 else "STABLE"
+
+    return {
+        "source": os.path.basename(path),
+        "duration_seconds": round(duration, 1),
+        "fps": round(src_fps, 1),
+        "frames_analyzed": analyzed,
+        "person_detections_total": int(sum(people_counts)),
+        "avg_people_per_frame": round(avg_people, 1),
+        "peak_people": int(peak_people),
+        "avg_vehicles_per_frame": round(avg_vehicles, 1),
+        "peak_vehicles": int(max(vehicle_counts) if vehicle_counts else 0),
+        "peak_density": peak_density,
+        "movement_direction": direction,
+        "timeline": frames_out,
+        "detector": "YOLOv8" if _YOLO is not None else "OpenCV Haar + MOG2 motion",
+        "privacy": "anonymous analytics only — no facial recognition, no identity tracking",
+    }
+
+
+def analyze_image(path: str) -> dict[str, Any]:
+    frame = cv2.imread(path)
+    if frame is None:
+        raise ValueError(f"Cannot read image: {path}")
+    frame = cv2.resize(frame, (640, 360))
+    people = _detect_people(frame)
+    mog = cv2.createBackgroundSubtractorMOG2()
+    vehicles, motion_ratio = _motion_blobs(mog, frame)
+    area = frame.shape[0] * frame.shape[1]
+    return {
+        "source": os.path.basename(path),
+        "people": len(people),
+        "vehicles": vehicles,
+        "motion_ratio": round(motion_ratio, 3),
+        "density": density_label(len(people) + vehicles, area),
+        "detector": "YOLOv8" if _YOLO is not None else "OpenCV Haar + MOG2 motion",
+    }
+
+
+def analyze_upload(file_bytes: bytes, suffix: str = ".mp4") -> dict[str, Any]:
+    """Persist an upload to a temp file and analyze it."""
+    fd, tmp = tempfile.mkstemp(suffix=suffix)
+    try:
+        with os.fdopen(fd, "wb") as f:
+            f.write(file_bytes)
+        if suffix.lower() in (".jpg", ".jpeg", ".png", ".webp", ".bmp"):
+            return analyze_image(tmp)
+        return analyze_video(tmp)
+    finally:
+        try:
+            os.unlink(tmp)
+        except OSError:
+            pass

+            </div>
+            <div className="text-[11px] text-nexus-muted mt-1">{e.occupancy_pct.toFixed(0)}% occupancy</div>
+          </div>
+        ))}
+      </div>
+
+      {/* Parking strip */}
+      <div className="glass rounded-xl p-4 border border-nexus-border">
+        <h3 className="text-sm font-semibold mb-3">Smart Parking — Live Occupancy</h3>
+        <div className="grid grid-cols-2 md:grid-cols-5 gap-3">
+          {parking.map((p) => (
+            <div key={p.id} className="rounded-lg border border-nexus-border p-3">
+              <div className="text-xs font-semibold">{p.name}</div>
+              <div className="text-[10px] text-nexus-muted mb-2">{p.type}</div>
+              <div className="font-mono text-lg font-bold">{p.occupancy_pct.toFixed(0)}%</div>
+              <div className="h-1.5 rounded-full bg-nexus-border mt-2 overflow-hidden">
+                <div className={cn2bar(p.occupancy_pct)} style={{ width: `${Math.min(100, p.occupancy_pct)}%` }}></div>
+              </div>
+              <div className="text-[10px] text-nexus-muted mt-1">
+                {p.occupied}/{p.total_slots} · {p.available} free
+                {p.predicted_full_minutes != null && <span className="text-nexus-orange"> · full in ~{p.predicted_full_minutes}m</span>}
+              </div>
+            </div>
+          ))}
+        </div>
+      </div>
+    </div>
+  )
+}
+
+function cn2(growth: number) {
+  return `font-mono font-semibold ${growth > 60 ? 'text-nexus-orange' : growth > 0 ? 'text-nexus-green' : 'text-nexus-muted'}`
+}
+
+function cn2bar(pct: number) {
+  return `h-full rounded-full ${pct >= 95 ? 'bg-nexus-red' : pct >= 80 ? 'bg-nexus-orange' : pct >= 55 ? 'bg-nexus-yellow' : 'bg-nexus-green'}`
+}
+
+function riskColor(score: number) {
+  if (score >= 75) return '#f87171'
+  if (score >= 50) return '#fb923c'
+  if (score >= 25) return '#fbbf24'
+  return '#34d399'
+}

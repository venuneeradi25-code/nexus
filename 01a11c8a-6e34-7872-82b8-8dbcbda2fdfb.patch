index 0000000..5bb342e
--- /dev/null
+++ b/frontend/src/lib/useLive.ts
@@ -0,0 +1,76 @@
+import { useEffect, useRef, useState } from 'react'
+import type { Snapshot } from './types'
+
+/**
+ * Real-time hook: WebSocket /ws/live with automatic polling fallback.
+ * The backend pushes a full digital-twin snapshot every engine tick.
+ */
+export function useLive(enabled: boolean, onSnapshot?: (s: Snapshot) => void) {
+  const [snapshot, setSnapshot] = useState<Snapshot | null>(null)
+  const [connected, setConnected] = useState(false)
+  const [lastUpdate, setLastUpdate] = useState<Date | null>(null)
+  const onSnapshotRef = useRef(onSnapshot)
+  onSnapshotRef.current = onSnapshot
+
+  useEffect(() => {
+    if (!enabled) return
+    let ws: WebSocket | null = null
+    let poll: ReturnType<typeof setInterval> | null = null
+    let cancelled = false
+
+    const handle = (data: Snapshot) => {
+      if (cancelled) return
+      setSnapshot(data)
+      setLastUpdate(new Date())
+      onSnapshotRef.current?.(data)
+    }
+
+    const startPolling = async () => {
+      const { default: api } = await import('./api')
+      poll = setInterval(async () => {
+        try {
+          const res = await api.get<Snapshot>('/dashboard')
+          handle(res.data)
+          setConnected(false) // polling mode
+        } catch {
+          /* retry next interval */
+        }
+      }, 4000)
+    }
+
+    const connect = () => {
+      const token = localStorage.getItem('nexus_token')
+      const proto = window.location.protocol === 'https:' ? 'wss' : 'ws'
+      ws = new WebSocket(
+        `${proto}://${window.location.host}/ws/live${token ? `?token=${token}` : ''}`,
+      )
+      ws.onopen = () => setConnected(true)
+      ws.onmessage = (ev) => {
+        try {
+          const msg = JSON.parse(ev.data)
+          if (msg.type === 'live' && msg.data) handle(msg.data)
+        } catch {
+          /* ignore keepalive */
+        }
+      }
+      ws.onclose = () => {
+        setConnected(false)
+        if (!cancelled) setTimeout(connect, 3000) // reconnect
+      }
+      ws.onerror = () => {
+        ws?.close()
+      }
+    }
+
+    connect()
+    startPolling() // fallback always runs; WS messages simply arrive faster
+
+    return () => {
+      cancelled = true
+      ws?.close()
+      if (poll) clearInterval(poll)
+    }
+  }, [enabled])
+
+  return { snapshot, connected, lastUpdate }
+}

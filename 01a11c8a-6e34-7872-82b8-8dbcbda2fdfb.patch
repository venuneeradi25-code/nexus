+"""AI Risk Engine — computes the overall campus risk score (0-100).
+
+Contributors (each normalised to a weighted share of 100):
+  crowd density pressure      +25
+  parking pressure            +18
+  traffic / gate congestion   +14
+  event pressure              +12
+  weather / environment       +10
+  resource anomalies          +8
+  restricted-zone activity    +8
+  active high-severity alerts +5
+"""
+from __future__ import annotations
+
+from .baselines import risk_level_from_score
+
+WEIGHTS = {
+    "crowd": 25,
+    "parking": 18,
+    "traffic": 14,
+    "events": 12,
+    "weather": 10,
+    "resources": 8,
+    "restricted": 8,
+    "alerts": 5,
+}
+
+
+def _clamp(x: float) -> float:
+    return max(0.0, min(1.0, x))
+
+
+def compute_risk(
+    *,
+    zones: list[dict],
+    parking_occupancy_pct: float,
+    traffic_status: str,
+    events: list[dict],
+    weather: str,
+    rain_probability: float,
+    resource_anomalies: int,
+    restricted_activity: int,
+    active_alerts: list[dict],
+) -> tuple[int, str, dict[str, int], list[str]]:
+    contributors: dict[str, int] = {k: 0 for k in WEIGHTS}
+    reasons: list[str] = []
+
+    # Crowd: worst zone occupancy vs capacity
+    worst = 0.0
+    worst_name = ""
+    for z in zones:
+        cap = max(z.get("capacity", 1), 1)
+        occ = _clamp(z.get("people", 0) / cap)
+        if occ > worst:
+            worst, worst_name = occ, z.get("name", "")
+    contributors["crowd"] = round(worst * WEIGHTS["crowd"])
+    if worst >= 0.7:
+        reasons.append(f"Crowd density at {worst_name} is {int(worst*100)}% of capacity")
+
+    # Parking
+    p = _clamp(parking_occupancy_pct / 100.0)
+    contributors["parking"] = round(p * WEIGHTS["parking"])
+    if p >= 0.85:
+        reasons.append(f"Parking occupancy is {int(parking_occupancy_pct)}%")
+
+    # Traffic
+    tmap = {"LOW": 0.1, "MODERATE": 0.45, "HIGH": 0.75, "CRITICAL": 1.0}
+    t = tmap.get(traffic_status, 0.2)
+    contributors["traffic"] = round(t * WEIGHTS["traffic"])
+    if t >= 0.7:
+        reasons.append(f"Traffic congestion is {traffic_status}")
+
+    # Events: worst event occupancy
+    e = 0.0
+    for ev in events:
+        cap = max(ev.get("capacity", 1), 1)
+        e = max(e, _clamp(ev.get("current_crowd", 0) / cap))
+        if ev.get("predicted_peak", 0) > cap:
+            e = max(e, _clamp(ev["predicted_peak"] / cap))
+    contributors["events"] = round(e * WEIGHTS["events"])
+    for ev in events:
+        if ev.get("predicted_peak", 0) > max(ev.get("capacity", 1), 1):
+            reasons.append(
+                f"Event '{ev.get('name')}' predicted peak {ev.get('predicted_peak')} "
+                f"exceeds capacity {ev.get('capacity')}"
+            )
+
+    # Weather
+    wmap = {"SUNNY": 0.0, "CLOUDY": 0.15, "RAIN": 0.45, "HEAVY_RAIN": 0.8, "STORM": 1.0}
+    w = max(wmap.get(weather, 0.0), _clamp(rain_probability / 100.0) * 0.6)
+    contributors["weather"] = round(w * WEIGHTS["weather"])
+    if weather in ("HEAVY_RAIN", "STORM"):
+        reasons.append(f"Severe weather: {weather}")
+    elif rain_probability >= 60:
+        reasons.append(f"Rain predicted within the hour ({int(rain_probability)}% probability)")
+
+    # Resources
+    r = _clamp(min(resource_anomalies, 3) / 3.0)
+    contributors["resources"] = round(r * WEIGHTS["resources"])
+    if resource_anomalies:
+        reasons.append(f"{resource_anomalies} resource consumption anomalie(s) detected")
+
+    # Restricted zone
+    rz = _clamp(min(restricted_activity, 5) / 5.0)
+    contributors["restricted"] = round(rz * WEIGHTS["restricted"])
+    if restricted_activity:
+        reasons.append(f"Restricted-zone activity detected ({restricted_activity} event(s))")
+
+    # Alerts
+    sev = {"INFO": 0.2, "LOW": 0.4, "MEDIUM": 0.6, "HIGH": 0.85, "CRITICAL": 1.0}
+    a = _clamp(sum(sev.get(x.get("severity", "LOW"), 0.5) for x in active_alerts) / 3.0)
+    contributors["alerts"] = round(a * WEIGHTS["alerts"])
+    crit = [x for x in active_alerts if x.get("severity") in ("HIGH", "CRITICAL")]
+    for x in crit[:2]:
+        reasons.append(f"Active alert: {x.get('alert_type')} at {x.get('location')}")
+
+    score = int(round(sum(contributors.values())))
+    score = max(0, min(100, score))
+    level = risk_level_from_score(score)
+    return score, level, contributors, reasons

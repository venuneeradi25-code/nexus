+import { NavLink, Outlet, useNavigate } from 'react-router-dom'
+import {
+  LayoutDashboard, Video, Users, Car, CalendarDays, TrendingUp, FlaskConical,
+  Bell, BarChart3, MessageSquareText, History, FileText, Settings, LogOut, Shield,
+} from 'lucide-react'
+import { useAuth } from '../store/auth'
+import { useLive } from '../lib/useLive'
+import { cn, RISK_COLORS, RISK_EMOJI } from '../lib/ui'
+
+const NAV = [
+  { to: '/', icon: LayoutDashboard, label: 'Digital Twin' },
+  { to: '/cameras', icon: Video, label: 'Cameras & CV' },
+  { to: '/crowd', icon: Users, label: 'Crowd Intelligence' },
+  { to: '/parking', icon: Car, label: 'Smart Parking' },
+  { to: '/events', icon: CalendarDays, label: 'Event Intelligence' },
+  { to: '/predictions', icon: TrendingUp, label: 'Predictions' },
+  { to: '/simulator', icon: FlaskConical, label: 'WHAT-IF Simulator' },
+  { to: '/alerts', icon: Bell, label: 'Smart Alerts' },
+  { to: '/analytics', icon: BarChart3, label: 'Analytics' },
+  { to: '/assistant', icon: MessageSquareText, label: 'AI Assistant' },
+  { to: '/replay', icon: History, label: 'Event Replay' },
+  { to: '/report', icon: FileText, label: 'Explain My Campus' },
+  { to: '/settings', icon: Settings, label: 'Settings & Privacy' },
+]
+
+export function Layout() {
+  const { user, logout } = useAuth()
+  const navigate = useNavigate()
+  const { snapshot, connected, lastUpdate } = useLive(true)
+
+  const risk = snapshot?.risk
+  const metrics = snapshot?.metrics
+
+  return (
+    <div className="flex h-screen nexus-grid-bg">
+      {/* Sidebar */}
+      <aside className="w-64 shrink-0 glass border-r border-nexus-border flex flex-col">
+        <div className="p-4 border-b border-nexus-border">
+          <div className="flex items-center gap-2">
+            <div className="h-9 w-9 rounded-lg bg-gradient-to-br from-nexus-accent to-nexus-accent2 flex items-center justify-center font-black text-white neon-accent">
+              N
+            </div>
+            <div>
+              <div className="font-extrabold tracking-wider text-lg leading-none">NEXUS</div>
+              <div className="text-[10px] text-nexus-muted mt-1 leading-tight">
+                AI Digital Twin for Campus Intelligence
+              </div>
+            </div>
+          </div>
+        </div>
+        <nav className="flex-1 overflow-y-auto py-2 px-2 space-y-0.5">
+          {NAV.map((item) => (
+            <NavLink
+              key={item.to}
+              to={item.to}
+              end={item.to === '/'}
+              className={({ isActive }) =>
+                cn(
+                  'flex items-center gap-3 rounded-lg px-3 py-2 text-sm transition-colors',
+                  isActive
+                    ? 'bg-nexus-accent/15 text-nexus-accent font-medium'
+                    : 'text-nexus-muted hover:text-nexus-text hover:bg-white/5',
+                )
+              }

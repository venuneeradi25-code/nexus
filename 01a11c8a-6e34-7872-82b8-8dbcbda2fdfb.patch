+import { useEffect, useState } from 'react'
+import api from '../lib/api'
+import { FileText, Sparkles, Download } from 'lucide-react'
+
+interface Report {
+  date: string
+  peak_population: number
+  peak_crowd_location: string
+  peak_crowd_value: number
+  parking_peak_pct: number
+  major_anomalies: number
+  major_events: number
+  predicted_risks: number
+  alerts_total: number
+  summary: string
+  highlights: string[]
+  recommendations: string[]
+}
+
+export default function Report() {
+  const [report, setReport] = useState<Report | null>(null)
+  const [date, setDate] = useState(new Date().toISOString().slice(0, 10))
+  const [loading, setLoading] = useState(false)
+
+  const load = (d?: string) => {
+    setLoading(true)
+    api.get(`/admin/report/daily${d ? `?date=${d}` : ''}`)
+      .then((r) => setReport(r.data))
+      .catch(() => setReport(null))
+      .finally(() => setLoading(false))
+  }
+  useEffect(() => { load(date) }, [date])
+
+  const download = () => {
+    if (!report) return
+    const text = [
+      'NEXUS — TODAY\'S CAMPUS INTELLIGENCE',
+      '='.repeat(60),
+      `Date: ${report.date}`,
+      '',
+      ...report.highlights.map((h) => `• ${h}`),
+      '',
+      'AI SUMMARY',
+      report.summary,
+      '',
+      'RECOMMENDATIONS',
+      ...report.recommendations.map((r) => `• ${r}`),
+    ].join('\n')
+    const blob = new Blob([text], { type: 'text/plain' })
+    const a = document.createElement('a')
+    a.href = URL.createObjectURL(blob)
+    a.download = `nexus-campus-report-${report.date}.txt`
+    a.click()
+  }
+
+  return (
+    <div className="space-y-6 max-w-4xl">
+      <div className="flex items-center justify-between">
+        <h1 className="text-xl font-bold flex items-center gap-2"><FileText size={20} className="text-nexus-accent" /> Explain My Campus</h1>
+        <div className="flex items-center gap-2">
+          <input type="date" value={date} onChange={(e) => setDate(e.target.value)}
+            className="rounded-lg border border-nexus-border bg-nexus-panel px-3 py-1.5 text-sm" />
+          <button onClick={download} disabled={!report}
+            className="flex items-center gap-2 rounded-lg border border-nexus-border px-3 py-1.5 text-xs font-semibold text-nexus-muted hover:text-nexus-text disabled:opacity-40">
+            <Download size={13} /> Export
+          </button>
+        </div>
+      </div>
+
+      {loading && <div className="text-nexus-muted">Generating AI report…</div>}
+
+      {report && (
+        <div className="glass rounded-2xl border border-nexus-border p-8">
+          <div className="flex items-center gap-3 mb-6">
+            <div className="h-12 w-12 rounded-xl bg-gradient-to-br from-nexus-accent to-nexus-accent2 flex items-center justify-center">
+              <Sparkles className="text-white" />
+            </div>
+            <div>
+              <div className="text-xs uppercase tracking-wider text-nexus-muted">AI-generated daily briefing</div>
+              <div className="text-2xl font-extrabold tracking-wide">TODAY'S CAMPUS INTELLIGENCE</div>
+            </div>
+          </div>
+
+          <div className="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
+            <div className="rounded-xl border border-nexus-border p-4">
+              <div className="text-[10px] uppercase text-nexus-muted">Peak population</div>
+              <div className="font-mono text-2xl font-bold mt-1">{report.peak_population.toLocaleString()}</div>
+            </div>
+            <div className="rounded-xl border border-nexus-border p-4">
+              <div className="text-[10px] uppercase text-nexus-muted">Peak crowd</div>
+              <div className="font-semibold mt-1">{report.peak_crowd_location}</div>
+              <div className="font-mono text-sm text-nexus-muted">{report.peak_crowd_value.toLocaleString()} people</div>
+            </div>
+            <div className="rounded-xl border border-nexus-border p-4">
+              <div className="text-[10px] uppercase text-nexus-muted">Parking peak</div>
+              <div className="font-mono text-2xl font-bold mt-1">{report.parking_peak_pct.toFixed(0)}%</div>
+            </div>
+            <div className="rounded-xl border border-nexus-border p-4">
+              <div className="text-[10px] uppercase text-nexus-muted">Major anomalies</div>
+              <div className="font-mono text-2xl font-bold mt-1 text-nexus-orange">{report.major_anomalies}</div>
+            </div>
+            <div className="rounded-xl border border-nexus-border p-4">
+              <div className="text-[10px] uppercase text-nexus-muted">Major events</div>
+              <div className="font-mono text-2xl font-bold mt-1">{report.major_events}</div>
+            </div>
+            <div className="rounded-xl border border-nexus-border p-4">
+              <div className="text-[10px] uppercase text-nexus-muted">Predicted risks</div>
+              <div className="font-mono text-2xl font-bold mt-1">{report.predicted_risks}</div>
+            </div>
+            <div className="rounded-xl border border-nexus-border p-4">
+              <div className="text-[10px] uppercase text-nexus-muted">Alerts raised</div>
+              <div className="font-mono text-2xl font-bold mt-1">{report.alerts_total}</div>
+            </div>
+            <div className="rounded-xl border border-nexus-border p-4">
+              <div className="text-[10px] uppercase text-nexus-muted">Report date</div>
+              <div className="font-mono text-lg font-bold mt-1">{report.date}</div>
+            </div>
+          </div>
+
+          <div className="rounded-xl border border-nexus-accent/30 bg-nexus-accent/5 p-5 mb-6">
+            <div className="text-xs uppercase tracking-wider text-nexus-accent mb-2">AI Summary</div>
+            <p className="text-sm leading-relaxed">{report.summary}</p>
+          </div>
+
+          <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
+            <div>
+              <div className="text-xs uppercase tracking-wider text-nexus-muted mb-2">Highlights</div>
+              <ul className="space-y-1.5 text-sm">
+                {report.highlights.map((h, i) => (
+                  <li key={i} className="flex items-start gap-2"><span className="text-nexus-accent">•</span>{h}</li>
+                ))}
+              </ul>
+            </div>
+            <div>
+              <div className="text-xs uppercase tracking-wider text-nexus-muted mb-2">Recommendations</div>
+              <ul className="space-y-1.5 text-sm">
+                {report.recommendations.map((r, i) => (
+                  <li key={i} className="flex items-start gap-2"><span className="text-nexus-green">▸</span>{r}</li>
+                ))}
+              </ul>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
+  )
+}
diff --git a/frontend/src/pages/Settings.tsx b/frontend/src/pages/Settings.tsx
new file mode 100644
index 0000000..0841c78
--- /dev/null
+++ b/frontend/src/pages/Settings.tsx
@@ -0,0 +1,132 @@
+import { useEffect, useState } from 'react'
+import api from '../lib/api'
+import { Settings as SettingsIcon, ShieldCheck, FlaskConical, RotateCcw, Camera, CloudRain, Users, Car, Zap, AlertTriangle } from 'lucide-react'
+import { cn } from '../lib/ui'
+
+interface Privacy {
+  anonymous_analytics_only: boolean
+  facial_recognition_enabled: boolean
+  data_retention_days: number
+  store_video_footage: boolean
+  share_data_with_third_parties: boolean
+}
+
+const DEMO_SCENARIOS = [
+  { id: 'CROWD_INCREASE', label: 'Crowd increase', icon: Users, desc: 'Sudden crowd formation at event venues' },
+  { id: 'VEHICLE_INCREASE', label: 'Vehicle increase', icon: Car, desc: 'Surge of incoming vehicles at gates' },
+  { id: 'PARKING_SHORTAGE', label: 'Parking shortage', icon: Car, desc: 'Parking zones approach capacity' },
+  { id: 'EVENT_CROWD', label: 'Event crowd surge', icon: Users, desc: 'Event attendance far above expected' },
+  { id: 'GATE_CLOSURE', label: 'Gate closure', icon: AlertTriangle, desc: 'Close the main gate, reroute traffic' },
+  { id: 'WEATHER_CHANGE', label: 'Weather change', icon: CloudRain, desc: 'Heavy rain during outdoor events' },
+  { id: 'RESOURCE_ANOMALY', label: 'Resource anomaly', icon: Zap, desc: 'Abnormal electricity/water consumption' },
+  { id: 'CAMERA_OFFLINE', label: 'Camera offline', icon: Camera, desc: 'Simulate a camera going offline' },
+]
+
+export default function Settings() {
+  const [privacy, setPrivacy] = useState<Privacy | null>(null)
+  const [activeModifiers, setActiveModifiers] = useState<string[]>([])
+  const [saved, setSaved] = useState(false)
+
+  const loadPrivacy = () => {
+    api.get('/admin/privacy').then((r) => setPrivacy(r.data)).catch(() => {})
+  }
+  const loadDemo = () => {
+    api.get('/demo/status').then((r) => setActiveModifiers(r.data.active_modifiers)).catch(() => {})
+  }
+  useEffect(() => { loadPrivacy(); loadDemo() }, [])
+
+  const savePrivacy = async () => {
+    await api.put('/admin/privacy', privacy)
+    setSaved(true)
+    setTimeout(() => setSaved(false), 2000)
+  }
+
+  const trigger = async (scenario: string) => {
+    await api.post('/demo/trigger', { scenario, duration_minutes: 30, intensity: 1.0 })
+    loadDemo()
+  }
+  const reset = async () => {
+    await api.post('/demo/trigger', { scenario: 'RESET' })
+    loadDemo()
+  }
+
+  return (
+    <div className="space-y-6 max-w-5xl">
+      <h1 className="text-xl font-bold flex items-center gap-2"><SettingsIcon size={20} className="text-nexus-accent" /> Settings & Privacy</h1>
+
+      {/* privacy */}
+      <div className="glass rounded-xl border border-nexus-border p-6">
+        <h3 className="text-sm font-semibold mb-1 flex items-center gap-2"><ShieldCheck size={15} className="text-nexus-green" /> Privacy-first design</h3>
+        <p className="text-xs text-nexus-muted mb-4">
+          NEXUS uses anonymous analytics only: counting, movement patterns, crowd density and vehicle
+          detection. No facial recognition. No individual student identification.
+        </p>
+        {privacy && (
+          <div className="space-y-4">
+            <Toggle label="Anonymous analytics only" desc="Only aggregate counts and patterns are stored — never identities."
+              checked={privacy.anonymous_analytics_only} onChange={(v) => setPrivacy({ ...privacy, anonymous_analytics_only: v })} />
+            <Toggle label="Facial recognition" desc="Disabled by design. NEXUS does not identify individuals."
+              checked={privacy.facial_recognition_enabled} onChange={(v) => setPrivacy({ ...privacy, facial_recognition_enabled: v })} />
+            <Toggle label="Store video footage" desc="Raw footage is processed in real time and discarded; only analytics are kept."
+              checked={privacy.store_video_footage} onChange={(v) => setPrivacy({ ...privacy, store_video_footage: v })} />
+            <Toggle label="Share data with third parties" desc="Campus data never leaves the NEXUS platform."
+              checked={privacy.share_data_with_third_parties} onChange={(v) => setPrivacy({ ...privacy, share_data_with_third_parties: v })} />
+            <div className="flex items-center gap-3">
+              <label className="text-sm">Data retention (days)</label>
+              <input type="number" min={1} max={365} value={privacy.data_retention_days}
+                onChange={(e) => setPrivacy({ ...privacy, data_retention_days: Number(e.target.value) })}
+                className="w-24 rounded-lg border border-nexus-border bg-nexus-panel px-3 py-1.5 text-sm font-mono" />
+            </div>
+            <button onClick={savePrivacy}
+              className="rounded-lg bg-nexus-accent/20 border border-nexus-accent/40 px-4 py-2 text-sm font-semibold text-nexus-accent hover:bg-nexus-accent/30">
+              {saved ? '✓ Saved' : 'Save privacy settings'}
+            </button>
+          </div>
+        )}
+      </div>
+
+      {/* demo mode */}
+      <div className="glass rounded-xl border border-nexus-border p-6">
+        <h3 className="text-sm font-semibold mb-1 flex items-center gap-2"><FlaskConical size={15} className="text-nexus-yellow" /> Demo Mode — simulated cameras & scenarios</h3>
+        <p className="text-xs text-nexus-muted mb-4">
+          The complete system runs without physical CCTV hardware. CAM-001…CAM-005 are simulated cameras
+          generating realistic data. Trigger scenarios to watch the AI detect, predict and recommend in real time.
+        </p>
+        <div className="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
+          {DEMO_SCENARIOS.map((s) => (
+            <button key={s.id} onClick={() => trigger(s.id)}
+              className={cn('rounded-xl border p-4 text-left transition-colors hover:border-nexus-accent/50',
+                activeModifiers.includes(s.id) ? 'border-nexus-green bg-nexus-green/10' : 'border-nexus-border')}>
+              <div className="flex items-center gap-2 font-semibold text-sm">
+                <s.icon size={15} className="text-nexus-accent" /> {s.label}
+              </div>
+              <div className="text-[11px] text-nexus-muted mt-1">{s.desc}</div>
+              {activeModifiers.includes(s.id) && <div className="text-[10px] text-nexus-green mt-1 font-semibold">● ACTIVE</div>}
+            </button>
+          ))}
+        </div>
+        <button onClick={reset}
+          className="flex items-center gap-2 rounded-lg border border-nexus-red/40 bg-nexus-red/10 px-4 py-2 text-sm font-semibold text-nexus-red hover:bg-nexus-red/20">
+          <RotateCcw size={14} /> Reset all scenarios
+        </button>
+      </div>
+    </div>
+  )
+}
+
+function Toggle({ label, desc, checked, onChange }: { label: string; desc: string; checked: boolean; onChange: (v: boolean) => void }) {
+  return (
+    <div className="flex items-center justify-between rounded-lg border border-nexus-border p-3">
+      <div>
+        <div className="text-sm font-medium">{label}</div>
+        <div className="text-xs text-nexus-muted">{desc}</div>
+      </div>
+      <button onClick={() => onChange(!checked)}
+        className={cn('h-6 w-11 rounded-full border transition-colors relative',
+          checked ? 'bg-nexus-accent/40 border-nexus-accent' : 'bg-nexus-border border-nexus-border')}>
+        <span className={cn('absolute top-0.5 h-4 w-4 rounded-full bg-white transition-all',
+          checked ? 'left-5' : 'left-0.5')} />
+      </button>
+    </div>
+  )
+}

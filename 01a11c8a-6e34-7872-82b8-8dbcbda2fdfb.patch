+"""NEXUS AI Processing Service — separate microservice for computer vision.
+
+The main backend (FastAPI) handles auth, database, digital twin state and
+WebSockets. Heavy AI work (video / image analytics) runs HERE, in its own
+process, and is consumed by the backend over HTTP.
+
+Endpoints:
+  GET  /health
+  POST /analyze/video   — multipart video upload -> person/vehicle/crowd analytics
+  POST /analyze/image   — multipart image upload -> single-frame analytics
+"""
+import importlib.util
+import logging
+import os
+from pathlib import Path
+
+from fastapi import FastAPI, File, HTTPException, UploadFile
+from fastapi.middleware.cors import CORSMiddleware
+
+
+def _load_vision():
+    """Load the shared vision implementation (backend/app/ai/vision.py) directly
+    by path, so this service's own `app` package does not shadow the backend's."""
+    path = Path(__file__).resolve().parents[2] / "backend" / "app" / "ai" / "vision.py"
+    spec = importlib.util.spec_from_file_location("nexus_vision", path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+vision = _load_vision()
+
+logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s [ai-service] %(message)s")
+logger = logging.getLogger("nexus.ai-service")
+
+app = FastAPI(title="NEXUS AI Processing Service", version="1.0.0")
+app.add_middleware(CORSMiddleware, allow_origins=["*"], allow_methods=["*"],
+                   allow_headers=["*"])
+
+
+@app.get("/")
+def root():
+    return {"service": "NEXUS AI Processing Service",
+            "detector": "YOLOv8" if vision._YOLO is not None else "OpenCV Haar + MOG2",
+            "privacy": "anonymous analytics only — no facial recognition"}
+
+
+@app.get("/health")
+def health():
+    return {"status": "ok", "detector": "YOLOv8" if vision._YOLO is not None
+            else "OpenCV Haar + MOG2"}
+
+
+@app.post("/analyze/video")
+async def analyze_video(file: UploadFile = File(...)):
+    data = await file.read()
+    if not data:
+        raise HTTPException(400, "Empty upload")
+    logger.info("Analyzing video upload: %s (%d bytes)", file.filename, len(data))
+    try:
+        return vision.analyze_upload(data, ".mp4")
+    except Exception as e:
+        logger.exception("video analysis failed")
+        raise HTTPException(422, f"Analysis failed: {e}")
+
+
+@app.post("/analyze/image")
+async def analyze_image(file: UploadFile = File(...)):
+    data = await file.read()
+    if not data:
+        raise HTTPException(400, "Empty upload")
+    logger.info("Analyzing image upload: %s (%d bytes)", file.filename, len(data))
+    try:
+        return vision.analyze_upload(data, ".jpg")
+    except Exception as e:
+        logger.exception("image analysis failed")
+        raise HTTPException(422, f"Analysis failed: {e}")
+
+
+if __name__ == "__main__":
+    import uvicorn
+    port = int(os.environ.get("AI_SERVICE_PORT", "8001"))
+    uvicorn.run(app, host="0.0.0.0", port=port)

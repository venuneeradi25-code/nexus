+++ b/backend/app/routers/live.py
@@ -0,0 +1,199 @@
+"""Live digital-twin data: dashboard snapshot, crowd, parking, events, traffic,
+environment, resources."""
+from datetime import datetime, timedelta
+
+from fastapi import APIRouter, Depends
+from sqlalchemy import func
+from sqlalchemy.orm import Session
+
+from .. import models as m
+from ..ai.engine import engine
+from ..database import get_db
+from ..dependencies import get_current_user
+from ..models import User
+from ..schemas import (CampusMetricOut, CrowdRecordOut, DashboardSnapshot,
+                       EnvironmentalOut, EventOut, ParkingZoneOut, ResourceUsageOut,
+                       RiskBreakdown, TrafficRecordOut, VehicleRecordOut, ZoneLiveState)
+
+router = APIRouter(prefix="/api", tags=["live"])
+
+
+@router.get("/dashboard", response_model=DashboardSnapshot)
+def dashboard(db: Session = Depends(get_db), user: User = Depends(get_current_user)):
+    return engine.snapshot(db)
+
+
+# ------------------------------------------------------------------ crowd ---
+@router.get("/crowd/zones", response_model=list[ZoneLiveState])
+def crowd_zones(user: User = Depends(get_current_user)):
+    zones = []
+    for z in engine.zones.values():
+        occ = 100.0 * z["people"] / max(z["capacity"], 1)
+        zones.append(ZoneLiveState(
+            zone_id=z["zone_id"], name=z["name"], type=z["type"], people=z["people"],
+            density=z["density"], growth_rate=round(z["growth_rate"], 1),
+            capacity=z["capacity"], occupancy_pct=round(occ, 1),
+            vehicles_in=z["vehicles_in"], vehicles_out=z["vehicles_out"],
+            restricted=z["restricted"], x=z["x"], y=z["y"],
+            width=z["width"], height=z["height"]))
+    return zones
+
+
+@router.get("/crowd/records", response_model=list[CrowdRecordOut])
+def crowd_records(zone_id: int | None = None, hours: int = 24, limit: int = 500,
+                  db: Session = Depends(get_db), user: User = Depends(get_current_user)):
+    since = datetime.now() - timedelta(hours=hours)
+    q = db.query(m.CrowdRecord).filter(m.CrowdRecord.timestamp >= since)
+    if zone_id:
+        q = q.filter(m.CrowdRecord.zone_id == zone_id)
+    rows = q.order_by(m.CrowdRecord.id.desc()).limit(limit).all()
+    return [CrowdRecordOut.model_validate(r) for r in reversed(rows)]
+
+
+@router.get("/crowd/predict")
+def crowd_predict(zone_id: int | None = None, horizon: int = 30,
+                  user: User = Depends(get_current_user)):
+    """AI crowd growth prediction for each zone (or one zone)."""
+    out = []
+    now_min = datetime.now().timestamp() / 60.0
+    from ..ai.predictor import predict_value
+    zones = [engine.zones[zone_id]] if zone_id else list(engine.zones.values())
+    for z in zones:
+        series = [(now_min - x, v) for x, v in engine.crowd_series.get(z["zone_id"], [])]
+        window = [p for p in series if 0 <= p[0] <= 30]
+        if len(window) < 5:
+            continue
+        p20, c20 = predict_value(window, 20, cap=z["capacity"])
+        p30, c30 = predict_value(window, 30, cap=z["capacity"])
+        out.append({
+            "zone_id": z["zone_id"], "name": z["name"], "current": z["people"],
+            "predicted_20min": p20, "predicted_30min": p30,
+            "growth_rate_per_10min": round(z["growth_rate"], 1),
+            "density": z["density"], "capacity": z["capacity"],
+            "confidence_30min": c30,
+            "warning": p30 >= z["capacity"] * 0.9,
+        })
+    return {"horizon_minutes": horizon, "predictions": out}
+
+
+# ---------------------------------------------------------------- vehicles --
+@router.get("/vehicles/records", response_model=list[VehicleRecordOut])
+def vehicle_records(hours: int = 24, limit: int = 300, db: Session = Depends(get_db),

+"""NEXUS backend configuration."""
+from functools import lru_cache
+
+from pydantic_settings import BaseSettings
+
+
+class Settings(BaseSettings):
+    APP_NAME: str = "NEXUS"
+    APP_TAGLINE: str = "Understand the present. Simulate the future. Prevent the unexpected."
+    VERSION: str = "1.0.0"
+
+    # Database (PostgreSQL in production, SQLite for local demo)
+    DATABASE_URL: str = "sqlite:///./nexus.db"
+
+    # Auth
+    JWT_SECRET: str = "nexus-dev-secret-change-in-production"
+    JWT_ALGORITHM: str = "HS256"
+    ACCESS_TOKEN_EXPIRE_MINUTES: int = 240
+
+    # AI processing microservice (kept separate from the main backend)
+    AI_SERVICE_URL: str = "http://localhost:8001"
+
+    # Demo mode (simulated cameras + generated data, no CCTV hardware required)
+    DEMO_MODE: bool = True
+    TICK_SECONDS: float = 3.0
+
+    # History / retention (days) for analytics & replay
+    HISTORY_DAYS: int = 30
+
+    CORS_ORIGINS: str = "*"
+
+    class Config:
+        env_file = ".env"
+        extra = "ignore"
+
+
+@lru_cache
+def get_settings() -> Settings:
+    return Settings()

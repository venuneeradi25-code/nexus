@@ -0,0 +1,101 @@
+import { useEffect, useState } from 'react'
+import api from '../lib/api'
+import type { Alert } from '../lib/types'
+import { SeverityBadge } from '../components/Badges'
+import { Bell, Check, CheckCheck, Filter } from 'lucide-react'
+import { timeAgo } from '../lib/ui'
+
+export default function Alerts() {
+  const [alerts, setAlerts] = useState<Alert[]>([])
+  const [filter, setFilter] = useState('ACTIVE')
+
+  const load = () => {
+    api.get(`/alerts?status=${filter}&limit=200`).then((r) => setAlerts(r.data)).catch(() => {})
+  }
+  useEffect(load, [filter])
+  useEffect(() => { const t = setInterval(load, 8000); return () => clearInterval(t) }, [filter])
+
+  const act = async (id: number, action: 'acknowledge' | 'resolve') => {
+    await api.post(`/alerts/${id}/${action}`)
+    load()
+  }
+
+  const counts = {
+    ACTIVE: alerts.filter((a) => a.status === 'ACTIVE').length,
+    CRITICAL: alerts.filter((a) => a.severity === 'CRITICAL').length,
+    TOTAL: alerts.length,
+  }
+
+  return (
+    <div className="space-y-6">
+      <div className="flex items-center justify-between">
+        <h1 className="text-xl font-bold flex items-center gap-2"><Bell size={20} className="text-nexus-accent" /> Smart Alert System</h1>
+        <div className="flex items-center gap-2">
+          <Filter size={14} className="text-nexus-muted" />
+          {['ACTIVE', 'ALL', 'ACKNOWLEDGED', 'RESOLVED'].map((f) => (
+            <button key={f} onClick={() => setFilter(f)}
+              className={`rounded-lg border px-3 py-1.5 text-xs font-semibold ${filter === f ? 'border-nexus-accent bg-nexus-accent/15 text-nexus-accent' : 'border-nexus-border text-nexus-muted'}`}>
+              {f}
+            </button>
+          ))}
+        </div>
+      </div>
+
+      <div className="grid grid-cols-3 gap-3">
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase text-nexus-muted">Active alerts</div>
+          <div className="text-3xl font-bold font-mono mt-1 text-nexus-orange">{counts.ACTIVE}</div>
+        </div>
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase text-nexus-muted">Critical</div>
+          <div className="text-3xl font-bold font-mono mt-1 text-nexus-red">{counts.CRITICAL}</div>
+        </div>
+        <div className="glass rounded-xl p-4 border border-nexus-border">
+          <div className="text-xs uppercase text-nexus-muted">Total (filter)</div>
+          <div className="text-3xl font-bold font-mono mt-1">{counts.TOTAL}</div>
+        </div>
+      </div>
+
+      <div className="space-y-3">
+        {alerts.length === 0 && <div className="glass rounded-xl border border-nexus-border p-8 text-center text-nexus-muted">No alerts for this filter.</div>}
+        {alerts.map((a) => (
+          <div key={a.id} className={`glass rounded-xl border p-4 ${a.status === 'ACTIVE' ? 'border-nexus-orange/30' : 'border-nexus-border opacity-75'}`}>
+            <div className="flex items-start justify-between gap-4">
+              <div className="flex-1">
+                <div className="flex items-center gap-2 mb-1 flex-wrap">
+                  <span className="font-semibold">{a.alert_type.replace(/_/g, ' ')}</span>
+                  <SeverityBadge severity={a.severity} />
+                  <span className={`text-[10px] px-2 py-0.5 rounded-full border ${a.status === 'ACTIVE' ? 'text-nexus-orange border-nexus-orange/40' : a.status === 'ACKNOWLEDGED' ? 'text-nexus-yellow border-nexus-yellow/40' : 'text-nexus-green border-nexus-green/40'}`}>
+                    {a.status}
+                  </span>
+                </div>
+                <div className="text-xs text-nexus-muted mb-2">
+                  📍 {a.location} · 🕐 {timeAgo(a.created_at)} ({new Date(a.created_at).toLocaleString()})
+                </div>
+                <div className="text-sm mb-2"><span className="text-nexus-muted text-xs uppercase">Reason: </span>{a.reason}</div>
+                {a.ai_prediction && (
+                  <div className="text-sm mb-2"><span className="text-nexus-muted text-xs uppercase">AI prediction: </span><span className="text-nexus-yellow">{a.ai_prediction}</span></div>
+                )}
+                {a.recommended_action && (
+                  <div className="text-sm"><span className="text-nexus-muted text-xs uppercase">Recommended action: </span><span className="text-nexus-green">{a.recommended_action}</span></div>
+                )}
+              </div>
+              {a.status === 'ACTIVE' && (
+                <div className="flex flex-col gap-2 shrink-0">
+                  <button onClick={() => act(a.id, 'acknowledge')}
+                    className="flex items-center gap-1.5 rounded-lg border border-nexus-yellow/40 bg-nexus-yellow/10 px-3 py-1.5 text-xs font-semibold text-nexus-yellow hover:bg-nexus-yellow/20">
+                    <Check size={12} /> Acknowledge
+                  </button>
+                  <button onClick={() => act(a.id, 'resolve')}
+                    className="flex items-center gap-1.5 rounded-lg border border-nexus-green/40 bg-nexus-green/10 px-3 py-1.5 text-xs font-semibold text-nexus-green hover:bg-nexus-green/20">
+                    <CheckCheck size={12} /> Resolve
+                  </button>
+                </div>
+              )}
+            </div>
+          </div>
+        ))}
+      </div>
+    </div>
+  )
+}

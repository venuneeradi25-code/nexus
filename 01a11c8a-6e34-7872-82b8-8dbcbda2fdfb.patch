+"""NEXUS database seed: demo users, campus map, cameras, parking, events and
+30 days of historical data used to teach the anomaly detector what 'normal' is.
+
+Idempotent: does nothing if users already exist.
+
+Demo credentials (override with NEXUS_ADMIN_PASSWORD etc. in production):
+  superadmin@nexus.ai / Nexus@2026   (SUPER_ADMIN)
+  admin@nexus.ai      / Nexus@2026   (CAMPUS_ADMIN)
+  security@nexus.ai   / Nexus@2026   (SECURITY_ADMIN)
+  event@nexus.ai      / Nexus@2026   (EVENT_ADMIN)
+"""
+from __future__ import annotations
+
+import logging
+import random
+from datetime import datetime, timedelta
+
+from sqlalchemy.orm import Session
+
+from app import models as m
+from app.ai import curves
+from app.config import get_settings
+from app.security import hash_password
+
+logger = logging.getLogger("nexus.seed")
+settings = get_settings()
+
+BUILDINGS = [
+    # name, type, floors, description, x, y, w, h
+    ("Engineering Block", "ACADEMIC", 4, "Main engineering departments", 60, 80, 180, 120),
+    ("Admin Block", "ADMIN", 3, "Administration offices", 280, 80, 140, 100),
+    ("Central Library", "AMENITY", 3, "24x7 central library", 460, 80, 160, 110),
+    ("Cafeteria", "AMENITY", 1, "Main campus cafeteria", 660, 80, 150, 110),
+    ("Science Block", "ACADEMIC", 5, "Physics, chemistry, biology labs", 60, 260, 150, 110),
+    ("Auditorium", "VENUE", 1, "900-seat auditorium", 250, 240, 170, 130),
+    ("Sports Complex", "SPORTS", 1, "Indoor sports hall", 460, 260, 170, 130),
+    ("Open Ground", "VENUE", 0, "Outdoor event venue (2000 capacity)", 680, 240, 180, 150),
+    ("Transport Hub", "TRANSPORT", 1, "Bus bay and shuttle stop", 880, 440, 100, 80),
+]
+
+ZONES = [
+    # name, type, building idx, capacity, restricted, x, y, w, h
+    ("Main Gate", "GATE", None, 400, False, 40, 430, 110, 60),
+    ("North Gate", "GATE", None, 250, False, 430, 25, 100, 50),
+    ("East Gate", "GATE", None, 250, False, 885, 250, 90, 60),
+    ("Auditorium Hall", "AUDITORIUM", 5, 900, False, 250, 240, 170, 130),
+    ("Cafeteria", "CAFETERIA", 3, 350, False, 660, 80, 150, 110),
+    ("Central Library", "LIBRARY", 2, 500, False, 460, 80, 160, 110),
+    ("Sports Complex", "SPORTS", 6, 800, False, 460, 260, 170, 130),
+    ("Open Ground", "VENUE", 7, 2000, False, 680, 240, 180, 150),
+    ("Central Road", "ROAD", None, 300, False, 180, 400, 480, 50),
+    ("Server Zone", "RESTRICTED", None, 10, True, 60, 520, 100, 70),
+    ("Transport Hub", "TRANSPORT", 8, 300, False, 880, 440, 100, 80),
+]
+
+CAMERAS = [
+    ("CAM-001", "Main Gate Camera", "Main Gate", "Main Gate"),
+    ("CAM-002", "Auditorium Camera", "Auditorium Hall", "Auditorium Hall"),
+    ("CAM-003", "Parking Camera", "Parking Zone A", "Parking Zone A"),
+    ("CAM-004", "Main Road Camera", "Central Road", "Central Road"),
+    ("CAM-005", "Sports Area Camera", "Sports Complex", "Sports Complex"),
+]
+
+PARKING = [
+    # name, type, total_slots, x, y, w, h
+    ("Parking Zone A", "STUDENT", 150, 220, 520, 130, 80),
+    ("Parking Zone B", "FACULTY", 120, 370, 520, 130, 80),
+    ("Parking Zone C", "VISITOR", 100, 520, 520, 130, 80),
+    ("Parking Zone D", "TWO_WHEELER", 250, 670, 520, 190, 80),
+    ("Parking Zone E", "FOUR_WHEELER", 90, 880, 540, 100, 70),
+]
+
+USERS = [
+    ("superadmin", "superadmin@nexus.ai", "SUPER_ADMIN"),
+    ("admin", "admin@nexus.ai", "CAMPUS_ADMIN"),
+    ("security", "security@nexus.ai", "SECURITY_ADMIN"),
+    ("eventadmin", "event@nexus.ai", "EVENT_ADMIN"),
+]
+
+
+def run(db: Session):
+    rng = random.Random(7)
+    now = datetime.now()
+
+    # ---------------- users ----------------
+    for username, email, role in USERS:
+        db.add(m.User(username=username, email=email,
+                      hashed_password=hash_password("Nexus@2026"),
+                      role=m.Role(role)))
+
+    # ---------------- buildings & zones ----------------
+    buildings = []
+    for name, btype, floors, desc, x, y, w, h in BUILDINGS:
+        b = m.Building(name=name, type=btype, floors=floors, description=desc,
+                       x=x, y=y, width=w, height=h)
+        db.add(b)
+        buildings.append(b)
+    db.flush()
+    zones = []
+    for name, ztype, b_idx, cap, restricted, x, y, w, h in ZONES:
+        z = m.Zone(name=name, type=m.ZoneType(ztype),
+                   building_id=buildings[b_idx].id if b_idx is not None else None,
+                   capacity=cap, restricted=restricted, description=name,
+                   x=x, y=y, width=w, height=h)
+        db.add(z)
+        zones.append(z)
+    db.flush()
+    zone_by_name = {z.name: z for z in zones}
+
+    # ---------------- cameras ----------------
+    for cam_id, name, location, zone_name in CAMERAS:
+        db.add(m.Camera(camera_id=cam_id, name=name, location=location,
+                        zone_id=zone_by_name[zone_name].id if zone_name in zone_by_name else None,
+                        status=m.CameraStatus.ONLINE, ai_status="RUNNING",
+                        fps=25.0, source_type=m.SourceType.SIMULATED,
+                        stream_url=""))
+    db.flush()
+
+    # ---------------- parking zones + slots ----------------
+    for name, ptype, total, x, y, w, h in PARKING:
+        pz = m.ParkingZone(name=name, type=m.ParkingType(ptype), total_slots=total,
+                           x=x, y=y, width=w if w else 110, height=h if h else 70)
+        db.add(pz)
+        db.flush()
+        # seed slots at the current realistic occupancy
+        frac = curves.parking_occupancy_fraction(curves.hour_float(now), now.weekday() >= 5)
+        occupied_target = int(total * frac)
+        for i in range(1, total + 1):
+            occ = i <= occupied_target
+            db.add(m.ParkingSlot(zone_id=pz.id, slot_number=f"{name[-1]}-{i:03d}",
+                                 occupied=occ,
+                                 vehicle_type=("BIKE" if ptype == "TWO_WHEELER"
+                                               else rng.choice(["CAR", "CAR", "CAR", "BIKE"]))))
+    db.flush()
+
+    # ---------------- events (today) ----------------
+    today = now.replace(hour=0, minute=0, second=0, microsecond=0)
+    db.add(m.Event(
+        name="TECHNOVA 2026", venue="Open Ground", zone_id=zone_by_name["Open Ground"].id,
+        expected_attendance=1200, current_crowd=0, predicted_peak=0, capacity=1500,
+        risk_level=m.RiskLevel.NORMAL,
+        status=m.EventStatus.LIVE if now.hour >= 17 else m.EventStatus.SCHEDULED,
+        start_time=today + timedelta(hours=17), end_time=today + timedelta(hours=21),
+        description="Annual technical festival — keynotes, robotics expo, live performances."))
+    db.add(m.Event(
+        name="Research Symposium", venue="Auditorium Hall",
+        zone_id=zone_by_name["Auditorium Hall"].id,
+        expected_attendance=400, current_crowd=0, predicted_peak=0, capacity=900,
+        risk_level=m.RiskLevel.NORMAL,
+        status=(m.EventStatus.LIVE if 10 <= now.hour < 12 else
+                m.EventStatus.ENDED if now.hour >= 12 else m.EventStatus.SCHEDULED),
+        start_time=today + timedelta(hours=10), end_time=today + timedelta(hours=12),
+        description="Inter-departmental research paper presentations."))
+    db.flush()
+
+    # ---------------- 30 days of history ----------------
+    _seed_history(db, rng, zones, now)
+
+    db.commit()
+    logger.info("Seed complete: %d zones, %d cameras, %d parking zones",
+                len(zones), len(CAMERAS), len(PARKING))
+
+
+def _seed_history(db: Session, rng: random.Random, zones, now: datetime):
+    days = settings.HISTORY_DAYS
+    event_zone_names = {"Open Ground", "Auditorium Hall"}
+    for d in range(days, 0, -1):
+        day = (now - timedelta(days=d)).replace(minute=0, second=0, microsecond=0)
+        weekend = day.weekday() >= 5
+        event_day = (now - timedelta(days=d)).date() == now.date()
+        for h in range(24):
+            ts = day + timedelta(hours=h)
+            hf = curves.hour_float(ts)
+            total_pop = 0
+            # crowd records at 15-minute resolution (rich enough for prediction
+            # backtests and baseline learning; other tables stay hourly)
+            for mi in (0, 15, 30, 45):
+                ts_q = ts + timedelta(minutes=mi)
+                hf_q = curves.hour_float(ts_q)
+                for z in zones:
+                    frac = curves.crowd_fraction(z.type.value, hf_q, weekend)
+                    if event_day and z.name in event_zone_names:
+                        frac += curves.event_attendance_fraction(
+                            17 if z.name == "Open Ground" else 10,
+                            21 if z.name == "Open Ground" else 12, hf_q) * 0.6
+                    people = max(0, int(frac * z.capacity * rng.uniform(0.85, 1.15)))
+                    if mi == 0:
+                        total_pop += people
+                    db.add(m.CrowdRecord(zone_id=z.id, people_count=people,
+                                         density=m.Density(
+                                             "CRITICAL" if people > 0.9 * z.capacity else
+                                             "HIGH" if people > 0.7 * z.capacity else
+                                             "MEDIUM" if people > 0.4 * z.capacity else "LOW"),
+                                         growth_rate=0.0, timestamp=ts_q))
+            park_occ = curves.parking_occupancy_fraction(hf, weekend, event_day) * 100
+            traffic_status = "MODERATE"
+            db.add(m.CampusMetric(
+                total_population=total_pop, peak_crowd_location="",
+                parking_occupancy_pct=round(park_occ * rng.uniform(0.9, 1.1), 1),
+                traffic_status=traffic_status, risk_score=rng.randint(5, 30),
+                risk_level="NORMAL", active_alerts=0,
+                active_events=1 if event_day else 0, weather="SUNNY", timestamp=ts))
+            for gate, scale in (("Main Gate", 1.0), ("North Gate", 0.65), ("East Gate", 0.75)):
+                inc = curves.gate_incoming_per_min(hf, weekend) * scale
+                out = curves.gate_outgoing_per_min(hf, weekend) * scale
+                db.add(m.TrafficRecord(
+                    location=gate, incoming=int(inc), outgoing=int(out),
+                    congestion=m.Congestion(
+                        "CRITICAL" if inc > 220 else "HIGH" if inc > 160 else
+                        "MODERATE" if inc > 100 else "LOW"), timestamp=ts))
+            load = min(1.0, total_pop / 6000.0)
+            for rtype, val, unit in (
+                    ("ELECTRICITY", curves.electricity_kw(hf, load), "kW"),
+                    ("WATER", curves.water_liters_per_hour(hf, load), "L/h"),
+                    ("WASTE", curves.waste_kg_per_hour(hf, load), "kg/h"),
+                    ("TRANSPORT", curves.transport_trips_per_hour(hf), "trips/h")):
+                db.add(m.ResourceUsage(resource_type=rtype,
+                                       value=round(val * rng.uniform(0.9, 1.1), 1),
+                                       unit=unit, timestamp=ts))
+            if d <= 7:  # keep recent environment history only
+                db.add(m.EnvironmentalData(
+                    temperature=round(curves.temperature_c(hf), 1),
+                    humidity=round(55 + rng.uniform(-10, 10), 1),
+                    condition=m.WeatherCondition.SUNNY,
+                    rain_probability=10.0, air_quality=round(45 + rng.uniform(-8, 8), 1),
+                    timestamp=ts))
+    # a few historical camera events
+    cams = db.query(m.Camera).all()
+    for i in range(200):
+        cam = rng.choice(cams)
+        ts = now - timedelta(hours=rng.uniform(0, 48))
+        db.add(m.CameraEvent(
+            camera_id=cam.id, event_type=rng.choice(["PERSON", "VEHICLE", "MOTION"]),
+            count=rng.randint(1, 40), confidence=round(rng.uniform(0.8, 0.99), 2),
+            details={"source": "history"}, timestamp=ts))
+    db.commit()

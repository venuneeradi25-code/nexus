index 0000000..da99bbe
--- /dev/null
+++ b/backend/app/ai/whatif.py
@@ -0,0 +1,377 @@
+"""WHAT-IF Simulation Engine — the signature NEXUS feature.
+
+Simulates hypothetical administrative decisions against the digital twin:
+
+  GATE_CLOSURE         - close a gate, redistribute traffic, measure congestion
+  EVENT_CROWD          - change expected event attendance, measure overflow risk
+  PARKING_UNAVAILABLE  - take a parking zone offline, redistribute demand
+  EVENT_EXTENSION      - extend an event, measure evening-peak shift
+  VEHICLE_SURGE        - change incoming vehicle volume
+  WEATHER_CHANGE       - change weather, measure event disruption risk
+
+Every scenario returns a CURRENT vs SIMULATED comparison plus AI recommendations.
+"""
+from __future__ import annotations
+
+import math
+from datetime import datetime
+from typing import Any
+
+from .predictor import linear_fit, minutes_to_threshold
+from .risk import compute_risk
+
+SCENARIOS = {
+    "GATE_CLOSURE": "What happens if a campus gate is closed?",
+    "EVENT_CROWD": "What happens if an event attracts more people?",
+    "PARKING_UNAVAILABLE": "What happens if a parking zone becomes unavailable?",
+    "EVENT_EXTENSION": "What happens if the event is extended?",
+    "VEHICLE_SURGE": "What happens if more vehicles arrive?",
+    "WEATHER_CHANGE": "What happens if the weather changes?",
+}
+
+
+def _simulate_gate_closure(snapshot: dict, params: dict) -> dict:
+    gate = params.get("gate", "Main Gate")
+    gates = snapshot["traffic"]  # list of {location, incoming, outgoing, congestion}
+    closed = next((g for g in gates if gate.lower() in g["location"].lower()), None)
+    if not closed:
+        closed = gates[0] if gates else {"location": gate, "incoming": 120, "outgoing": 80}
+    others = [g for g in gates if g is not closed]
+    displaced = closed.get("incoming", 120) + closed.get("outgoing", 80)
+    share = 1.0 / max(len(others), 1)
+
+    simulated_traffic = []
+    for g in others:
+        new_in = g.get("incoming", 90) + displaced * share * 0.6
+        new_out = g.get("outgoing", 70) + displaced * share * 0.4
+        simulated_traffic.append({
+            **g, "incoming": round(new_in), "outgoing": round(new_out),
+            "congestion": _congestion(new_in),
+        })
+    simulated_traffic.append({**closed, "incoming": 0, "outgoing": 0, "congestion": "CLOSED"})
+
+    worst = max((g["incoming"] for g in simulated_traffic), default=0)
+    total_in = sum(g["incoming"] for g in simulated_traffic)
+    parking_delta = round(displaced * share * 0.25)  # % points of extra parking demand
+    crowd_delta = round(displaced * 0.35)
+
+    recs = []
+    high_gates = [g["location"] for g in simulated_traffic if g["congestion"] in ("HIGH", "CRITICAL")]
+    if high_gates:
+        recs.append(
+            f"Open an additional lane / staff at {', '.join(high_gates)} — congestion predicted "
+            f"to reach HIGH after '{gate}' closes."
+        )
+    if others:
+        busiest = max(others, key=lambda g: g.get("incoming", 0))
+        pct = round(100 * (displaced * share * 0.6) / max(busiest.get("incoming", 1), 1))
+        recs.append(
+            f"Redirect approximately {min(pct, 60)}% of incoming traffic from '{gate}' "
+            f"toward '{busiest['location']}'."
+        )
+    recs.append("Activate digital signage at approach roads and notify the transport desk.")
+    recs.append("Monitor Parking Zone occupancy — demand may rise ~%d%% in the next 30 minutes." % max(parking_delta, 5))
+
+    return {
+        "title": f"Scenario: {gate} Closed",
+        "current": {"traffic": gates},
+        "simulated": {
+            "traffic": simulated_traffic,
+            "displaced_flow_per_min": round(displaced),
+            "total_incoming_per_min": round(total_in),
+            "worst_gate_congestion": _congestion(worst),
+        },
+        "impact": {
+            "traffic": f"Gate 2/3 congestion rises; worst gate reaches {_congestion(worst)}",
+            "parking_demand_delta_pct": max(parking_delta, 5),
+            "crowd_delta_people": crowd_delta,
+            "risk_delta": 12,
+        },
+        "recommendations": recs,
+    }
+
+
+def _simulate_event_crowd(snapshot: dict, params: dict) -> dict:
+    event_name = params.get("event", "Main Event")
+    event = next((e for e in snapshot["events"] if event_name.lower() in e["name"].lower()),
+                 snapshot["events"][0] if snapshot["events"] else None)
+    if not event:
+        event = {"name": event_name, "current_crowd": 800, "expected_attendance": 1000,
+                 "capacity": 1500, "predicted_peak": 1100, "venue": "Auditorium"}
+    multiplier = float(params.get("multiplier", 1.0))
+    extra = int(params.get("extra_people", 0))
+    sim_attendance = int(event["expected_attendance"] * multiplier + extra)
+    current = int(event["current_crowd"])
+    capacity = max(event["capacity"], 1)
+
+    # growth model: current growth continues, scaled by attendance pressure
+    series = snapshot.get("event_series", {}).get(event["name"], [])
+    slope, intercept = linear_fit(series) if len(series) >= 2 else (4.0, current)
+    projected_peak = max(int(current + slope * 24), int(sim_attendance * 0.92))
+    breach = projected_peak > capacity
+    breach_minutes = None
+    if breach and slope > 0:
+        breach_minutes = int((capacity - current) / slope)
+
+    # secondary impacts
+    vehicles_per_1000 = 180  # cars per 1000 attendees (campus norm)
+    extra_vehicles = round((sim_attendance - event["expected_attendance"]) * vehicles_per_1000 / 1000)
+    parking_pressure = round(min(extra_vehicles / 4.0, 25))  # % points
+    crowd_delta = sim_attendance - event["expected_attendance"]
+
+    recs = []
+    if breach:
+        recs.append(
+            f"OVERFLOW RISK: predicted peak {projected_peak:,} exceeds capacity {capacity:,}"
+            + (f" in ~{breach_minutes} minutes." if breach_minutes else ".")
+        )
+        recs.append("Open an overflow lawn with live screening and a secondary entry gate.")
+        recs.append("Deploy crowd marshals at all venue exits 30 minutes before predicted peak.")
+    else:
+        recs.append(f"Venue can absorb the simulated crowd (peak {projected_peak:,} / {capacity:,}).")
+    if extra_vehicles > 0:
+        recs.append(
+            f"Pre-position parking marshals: ~{extra_vehicles} additional vehicles expected; "
+            f"open Visitor Parking overflow and remote parking with shuttle."
+        )
+    recs.append("Enable one-way pedestrian flow inside the venue and keep fire lanes clear.")
+
+    return {
+        "title": f"Scenario: {event['name']} — simulated attendance {sim_attendance:,}",
+        "current": {
+            "event": event,
+            "expected_attendance": event["expected_attendance"],
+            "predicted_peak": event["predicted_peak"],
+        },
+        "simulated": {
+            "event": {**event, "expected_attendance": sim_attendance,
+                      "current_crowd": max(current, int(sim_attendance * 0.7)),
+                      "predicted_peak": projected_peak},
+            "expected_attendance": sim_attendance,
+            "predicted_peak": projected_peak,
+            "capacity": capacity,
+            "capacity_breach": breach,
+            "breach_minutes": breach_minutes,
+        },
+        "impact": {
+            "crowd_delta_people": crowd_delta,
+            "extra_vehicles": extra_vehicles,
+            "parking_pressure_delta_pct": parking_pressure,
+            "traffic": "Gate congestion likely to rise during arrival window (30-60 min before start)",
+            "resources": "Electricity +8%, water +12% during event window",
+            "risk_delta": 15 if breach else 6,
+        },
+        "recommendations": recs,
+    }
+
+
+def _simulate_parking_unavailable(snapshot: dict, params: dict) -> dict:
+    zone_name = params.get("zone", "Parking Zone A")
+    zones = snapshot["parking"]
+    closed = next((z for z in zones if zone_name.lower() in z["name"].lower()), None)
+    if not closed:
+        closed = zones[0] if zones else {"name": zone_name, "occupied": 120, "total_slots": 150}
+    others = [z for z in zones if z is not closed]
+    displaced = closed.get("occupied", 120)
+
+    simulated = []
+    for z in others:
+        avail = max(z.get("total_slots", 100) - z.get("occupied", 0), 0)
+        share = 1.0 / max(len(others), 1)
+        extra = min(displaced * share, avail)
+        occ = z["occupied"] + extra
+        simulated.append({**z, "occupied": round(occ),
+                          "available": round(z["total_slots"] - occ),
+                          "occupancy_pct": round(100 * occ / max(z["total_slots"], 1), 1)})
+
+    fill_times = []
+    for z in simulated:
+        series = snapshot.get("parking_series", {}).get(z["name"], [])
+        m = minutes_to_threshold(series, z["total_slots"] * 0.98) if series else None
+        fill_times.append({"zone": z["name"], "minutes_to_full": m,
+                           "occupancy_pct": z["occupancy_pct"]})
+
+    unabsorbed = max(0, displaced - sum(min(displaced / max(len(others), 1),
+                                            z.get("total_slots", 100) - z.get("occupied", 0))
+                                        for z in others))
+    recs = []
+    tight = [f for f in fill_times if f["minutes_to_full"] is not None and f["minutes_to_full"] <= 30]
+    if tight:
+        names = ", ".join(f["zone"] for f in tight)
+        recs.append(f"Zones likely to fill within 30 minutes: {names}. Open remote parking + shuttle.")
+    if unabsorbed > 0:
+        recs.append(f"~{round(unabsorbed)} vehicles cannot be absorbed — redirect to Visitor Parking and off-campus lots.")
+    recs.append(f"Reserve {max(round(displaced*0.2), 10)} slots in Faculty Parking for essential staff during the outage.")
+    recs.append("Notify gate staff to guide incoming vehicles away from the closed zone via signage.")
+
+    return {
+        "title": f"Scenario: {closed['name']} Unavailable",
+        "current": {"parking": zones},
+        "simulated": {"parking": simulated + [{**closed, "occupied": 0, "available": closed["total_slots"],
+                                               "occupancy_pct": 0.0, "status": "UNAVAILABLE"}],
+                      "displaced_vehicles": displaced,
+                      "unabsorbed_vehicles": round(unabsorbed),
+                      "fill_times": fill_times},
+        "impact": {
+            "parking": f"{displaced} vehicles redistributed across {len(others)} zones",
+            "traffic": "Approach-road congestion +20-30% near affected zone",
+            "risk_delta": 10,
+        },
+        "recommendations": recs,
+    }
+
+
+def _simulate_event_extension(snapshot: dict, params: dict) -> dict:
+    hours = float(params.get("hours", 2))
+    event = snapshot["events"][0] if snapshot["events"] else {
+        "name": "Main Event", "current_crowd": 900, "capacity": 1500, "predicted_peak": 1200}
+    evening_overlap = hours  # extension pushes activity into evening peak
+    recs = [
+        f"Event extended by {hours:g} hours — activity now overlaps the evening arrival peak.",
+        "Keep parking zones staffed until 2 hours after the new end time; lighting must remain on.",
+        "Arrange additional shuttle trips and notify transport desk of the extended schedule.",
+        "Re-check venue capacity 45 minutes before the original end time.",
+    ]
+    return {
+        "title": f"Scenario: {event['name']} extended by {hours:g} hours",
+        "current": {"event": event, "end_time_note": "original schedule"},
+        "simulated": {
+            "event": event,
+            "extended_hours": hours,
+            "extended_crowd_plateau": int(event.get("current_crowd", 0) * (1 + 0.05 * hours)),
+            "evening_peak_overlap": True,
+        },
+        "impact": {
+            "crowd": f"Crowd plateau extends ~{hours:g}h into the evening; expect +{int(8*hours)}% evening traffic",
+            "parking": "Parking demand stays elevated ~2 hours longer; late fill risk at 20:00+",
+            "resources": f"Electricity +{int(6*hours)}%, water +{int(4*hours)}% for the extension window",
+            "risk_delta": int(4 * hours) + 4,
+        },
+        "recommendations": recs,
+    }
+
+
+def _simulate_vehicle_surge(snapshot: dict, params: dict) -> dict:
+    pct = float(params.get("percent", 30))
+    factor = 1 + pct / 100.0
+    gates = [{**g, "incoming": round(g.get("incoming", 100) * factor),
+               "outgoing": round(g.get("outgoing", 80) * factor),
+               "congestion": _congestion(g.get("incoming", 100) * factor)}
+              for g in snapshot["traffic"]]
+    parking = []
+    for z in snapshot["parking"]:
+        projected = min(z["total_slots"], z["occupied"] + (z["total_slots"] - z["occupied"]) * (factor - 1) * 2)
+        parking.append({**z, "occupied": round(projected),
+                        "occupancy_pct": round(100 * projected / max(z["total_slots"], 1), 1)})
+    full_zones = [z["name"] for z in parking if z["occupancy_pct"] >= 97]
+    recs = [
+        f"Incoming vehicle volume +{pct:.0f}% — expect gate queues to lengthen within 15-20 minutes.",
+    ]
+    if full_zones:
+        recs.append(f"Parking likely to reach capacity at: {', '.join(full_zones)}. Pre-open overflow lot.")
+    recs.append("Activate dynamic signage redirecting vehicles to the least-occupied zones.")
+    recs.append("Consider opening the reserve two-wheeler parking area.")
+    return {
+        "title": f"Scenario: +{pct:.0f}% vehicle arrivals",
+        "current": {"traffic": snapshot["traffic"], "parking": snapshot["parking"]},
+        "simulated": {"traffic": gates, "parking": parking,
+                      "zones_at_capacity": full_zones},
+        "impact": {
+            "traffic": f"Gate congestion increases across all gates (+{pct:.0f}% flow)",
+            "parking": f"{len(full_zones)} zone(s) projected to hit capacity" if full_zones else "Parking absorbs surge",
+            "risk_delta": 8 + int(pct / 10),
+        },
+        "recommendations": recs,
+    }
+
+
+def _simulate_weather_change(snapshot: dict, params: dict) -> dict:
+    condition = params.get("condition", "HEAVY_RAIN")
+    outdoor_events = [e for e in snapshot["events"]
+                      if any(k in e.get("venue", "").lower() for k in ("ground", "outdoor", "stadium", "field"))]
+    if not outdoor_events and snapshot["events"]:
+        outdoor_events = [snapshot["events"][0]]
+    disrupted = len(outdoor_events) > 0 and condition in ("RAIN", "HEAVY_RAIN", "STORM")
+    rain = {"SUNNY": 5, "CLOUDY": 25, "RAIN": 70, "HEAVY_RAIN": 90, "STORM": 98}.get(condition, 60)
+    recs = []
+    if disrupted:
+        names = ", ".join(e["name"] for e in outdoor_events)
+        recs.append(f"⚠ EVENT DISRUPTION RISK: {names} is outdoors — heavy rain will force evacuation into buildings.")
+        recs.append("Consider moving the event to the Auditorium or an indoor venue, or suspend temporarily.")
+        recs.append("Pre-open indoor holding areas; expect a +30% indoor crowd spike within 20 minutes of rain.")
+    recs.append("Activate covered walkway routing on the digital twin and increase ground-staff presence.")
+    recs.append("Check drainage at Gate 1 and Central Road; waterlogging will slow traffic by ~25%.")
+    return {
+        "title": f"Scenario: Weather changes to {condition}",
+        "current": {"weather": snapshot.get("environment", {}).get("condition", "SUNNY"),
+                    "events": snapshot["events"]},
+        "simulated": {
+            "condition": condition,
+            "rain_probability": rain,
+            "outdoor_events_affected": [e["name"] for e in outdoor_events],
+            "indoor_crowd_spike_pct": 30 if disrupted else 0,
+        },
+        "impact": {
+            "events": f"{len(outdoor_events)} outdoor event(s) at disruption risk" if disrupted else "No outdoor events affected",
+            "traffic": "Traffic slows ~25%; two-wheeler volume drops sharply",
+            "crowd": "Indoor venues absorb displaced crowd (+30% within 20 min)" if disrupted else "Minimal",
+            "risk_delta": 12 if disrupted else 5,
+        },
+        "recommendations": recs,
+    }
+
+
+_SIMULATORS = {
+    "GATE_CLOSURE": _simulate_gate_closure,
+    "EVENT_CROWD": _simulate_event_crowd,
+    "PARKING_UNAVAILABLE": _simulate_parking_unavailable,
+    "EVENT_EXTENSION": _simulate_event_extension,
+    "VEHICLE_SURGE": _simulate_vehicle_surge,
+    "WEATHER_CHANGE": _simulate_weather_change,
+}
+
+
+def _congestion(incoming: float) -> str:
+    if incoming >= 220:
+        return "CRITICAL"
+    if incoming >= 160:
+        return "HIGH"
+    if incoming >= 100:
+        return "MODERATE"
+    return "LOW"
+
+
+def run_simulation(snapshot: dict, scenario: str, params: dict) -> dict:
+    scenario = scenario.upper()
+    if scenario not in _SIMULATORS:
+        raise ValueError(f"Unknown scenario '{scenario}'. Valid: {sorted(_SIMULATORS)}")
+    result = _SIMULATORS[scenario](snapshot, params or {})
+
+    # Risk comparison: current vs simulated
+    base_zones = snapshot["zones"]
+    sim = result["simulated"]
+
+    def _risk_for(parking_pct: float, traffic_status: str, crowd_boost: float = 0.0,
+                  weather: str = "SUNNY", rain: float = 0.0, event_boost: float = 0.0) -> int:
+        zones = [dict(z, people=int(z.get("people", 0) * (1 + crowd_boost))) for z in base_zones]
+        events = [dict(e) for e in snapshot["events"]]
+        for e in events:
+            if event_boost:
+                e["predicted_peak"] = int(e.get("predicted_peak", 0) * (1 + event_boost))
+        score, _, _, _ = compute_risk(
+            zones=zones, parking_occupancy_pct=parking_pct, traffic_status=traffic_status,
+            events=events, weather=weather, rain_probability=rain,
+            resource_anomalies=snapshot.get("resource_anomalies", 0),
+            restricted_activity=snapshot.get("restricted_activity", 0),
+            active_alerts=snapshot.get("active_alerts", []),
+        )
+        return score
+
+    before = snapshot.get("risk", {}).get("score", 20)
+    impact = result["impact"]
+    risk_delta = impact.get("risk_delta", 8)
+    after = max(0, min(100, int(before) + int(risk_delta)))
+    result["risk_score_before"] = before
+    result["risk_score_after"] = after
+    result["scenario"] = scenario
+    return result
